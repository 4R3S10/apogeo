// Órbita: el Núcleo (en letras) y los datos del equipo al abrir la terminal. En Ghostty sale el logo de verdad
// (/usr/share/apogeo/terminal/fastfetch-imagen.jsonc)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/apogeo/fastfetch.txt",
    "color": { "1": "38;2;69;214;255" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;69;214;255", "title": "38;2;183;156;255" }
  },
  "modules": [
    "title",
    { "type": "os", "key": "Sistema", "format": "Órbita (sobre CachyOS)" },
    { "type": "kernel", "key": "Núcleo" },
    { "type": "uptime", "key": "Encendido" },
    { "type": "packages", "key": "Paquetes" },
    { "type": "cpu", "key": "Procesador" },
    { "type": "gpu", "key": "Gráfica" },
    { "type": "memory", "key": "Memoria" },
    { "type": "disk", "key": "Disco", "folders": "/" },
    "break",
    "colors"
  ]
}
