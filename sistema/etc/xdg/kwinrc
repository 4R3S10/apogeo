# Apogeo: si una ventana de otro escritorio se pone delante sola, KWin no hace nada y lo decide el script
# apogeo-escritorios (en el mismo modo vas a su escritorio; de otro modo, se viene aquí: nunca cambias de modo sin querer).
# Llevar una ventana arriba ya no la maximiza: enseña la rejilla de Apogeo (los lados siguen poniéndola a media pantalla)
[Windows]
ActivationDesktopPolicy=DoNothing
ElectricBorderMaximize=false

# La consola del piso Jugar, a pantalla completa; y todas las ventanas con las esquinas redondeadas (como Ágape)
[Plugins]
apogeo-ventanasEnabled=true
apogeo-escritoriosEnabled=true
apogeo-vistaEnabled=true
kwin4_effect_shapecornersEnabled=true
# (sin el brillo de KDE al acercar el ratón a una barra escondida: el orbe sale al tocar el borde, no antes)
screenedgeEnabled=false

# Las esquinas: el radio de la barra de las ventanas (lo cambia Ajustes → Aspecto → Esquinas), sin rayas alrededor y
# con la sombra suave de la propia ventana. Maximizada o a pantalla completa, sin redondear
[Round-Corners]
ActiveCornerRadius=12
InactiveCornerRadius=12
# Un borde fino del acento del modo en la ventana activa, como en COSMIC (el color «resaltado» de KDE: cambia solo con
# el modo); las demás, sin borde. OutlineThickness es la activa en las versiones nuevas; ActiveOutlineThickness, antes
OutlineThickness=2
ActiveOutlineThickness=2
InactiveOutlineThickness=0
ActiveOutlineUsePalette=true
ActiveOutlinePalette=12
ActiveOutlineUseCustom=false
ActiveOutlineAlpha=235
SecondOutlineThickness=0
OuterOutlineThickness=0
ActiveSecondOutlineThickness=0
InactiveSecondOutlineThickness=0
ActiveOuterOutlineThickness=0
InactiveOuterOutlineThickness=0
UseNativeDecorationShadows=true
DisableRoundMaximize=true
DisableRoundFullScreen=true
DisableOutlineMaximize=true
DisableOutlineFullScreen=true
# Las tarjetas sin barra (portapapeles, música, avisos, miniatura de la captura, atajos…) dibujan su propio borde y
# traen un margen transparente para la sombra: sin esto, la raya de la ventana activa salía suelta alrededor
Exclusions=apogeo-portapapeles,apogeo-musica,apogeo-resumen,apogeo-captura,apogeo-buscador,apogeo-consola

# La esquina de arriba a la izquierda no abre la Vista general de KDE (ahí está el modo, en la barra fina; la Órbita
# sale del orbe o con Meta). 9 = ningún borde
[Effect-overview]
BorderActivate=9

# Cambiar de piso como un ascensor: las ventanas suben o bajan y el fondo se queda quieto detrás (luego cambia al del
# piso nuevo, fundiéndose)
[Effect-slide]
SlideBackground=false
VerticalGap=64

# Ventanas con la barra de Ágape: título en el centro y sus botones planos a la derecha
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__apogeo
ButtonsOnLeft=
ButtonsOnRight=IAX

# El desenfoque detrás de lo transparente: poco, como en COSMIC (se ve el fondo casi nítido)
[Effect-blur]
BlurStrength=4
NoiseStrength=0
