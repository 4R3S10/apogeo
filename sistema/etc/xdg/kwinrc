# Apogeo: si una ventana de otro piso se pone delante sola, se viene al piso donde estás (nunca cambias de piso sin querer)
[Windows]
ActivationDesktopPolicy=BringToCurrentDesktop

# La consola del piso Jugar, a pantalla completa
[Plugins]
apogeo-ventanasEnabled=true

# Ventanas con la barra de Ágape: título en el centro y sus botones planos a la derecha
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__apogeo
ButtonsOnLeft=
ButtonsOnRight=IAX
