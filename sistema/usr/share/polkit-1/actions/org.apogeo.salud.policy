<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Ajustes de Apogeo → Salud del PC: la temperatura máxima. Sin contraseña para quien está delante del equipo
     (apogeo-salud solo acepta de 70 a 85 °C); con contraseña de administrador para cualquier otro. -->
<policyconfig>
  <vendor>Apogeo</vendor>
  <action id="org.apogeo.salud">
    <description>Cambiar la temperatura máxima del equipo</description>
    <message>Apogeo quiere cambiar la temperatura a partir de la que baja la velocidad</message>
    <icon_name>apogeo</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/apogeo/apogeo-salud</annotate>
  </action>
</policyconfig>
