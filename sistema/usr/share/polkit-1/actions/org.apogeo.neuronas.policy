<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Ajustes de Apogeo → Tu perfil → Entrar con neuronas: cambia la contraseña de tu propia cuenta, así que pide la de
     ahora (la tuya, no la de administrador). -->
<policyconfig>
  <vendor>Apogeo</vendor>
  <action id="org.apogeo.neuronas">
    <description>Entrar con neuronas</description>
    <message>Para cambiar tu forma de entrar, escribe tu contraseña de ahora</message>
    <icon_name>apogeo</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/apogeo/apogeo-neuronas</annotate>
  </action>
</policyconfig>
