<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Tus colores en la pantalla de inicio de sesión: solo deja una copia de colores (comprobados) para esa pantalla. -->
<policyconfig>
  <vendor>Apogeo</vendor>
  <action id="org.apogeo.aspectologin">
    <description>Poner tu aspecto en la pantalla de inicio de sesión</description>
    <message>Apogeo quiere poner tus colores en la pantalla de inicio de sesión</message>
    <icon_name>apogeo</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/apogeo/apogeo-aspecto-login</annotate>
  </action>
</policyconfig>
