<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Tiempo de estudio de hoy (piso Estudiar) -->
    <entry name="studyDate" type="String"><default></default></entry>
    <entry name="studySeconds" type="Int"><default>0</default></entry>
    <!-- Ajustes de Apogeo → Isla y Salud del PC (los escribe apogeo-pisos) -->
    <entry name="extraJugar" type="Bool"><default>true</default></entry>
    <entry name="extraNavegar" type="Bool"><default>true</default></entry>
    <entry name="extraEstudiar" type="Bool"><default>true</default></entry>
    <entry name="fps" type="Int"><default>60</default></entry>
    <entry name="limite" type="Int"><default>80</default></entry>
    <!-- Las apps fijadas de cada piso (siempre en la isla, aunque estén cerradas; clic derecho → Fijar / Dejar de fijar) -->
    <entry name="fijadasJugar" type="StringList"><default>applications:discord.desktop,applications:steam.desktop,applications:spotify-launcher.desktop</default></entry>
    <entry name="fijadasNavegar" type="StringList"><default>applications:ares.desktop,applications:org.kde.dolphin.desktop,applications:discord.desktop,applications:spotify-launcher.desktop</default></entry>
    <entry name="fijadasEstudiar" type="StringList"><default>applications:obsidian.desktop,applications:anki.desktop,applications:com.github.xournalpp.xournalpp.desktop,applications:org.kde.okular.desktop</default></entry>
  </group>
</kcfg>
