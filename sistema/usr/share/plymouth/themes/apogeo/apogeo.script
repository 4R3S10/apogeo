# Arranque (y apagado) de Órbita: el Núcleo (el punto y sus tres órbitas) sobre la Tierra en penumbra (o el grafito),
# flotando un poco, y debajo una barra fina cian. Al encender, la Tierra aparece poco a poco y el orbe se forma: el
# punto se enciende y las órbitas entran hasta su sitio. Luego las órbitas giran despacio y el punto respira. Todo se
# mueve en cada refresco (50 por segundo): las órbitas se giran enteras, sin fotogramas sueltos. Si el disco está
# cifrado, la contraseña se pide debajo (con puntos).

Window.SetBackgroundTopColor(0.024, 0.031, 0.047);
Window.SetBackgroundBottomColor(0.051, 0.067, 0.094);

W = Window.GetWidth();
H = Window.GetHeight();
X = Window.GetX();
Y = Window.GetY();
arranque = Plymouth.GetMode() == "boot";

# Detrás, la Tierra en penumbra (tierra.png: la baja apogeo-tierra la primera vez que arranca con internet; no va en el
# paquete) recortada para llenar la pantalla; si aún no está, el grafito de siempre
tierra_img = Image("tierra.png");
if (tierra_img) {
  escala = W / tierra_img.GetWidth();
  if (H / tierra_img.GetHeight() > escala) escala = H / tierra_img.GetHeight();
  tw = Math.Int(tierra_img.GetWidth() * escala);
  th = Math.Int(tierra_img.GetHeight() * escala);
  fondo = Sprite(tierra_img.Scale(tw, th));
  fondo.SetPosition(X + (W - tw) / 2, Y + (H - th) / 2, -10);
} else {
  fondo = Sprite(Image("fondo.png").Scale(W, H));
  fondo.SetPosition(X, Y, -10);
}
if (arranque) fondo.SetOpacity(0);

# El Núcleo, en piezas: el disco con el punto, el halo del punto y las órbitas (giradas en cada refresco)
logo_img = Image("logo.png");
logo_x = X + W / 2 - logo_img.GetWidth() / 2;
logo_y = Y + H / 2 - logo_img.GetHeight() / 2 - 20;
disco = Sprite(Image("disco.png"));
halo = Sprite(Image("halo.png"));
orbitas_img = Image("orbitas.png");
orbitas = Sprite(orbitas_img);
disco.SetPosition(logo_x, logo_y, 1);
halo.SetPosition(logo_x, logo_y, 2);
orbitas.SetPosition(logo_x, logo_y, 3);

# Al encender, antes: el orbe formándose (forma-00.png … forma-89.png, uno por refresco; el último es igual que el
# disco con las órbitas)
FORMA = 90;
forma = [];
forma_spr = Sprite();
forma_spr.SetPosition(logo_x, logo_y, 4);
if (arranque) {
  for (i = 0; i < FORMA; i++) {
    if (i < 10) forma[i] = Image("forma-0" + i + ".png");
    else forma[i] = Image("forma-" + i + ".png");
  }
  forma_spr.SetImage(forma[0]);
  disco.SetOpacity(0);
  halo.SetOpacity(0);
  orbitas.SetOpacity(0);
}

PI = 3.14159265;
VUELTA = 200;      # refrescos por vuelta de las órbitas (4 s)
RESPIRO = 250;     # refrescos por respiración (5 s: el punto brilla y el orbe sube y baja un poco)
tic = 0;
fun refrescar() {
  tic++;
  # La Tierra aparece en algo menos de un segundo
  if (arranque && tic <= 40) fondo.SetOpacity(tic / 40);
  if (forma[0] && tic < FORMA) {
    forma_spr.SetImage(forma[tic]);
    return;
  }
  if (forma[0] && tic == FORMA) {
    forma_spr.SetOpacity(0);
    disco.SetOpacity(1);
    orbitas.SetOpacity(1);
  }
  t = tic;
  if (forma[0]) t = tic - FORMA;
  vuelta = t - Math.Int(t / VUELTA) * VUELTA;
  orbitas.SetImage(orbitas_img.Rotate(2 * PI * vuelta / VUELTA));
  respiro = t - Math.Int(t / RESPIRO) * RESPIRO;
  ola = (1 - Math.Cos(2 * PI * respiro / RESPIRO)) / 2;
  # (el halo entra despacio tras formarse, para que no salte)
  entra = t / 50;
  if (entra > 1) entra = 1;
  halo.SetOpacity((0.35 + 0.65 * ola) * entra);
  dy = Math.Int(-4 * ola + 0.5);
  disco.SetY(logo_y + dy);
  halo.SetY(logo_y + dy);
  orbitas.SetY(logo_y + dy);
}
Plymouth.SetRefreshFunction(refrescar);

barra_fondo_img = Image("barra-fondo.png");
barra_img = Image("barra.png");
barra_x = X + W / 2 - barra_fondo_img.GetWidth() / 2;
barra_y = Y + H / 2 + logo_img.GetHeight() / 2 + 30;
barra_fondo = Sprite(barra_fondo_img);
barra_fondo.SetPosition(barra_x, barra_y, 1);
barra = Sprite();
barra.SetPosition(barra_x, barra_y, 2);

fun progreso(duracion, avance) {
  ancho = Math.Int(barra_fondo_img.GetWidth() * avance);
  if (ancho < 2) ancho = 2;
  barra.SetImage(barra_img.Scale(ancho, barra_img.GetHeight()));
}
Plymouth.SetBootProgressFunction(progreso);

# ---------- Contraseña del disco (si está cifrado) ----------
punto_img = Image("punto.png");
puntos = [];
texto = Sprite();

fun pedir_contrasena(pregunta, cuantos) {
  barra.SetOpacity(0);
  barra_fondo.SetOpacity(0);
  texto_img = Image.Text(pregunta, 0.913, 0.929, 0.961);
  texto.SetImage(texto_img);
  texto.SetOpacity(1);
  texto.SetPosition(X + W / 2 - texto_img.GetWidth() / 2, barra_y - 6, 3);
  for (i = 0; puntos[i] || i < cuantos; i++) {
    if (!puntos[i]) puntos[i] = Sprite(punto_img);
    puntos[i].SetPosition(X + W / 2 - cuantos * 9 + i * 18, barra_y + 28, 3);
    puntos[i].SetOpacity(i < cuantos);
  }
}
Plymouth.SetDisplayPasswordFunction(pedir_contrasena);

fun normal() {
  texto.SetOpacity(0);
  for (i = 0; puntos[i]; i++) puntos[i].SetOpacity(0);
  barra.SetOpacity(1);
  barra_fondo.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(normal);

# Mensajes del sistema (p. ej. «Comprobando el disco…»), pequeños y abajo
mensaje = Sprite();
fun mostrar_mensaje(t) {
  mensaje_img = Image.Text(t, 0.545, 0.580, 0.640);
  mensaje.SetImage(mensaje_img);
  mensaje.SetPosition(X + W / 2 - mensaje_img.GetWidth() / 2, Y + H - 60, 3);
}
Plymouth.SetMessageFunction(mostrar_mensaje);

fun al_salir() {
  barra.SetImage(barra_img);
}
Plymouth.SetQuitFunction(al_salir);
