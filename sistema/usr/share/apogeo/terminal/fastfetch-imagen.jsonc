// Apogeo: el logo de verdad (imagen) en terminales que la saben pintar, como Ghostty
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/usr/share/apogeo/logo.png",
    "width": 20,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;224;169;180", "title": "38;2;255;143;198" }
  },
  "modules": [
    "title",
    { "type": "os", "key": "Sistema", "format": "Apogeo (sobre CachyOS)" },
    { "type": "kernel", "key": "Núcleo" },
    { "type": "uptime", "key": "Encendido" },
    { "type": "packages", "key": "Paquetes" },
    { "type": "cpu", "key": "Procesador" },
    { "type": "gpu", "key": "Gráfica" },
    { "type": "memory", "key": "Memoria" },
    { "type": "disk", "key": "Disco", "folders": "/" },
    "break",
    "colors"
  ]
}
