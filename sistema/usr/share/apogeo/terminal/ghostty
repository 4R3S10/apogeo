# Órbita · terminal «T1 · Cristal con píldoras»: el cristal grafito con desenfoque, la letra de datos Geist Mono (y la
# JetBrains Mono Nerd Font solo de respaldo, para los símbolos del prompt) y el acento cian de Navegar.
# Lo carga ~/.config/ghostty/config; tus cambios, en ese archivo.
font-family = Geist Mono
font-family = JetBrainsMono Nerd Font
font-size = 11
background = #0b0e14
foreground = #e9edf5
background-opacity = 0.86
background-blur = true
cursor-color = #45d6ff
cursor-style = block
selection-background = #12303d
selection-foreground = #e9edf5
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-theme = dark
confirm-close-surface = false
palette = 0=#0b0e14
palette = 1=#ff6b81
