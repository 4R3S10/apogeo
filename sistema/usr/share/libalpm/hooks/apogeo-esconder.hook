# Vuelve a esconder lo que no pinta nada en el menú (apps de CachyOS, herramientas de Qt, Avahi…) si una actualización lo pone
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/applications/cachyos-hello.desktop
Target = usr/share/applications/cachyos-pi.desktop
Target = usr/share/applications/org.cachyos.KernelManager.desktop
Target = usr/share/applications/org.cachyos.scx-manager.desktop
Target = usr/share/applications/arch-update.desktop
Target = usr/share/applications/arch-update-tray.desktop
Target = usr/share/applications/avahi-discover.desktop
Target = usr/share/applications/bssh.desktop
Target = usr/share/applications/bvnc.desktop
Target = usr/share/applications/assistant.desktop
Target = usr/share/applications/designer.desktop
Target = usr/share/applications/linguist.desktop
Target = usr/share/applications/qdbusviewer.desktop
Target = usr/share/applications/qv4l2.desktop
Target = usr/share/applications/qvidcap.desktop
Target = usr/share/applications/lstopo.desktop
Target = usr/share/applications/kvantummanager.desktop
Target = usr/share/applications/org.kde.kwrite.desktop
Target = usr/share/applications/org.kde.kdeconnect.nonplasma.desktop
Target = usr/share/applications/org.kde.kdeconnect.sms.desktop
Target = usr/lib/apogeo/apogeo-esconder

[Action]
Description = Apogeo: lo que no son apps, fuera del menú
When = PostTransaction
Exec = /usr/lib/apogeo/apogeo-esconder
