#!/bin/sh
# Nombre y logo de Apogeo en os-release, sin tocar el ID (CachyOS y Arch lo usan para sus actualizaciones). Lo vuelve a
# poner un gancho de pacman cada vez que una actualización de CachyOS reescribe el archivo.
# CachyOS además deja su propio /etc/os-release (un archivo, no un enlace): se cambia igual.
set -eu
set_key() {
  if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else echo "$2=$3" >> "$1"; fi
}
for f in /usr/lib/os-release /etc/os-release; do
  [ -f "$f" ] && [ ! -L "$f" ] || continue
  set_key "$f" PRETTY_NAME '"Apogeo"'
  set_key "$f" NAME '"Apogeo"'
  set_key "$f" VARIANT '"Apogeo"'
  set_key "$f" DEFAULT_HOSTNAME '"apogeo"'
  set_key "$f" LOGO 'apogeo'
done

# Limine (el arranque de CachyOS) busca su entrada por el NAME de os-release; como ahora es «Apogeo», se le dice el
# nombre con el que se creó la entrada (sin tocar el menú de arranque, que va firmado).
if [ -f /etc/default/limine ] && ! grep -q '^TARGET_OS_NAME=' /etc/default/limine && [ -r /boot/limine.conf ]; then
  name=$(sed -n 's|^/+\{0,1\}\([^/].*\)$|\1|p' /boot/limine.conf | head -n 1)
  [ -n "$name" ] && printf '\n# Apogeo: nombre de la entrada de arranque (os-release dice «Apogeo»)\nTARGET_OS_NAME="%s"\n' "$name" >> /etc/default/limine
fi
