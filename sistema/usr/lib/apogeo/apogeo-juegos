#!/usr/bin/python3
"""
Los juegos de Apogeo, todos juntos, para la consola del piso Jugar:

  apogeo-juegos lista                 JSON con los juegos de Steam, Epic/GOG (Heroic), Hydra y los de Windows
  apogeo-juegos jugar TIENDA ID       abre el juego (Steam, Heroic, Hydra o el Windows escondido)

Solo lee las listas que cada tienda guarda en tu carpeta; no entra en tus cuentas.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.environ.get('APOGEO_JUEGOS_HOME', os.path.expanduser('~'))  # para probarlo con una carpeta de mentira
STEAM = os.path.join(HOME, '.local/share/Steam')
# Heroic instalado como paquete (CachyOS) o como Flatpak
HEROIC = next((d for d in (os.path.join(HOME, '.config/heroic'),
                           os.path.join(HOME, '.var/app/com.heroicgameslauncher.hgl/config/heroic')) if os.path.isdir(d)),
              os.path.join(HOME, '.config/heroic'))
WINDOWS_LIST = os.path.join(HOME, '.config/apogeo/juegos-windows.json')
STEAM_CDN = 'https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/{}/{}'
# Lo que Steam instala pero no son juegos
NOT_GAMES = re.compile(r'Proton|Steam Linux Runtime|Steamworks|SteamVR|Redistributable', re.I)


def vdf_values(text, key):
    return re.findall(r'"%s"\s+"([^"]*)"' % re.escape(key), text, re.I)


def steam_games():
    games = []
    libs = [os.path.join(STEAM, 'steamapps')]
    try:
        with open(os.path.join(STEAM, 'steamapps/libraryfolders.vdf')) as f:
            libs += [os.path.join(p, 'steamapps') for p in vdf_values(f.read(), 'path')]
    except OSError:
        pass
    seen = set()
    for lib in dict.fromkeys(libs):
        for acf in glob.glob(os.path.join(lib, 'appmanifest_*.acf')):
            try:
                with open(acf, encoding='utf-8', errors='replace') as f:
                    text = f.read()
            except OSError:
                continue
            appid = (vdf_values(text, 'appid') or [''])[0]
            name = (vdf_values(text, 'name') or [''])[0]
            if not appid or appid in seen or NOT_GAMES.search(name):
                continue
            seen.add(appid)
            cache = os.path.join(STEAM, 'appcache/librarycache', appid)
            cover = next(iter(sorted(glob.glob(f'{cache}/**/library_600x900*.jpg', recursive=True)
                                     + glob.glob(f'{cache}/**/library_capsule*.jpg', recursive=True))), '')
            hero = next(iter(sorted(glob.glob(f'{cache}/**/library_hero*.jpg', recursive=True))), '')
            games.append({
                'store': 'steam', 'id': appid, 'name': name,
                'cover': 'file://' + cover if cover else STEAM_CDN.format(appid, 'library_600x900.jpg'),
                'hero': 'file://' + hero if hero else STEAM_CDN.format(appid, 'library_hero.jpg'),
                'last': int((vdf_values(text, 'LastPlayed') or ['0'])[0] or 0),
                'installed': True,
            })
    return games


def heroic_games():
    games = []
    for runner, path, key in (('legendary', 'legendary_library.json', 'library'), ('gog', 'gog_library.json', 'games')):
        try:
            with open(os.path.join(HEROIC, 'store_cache', path)) as f:
                items = json.load(f).get(key, [])
        except (OSError, ValueError):
            continue
        for g in items:
            if not isinstance(g, dict) or not g.get('app_name'):
                continue
            games.append({
                'store': 'epic' if runner == 'legendary' else 'gog', 'runner': runner,
                'id': g['app_name'], 'name': g.get('title') or g['app_name'],
                'cover': g.get('art_square') or g.get('art_cover') or '',
                'hero': g.get('art_background') or g.get('art_cover') or '',
                'last': 0, 'installed': bool(g.get('is_installed')),
            })
    return games


def windows_games():
    """Los que solo van en Windows (anticheat del núcleo). Se pueden añadir más en ~/.config/apogeo/juegos-windows.json."""
    if not os.path.exists(WINDOWS_LIST):
        os.makedirs(os.path.dirname(WINDOWS_LIST), exist_ok=True)
        with open(WINDOWS_LIST, 'w') as f:
            json.dump([{'id': 'valorant', 'name': 'VALORANT'}, {'id': 'eafc', 'name': 'EA SPORTS FC 26'}], f, indent=2)
    try:
        with open(WINDOWS_LIST) as f:
            items = json.load(f)
    except (OSError, ValueError):
        return []
    return [{'store': 'windows', 'id': g['id'], 'name': g.get('name', g['id']), 'cover': g.get('cover', ''),
             'hero': g.get('hero', ''), 'last': g.get('last', 0), 'installed': True}
            for g in items if isinstance(g, dict) and g.get('id')]


def hydra():
    exe = shutil.which('hydralauncher')
    return [{'store': 'hydra', 'id': 'hydra', 'name': 'Hydra', 'cover': '', 'hero': '', 'last': 0,
             'installed': True, 'app': True}] if exe else []


def listing():
    games = steam_games() + heroic_games() + windows_games() + hydra()
    # Primero los últimos jugados; después, por nombre
    games.sort(key=lambda g: (-g.get('last', 0), g['name'].lower()))
    return games


def detach(cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def play(store, gid):
    if store == 'steam':
        detach(['steam', '-silent', f'steam://rungameid/{gid}'])
    elif store in ('epic', 'gog'):
        runner = 'legendary' if store == 'epic' else 'gog'
        detach(['xdg-open', f'heroic://launch?appName={gid}&runner={runner}'])
    elif store == 'hydra':
        detach(['hydralauncher'])
    elif store == 'windows':
        detach(['/usr/lib/apogeo/apogeo-windows', gid])
    else:
        return 1
    # Se apunta cuándo se jugó a los de Windows (Steam lo apunta solo)
    if store == 'windows':
        try:
            with open(WINDOWS_LIST) as f:
                items = json.load(f)
            for g in items:
                if g.get('id') == gid:
                    g['last'] = int(time.time())
            with open(WINDOWS_LIST, 'w') as f:
                json.dump(items, f, indent=2)
        except (OSError, ValueError):
            pass
    return 0


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == 'lista':
        json.dump(listing(), sys.stdout, ensure_ascii=False)
        return 0
    if len(sys.argv) >= 4 and sys.argv[1] == 'jugar':
        return play(sys.argv[2], sys.argv[3])
    print(__doc__)
    return 2


if __name__ == '__main__':
    sys.exit(main())
