#!/usr/bin/python3
"""
Los juegos de Apogeo desde la línea de órdenes (la consola los usa directamente: apogeo_juegos.py).

  apogeo-juegos lista                 JSON con lo de cada pestaña de la consola
  apogeo-juegos jugar TIENDA ID       abre ese juego (de la lista)
  apogeo-juegos consola               trae la consola delante (o la abre si no está)
  apogeo-juegos cronometro ID -- …    abre eso y, al cerrarlo, suma el tiempo jugado a ese juego (emuladores, PS5)
"""
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.environ.get('APOGEO_LIB', '/usr/lib/apogeo'))
import apogeo_juegos as juegos  # noqa: E402


def main():
    a = sys.argv[1:]
    if a[:1] == ['lista']:
        json.dump(juegos.tabs(), sys.stdout, ensure_ascii=False)
        return 0
    if a[:1] == ['consola']:
        subprocess.Popen(['apogeo-consola'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    if len(a) > 3 and a[0] == 'cronometro' and a[2] == '--':
        start = time.monotonic()
        rc = subprocess.call(a[3:])
        if time.monotonic() - start > 30:  # (si no llegó a abrirse, no cuenta)
            juegos.add_minutes(a[1], (time.monotonic() - start) / 60)
        return rc
    if len(a) == 3 and a[0] == 'jugar':
        tabs = juegos.tabs()
        g = next((g for k in ('steam', 'epic', 'emuladores', 'ps5', 'windows') for g in tabs[k]
                  if g['store'] == a[1] and g['id'] == a[2]), None)
        if not g:
            print('No está ese juego', file=sys.stderr)
            return 1
        msg = juegos.play(g)
        if msg:
            print(msg, file=sys.stderr)
        return 1 if msg else 0
    print(__doc__.strip())
    return 2


if __name__ == '__main__':
    sys.exit(main())
