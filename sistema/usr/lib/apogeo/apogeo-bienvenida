#!/usr/bin/python3
"""
Bienvenida de Apogeo: lo primero que se ve al entrar por primera vez. Una tarjeta en el centro, como la bienvenida de
Ágape (Bienvenida.qml), con los pasos: hola (y la red, si no hay), tu nombre y tu foto, instalar Ágape con tu llave,
traer tu copia de Ágape (.agape), los pisos, la isla y listo. Si se cierra sin terminar, vuelve a salir en el siguiente
inicio, hasta que se acabe o se pulse «No volver a mostrar».

La llave de Ágape y las contraseñas nunca salen de este proceso: la llave se guarda con permisos 600 (como en
apogeo-agape) y la contraseña de la copia la pide el propio Ágape.

  apogeo-bienvenida          la abre (desde el menú: «Bienvenida de Apogeo»)
  apogeo-bienvenida --auto   la abre solo si aún no está hecha (lo usa apogeo-pisos al empezar la sesión)
"""
import os
import sys

sys.path.insert(0, os.environ.get('APOGEO_LIB', '/usr/lib/apogeo'))
from PyQt6.QtCore import pyqtSlot  # noqa: E402
from PyQt6.QtGui import QGuiApplication  # noqa: E402

from apogeo_comun import CONFIG  # noqa: E402
from apogeo_qt import Base, run  # noqa: E402

DONE = os.path.join(CONFIG, 'apogeo', 'bienvenida-hecha')
QML = os.environ.get('APOGEO_BIENVENIDA_QML', '/usr/share/apogeo/bienvenida/Bienvenida.qml')


class Backend(Base):
    APP_ID = 'apogeo-bienvenida'

    @pyqtSlot(bool)
    def finish(self, done):
        """done: terminada (o «No volver a mostrar»): ya no sale sola. Si no, vuelve en el siguiente inicio."""
        if done:
            os.makedirs(os.path.dirname(DONE), exist_ok=True)
            open(DONE, 'w').close()
        QGuiApplication.quit()


def main():
    if '--auto' in sys.argv and os.path.exists(DONE):
        return 0
    return run('Bienvenida de Apogeo', 'apogeo-bienvenida', QML, Backend,
               {'firstStep': int(os.environ.get('APOGEO_PASO', '0'))}, all_desktops=True)


if __name__ == '__main__':
    sys.exit(main())
