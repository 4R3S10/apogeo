def log(*a):
    print('[pisos]', *a, flush=True)


def vdm(bus):
    return bus.get_object('org.kde.KWin', '/VirtualDesktopManager')


def prop(obj, name):
    return obj.Get('org.kde.KWin.VirtualDesktopManager', name, dbus_interface='org.freedesktop.DBus.Properties')


def desktops(bus):
    """[(posición, id, nombre)] en orden."""
    return sorted((int(p), str(i), str(n)) for p, i, n in prop(vdm(bus), 'desktops'))


def go(bus, index):
    ds = desktops(bus)
    index = max(0, min(index, len(ds) - 1))
    vdm(bus).Set('org.kde.KWin.VirtualDesktopManager', 'current', ds[index][1],
                 dbus_interface='org.freedesktop.DBus.Properties')


def current_index(bus):
    cur = str(prop(vdm(bus), 'current'))
    return next((k for k, (_, i, _n) in enumerate(desktops(bus)) if i == cur), 0)


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, 'w') as f:
        json.dump(st, f)


def plasma_script(bus, js):
    """Ejecuta un script de Plasma y devuelve lo que imprima (None si Plasma no está)."""
    try:
        return str(bus.get_object('org.kde.plasmashell', '/PlasmaShell').evaluateScript(js, dbus_interface='org.kde.PlasmaShell'))
    except dbus.DBusException as e:
        log('plasmashell:', e.get_dbus_message())
        return None


restart_plasma = {'pending': False}  # el estilo de Plasma recién puesto solo se ve al reiniciarlo


def set_keys(path, group, values):
    """Pone claves en un grupo de un archivo de configuración de KDE (con Plasma parado, para que no lo pise)."""
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return
    header = f'[{group}]'
    out, inside, left = [], False, dict(values)
    for line in lines:
        if line.startswith('['):
            if inside and left:
                out += [f'{k}={v}' for k, v in left.items()]
                left = {}
            inside = line == header
        elif inside and '=' in line and line.split('=', 1)[0] in left:
            k = line.split('=', 1)[0]
            out.append(f'{k}={left.pop(k)}')
            continue
        out.append(line)
    if inside and left:
        out += [f'{k}={v}' for k, v in left.items()]
    elif left:
        out += ['', header] + [f'{k}={v}' for k, v in left.items()]
    with open(path, 'w') as f:
        f.write('\n'.join(out) + '\n')


def desktop_fill(bus):
    """El widget del escritorio tiene que ocupar la pantalla entera. Plasma guarda el sitio de cada widget por tamaño de
    pantalla y lo pisa al cerrarse, así que se corrige con Plasma parado (un instante, solo cuando hace falta: la
    primera vez, al cambiar de pantalla o de resolución)."""
    out = plasma_script(bus, """
        var o = [];
        desktops().forEach(function (d) {
            var g = screenGeometry(d.screen);
            d.widgets().forEach(function (w) {
                if (w.type == 'org.apogeo.escritorio') o.push([d.id, w.id, g.width, g.height, w.geometry.x, w.geometry.y, w.geometry.width, w.geometry.height]);
            });
        });
        print(JSON.stringify(o));
    """)
    if out is None:  # Plasma aún arrancando: se vuelve a mirar en un rato (hasta un minuto)
        desktop_fill.tries = getattr(desktop_fill, 'tries', 0) + 1
        return desktop_fill.tries < 12
    try:
        items = json.loads(out) if out else []
    except ValueError:
        items = []
    # Plasma le quita el hueco de la isla cuando la isla no se esconde: eso vale
    bad = [i for i in items if round(i[4]) != 0 or round(i[5]) != 0 or round(i[6]) != i[2] or not i[3] - 120 <= round(i[7]) <= i[3]]
    if not bad and not restart_plasma['pending']:
        return False
    run('systemctl', '--user', 'stop', 'plasma-plasmashell')
    rc = os.path.expanduser('~/.config/plasma-org.kde.plasma.desktop-appletsrc')
    for cid, aid, w, h, *_ in bad:
        v = f'Applet-{aid}:0,0,{w},{h},0;'
        set_keys(rc, f'Containments][{cid}', {f'ItemGeometries-{w}x{h}': v, 'ItemGeometriesHorizontal': v})
    restart_plasma['pending'] = False
    run('systemctl', '--user', 'start', 'plasma-plasmashell')
    return False


def setup(bus):
    """La primera vez: tres escritorios en columna con los nombres de los pisos y la columna de pisos a la derecha."""
    st = load_state()
    ds = desktops(bus)
    m = vdm(bus)
    for k, f in enumerate(FLOORS):
        if k < len(ds):
            if ds[k][2] != f['name']:
                m.setDesktopName(ds[k][1], f['name'], dbus_interface='org.kde.KWin.VirtualDesktopManager')
        else:
            m.createDesktop(dbus.UInt32(k), f['name'], dbus_interface='org.kde.KWin.VirtualDesktopManager')
    props = 'org.freedesktop.DBus.Properties'
    m.Set('org.kde.KWin.VirtualDesktopManager', 'rows', dbus.UInt32(len(FLOORS)), dbus_interface=props)
    m.Set('org.kde.KWin.VirtualDesktopManager', 'navigationWrappingAround', False, dbus_interface=props)
    if not st.get('panel'):
        # Columna de pisos: panel flotante en el borde derecho, solo con el widget de pisos
        plasma_script(bus, """
            var p = new Panel;
            p.location = 'right';
            p.floating = true;
            p.height = 56;
            p.lengthMode = 'fit';
            p.alignment = 'center';
            p.hiding = 'autohide';
            p.addWidget('org.apogeo.pisos');
        """)
        st['panel'] = True
    if st.get('isla', 0) < ISLAND:
        # La isla: fuera la barra de abajo de CachyOS; una isla centrada, flotante, que se esconde sola
        plasma_script(bus, """
            panels().forEach(function (p) { if (p.location == 'bottom') p.remove(); });
            var p = new Panel;
            p.location = 'bottom';
            p.floating = true;
            p.height = 56;
            p.lengthMode = 'fit';
            p.alignment = 'center';
            p.hiding = 'autohide';
            p.addWidget('org.apogeo.isla');
            p.addWidget('org.kde.plasma.systemtray');
            var clock = p.addWidget('org.kde.plasma.digitalclock');
            p.addWidget('org.apogeo.rapido');
            clock.currentConfigGroup = ['Appearance'];
            clock.writeConfig('showDate', false);
            clock.writeConfig('dateDisplayFormat', 'DisableDate');
            clock.writeConfig('autoFontAndSize', false);
            clock.writeConfig('fontFamily', 'Bricolage Grotesque');
            clock.writeConfig('boldText', true);
            clock.writeConfig('fontSize', 12);
        """)
        st['isla'] = ISLAND
    if st.get('bandeja', 0) < TRAY:
        # La bandeja de la isla, limpia: a la vista solo red, sonido, batería, brillo y avisos; lo demás, en la flecha
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.location != 'bottom') return;
                p.widgets().forEach(function (w) {
                    if (w.type == 'org.kde.plasma.systemtray') {
                        w.currentConfigGroup = ['General'];
                        w.writeConfig('hiddenItems', %s);
                        w.reloadConfig();
                    }
                    if (w.type == 'org.kde.plasma.digitalclock') {
                        w.currentConfigGroup = ['Appearance'];
                        w.writeConfig('use24hFormat', 2);
                        w.reloadConfig();
                    }
                });
            });
        """ % json.dumps(TRAY_HIDDEN))
        st['bandeja'] = TRAY
    if st.get('reloj', 0) < CLOCK:
        # La hora de la isla con la letra de Ágape (en negrita, como el reloj de su nueva pestaña)
        plasma_script(bus, """
            panels().forEach(function (p) {
                p.widgets().forEach(function (w) {
                    if (w.type != 'org.kde.plasma.digitalclock') return;
                    w.currentConfigGroup = ['Appearance'];
                    w.writeConfig('autoFontAndSize', false);
                    w.writeConfig('fontFamily', 'Bricolage Grotesque');
                    w.writeConfig('boldText', true);
                    w.writeConfig('fontSize', 11);
                    w.writeConfig('use24hFormat', 2);
                    w.reloadConfig();
                });
            });
        """)
        st['reloj'] = CLOCK
    if st.get('escritorio', 0) < DESKTOP:
        # El escritorio sin iconos de apps (enseña una carpeta vacía) y, encima, el widget de Apogeo a pantalla completa
        # (en Navegar la hora y tus widgets; en Estudiar tu carpeta de estudio, el temporizador, exámenes y tareas)
        plasma_script(bus, """
            desktops().forEach(function (d) {
                d.currentConfigGroup = ['General'];
                d.writeConfig('url', 'file:///usr/share/apogeo/escritorio-vacio');
                d.reloadConfig();
                var g = screenGeometry(d.screen);
                var w = d.widgets().filter(function (x) { return x.type == 'org.apogeo.escritorio'; })[0];
                if (!w) w = d.addWidget('org.apogeo.escritorio', 0, 0, g.width, g.height);
            });
        """)
        st['escritorio'] = DESKTOP
        save_state(st)
        # A pantalla completa lo pone desktop_fill (se mira en cada inicio de sesión)
    if st.get('rapido', 0) < QUICK:
        # El panel rápido (red, bluetooth, volumen, energía, no molestar…) al final de la isla, después de la hora
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.location != 'bottom') return;
                var has = p.widgets().some(function (w) { return w.type == 'org.apogeo.rapido'; });
                if (!has && p.widgets().some(function (w) { return w.type == 'org.apogeo.isla'; })) p.addWidget('org.apogeo.rapido');
            });
        """)
        st['rapido'] = QUICK
    if st.get('cristal', 0) < CRYSTAL:
        # B1 · Cristal de Ágape: la isla y la columna de pisos un poco más altas (56) para sus botones de 38-40
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.widgets().some(function (w) { return w.type == 'org.apogeo.isla' || w.type == 'org.apogeo.pisos'; })) p.height = 56;
            });
        """)
        st['cristal'] = CRYSTAL
    if st.get('estetica', 0) < AESTHETICS:
        aesthetics()
        st['estetica'] = AESTHETICS
        restart_plasma['pending'] = True
    save_state(st)
    # Al volver de un piso sin avisos sale el resumen de Apogeo, no el «Notificaciones sin leer» de Plasma (también en
    # /etc/xdg; aquí por si la cuenta tenía el suyo). Plasma lo lee la primera vez que lo necesita en la sesión
    kw('libnotificationmanager.notifyrc', 'Event/inhibitionSummary', 'Action', '')
    island(bus, ajustes.load())


