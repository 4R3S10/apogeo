def run(*c):
    subprocess.run(list(c), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kw(f, g, k, v):
    run('kwriteconfig6', '--file', f, '--group', g, '--key', k, v)


def kwn(f, g, k, v):
    """Como kw, pero avisando a quien lo use (KWin lo aplica al momento). El valor puede empezar por «-»."""
    run('kwriteconfig6', '--notify', '--file', f, '--group', g, '--key', k, '--', v)


def run_out(*c):
    try:
        return subprocess.run(list(c), capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ''


def kwin_reconfigure():
    try:
