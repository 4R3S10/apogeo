def run(*c):
    subprocess.run(list(c), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kw(f, g, k, v):
    run('kwriteconfig6', '--file', f, '--group', g, '--key', k, v)


def kwn(f, g, k, v):
    """Como kw, pero avisando a quien lo use (KWin lo aplica al momento). El valor puede empezar por «-»."""
    run('kwriteconfig6', '--notify', '--file', f, '--group', g, '--key', k, '--', v)


def run_out(*c):
    try:
        return subprocess.run(list(c), capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ''


def kwin_reconfigure():
    try:
        dbus.SessionBus().get_object('org.kde.KWin', '/KWin').reconfigure(dbus_interface='org.kde.KWin')
    except dbus.DBusException as e:
        log('kwin:', e.get_dbus_message())


def plasma_theme():
    """El estilo de Plasma «apogeo», escrito en la configuración del usuario. plasma-apply-desktoptheme y kwriteconfig6 no
    lo escriben si /etc/xdg/plasmarc ya dice lo mismo, y entonces Plasma se quedaba con el estilo por defecto (gris)."""
    path = os.path.expanduser('~/.config/plasmarc')
    lines = []
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        pass
    out, group, done = [], None, False
    for line in lines:
        if line.startswith('[') and line.endswith(']'):
            if group == '[Theme]' and not done:
                out.append('name=apogeo')
                done = True
            group = line
        elif group == '[Theme]' and line.startswith('name='):
            if not done:
                out.append('name=apogeo')
                done = True
            continue
        out.append(line)
    if not done:
        if group != '[Theme]':
            out += ([''] if out else []) + ['[Theme]']
        out.append('name=apogeo')
    with open(path, 'w') as f:
        f.write('\n'.join(out) + '\n')


