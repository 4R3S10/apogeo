def search_shortcuts():
    """Los atajos de Apogeo (el buscador, el modo partida, la terminal y las capturas), al momento (por D-Bus a kglobalaccel, que los guarda él; escribir su archivo no vale:
    solo lo lee al empezar la sesión)."""
    def keys(*codes):
        return dbus.Array([dbus.Struct([dbus.Array([dbus.Int32(c), 0, 0, 0], signature='i')]) for c in codes],
                          signature='(ai)')
    meta, alt_f1, alt_f2, alt_space, search = 0x01000022, 0x09000030, 0x09000031, 0x08000020, 0x01000092
    alt_tab, meta_tab, ctrl_alt_t, print_key = 0x08000001, 0x11000001, 0x0C000054, 0x01000009
    try:
        g = dbus.Interface(dbus.SessionBus().get_object('org.kde.kglobalaccel', '/kglobalaccel'), 'org.kde.KGlobalAccel')
        g.setForeignShortcutKeys(['plasmashell', 'activate application launcher', '', ''], keys(alt_f1))
        g.setForeignShortcutKeys(['org.kde.krunner.desktop', '_launch', '', ''], keys(alt_f2))
        g.doRegister(['apogeo-buscador.desktop', '_launch', 'Buscador de Apogeo', 'Buscador de Apogeo'])
        g.setForeignShortcutKeys(['apogeo-buscador.desktop', '_launch', '', ''], keys(meta, alt_space, search))
        # Meta+Tab: el modo partida (apogeo-partida, en KWin); el cambiador de ventanas se queda con Alt+Tab
        g.setForeignShortcutKeys(['kwin', 'Walk Through Windows', '', ''], keys(alt_tab))
        g.doRegister(['kwin', 'Apogeo partida', 'KWin', 'Apogeo: el juego con Discord y lo que suena al lado'])
        g.setForeignShortcutKeys(['kwin', 'Apogeo partida', '', ''], keys(meta_tab))
        # Ctrl+Alt+T abre Ghostty e Impr Pant, Flameshot (Konsole y Spectacle ya no están; si siguieran, sin atajo)
        for old in ('org.kde.konsole.desktop', 'org.kde.spectacle.desktop'):
            try:
                g.setForeignShortcutKeys([old, '_launch', '', ''], keys())
            except dbus.DBusException:
                pass
        g.doRegister(['com.mitchellh.ghostty.desktop', '_launch', 'Ghostty', 'Ghostty'])
        g.setForeignShortcutKeys(['com.mitchellh.ghostty.desktop', '_launch', '', ''], keys(ctrl_alt_t))
        g.doRegister(['org.flameshot.Flameshot.desktop', 'Capture', 'Flameshot', 'Hacer una captura'])
        g.setForeignShortcutKeys(['org.flameshot.Flameshot.desktop', 'Capture', '', ''], keys(print_key))
    except dbus.DBusException as e:
        log('atajos:', e.get_dbus_message())


def zone_location():
    """(latitud, longitud) de tu zona horaria (la ciudad de zone1970.tab: para el anochecer basta). Madrid si no se sabe."""
    try:
        zone = os.path.realpath('/etc/localtime').split('/zoneinfo/', 1)[1]
        with open('/usr/share/zoneinfo/zone1970.tab') as f:
            for line in f:
                cols = line.split('\t')
                if line.startswith('#') or len(cols) < 3 or cols[2].strip() != zone:
                    continue
                c = cols[1]
                cut = max(c.rfind('+'), c.rfind('-'))
                return dms(c[:cut]), dms(c[cut:])
    except (OSError, IndexError, ValueError):
        pass
    return 40.4, -3.7


def dms(text):
    """«+4024» o «-00341» (grados y minutos, y a veces segundos) → grados."""
    sign, d = (-1 if text[0] == '-' else 1), text[1:]
    deg_len = 2 if len(d) in (4, 6) else 3
    deg, rest = int(d[:deg_len]), d[deg_len:]
    mins, secs = int(rest[:2]), int(rest[2:4] or 0)
    return sign * (deg + mins / 60 + secs / 3600)


class Missed:
    """Los avisos que llegan mientras no salen (en Jugar y Estudiar, o con «No molestar»). Se escuchan en el bus (como
    dbus-monitor, sin quitárselos a Plasma, que los guarda en su historial) y, al volver a un piso con avisos, si llegó
    alguno, apogeo-resumen enseña el resumen encima de la isla."""
    RESUMEN = '/usr/lib/apogeo/apogeo-resumen'

    def __init__(self, bus):
        self.since = None        # desde cuándo no salen
        self.floors = []         # los pisos en los que has estado mientras tanto
        self.items = []
        try:
            self.mon = dbus.bus.BusConnection(dbus.bus.BUS_SESSION)
            self.mon.call_blocking('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus.Monitoring',
                                   'BecomeMonitor', 'asu',
                                   (["type='method_call',interface='org.freedesktop.Notifications',member='Notify'"], 0))
            self.mon.add_message_filter(self.heard)
        except dbus.DBusException as e:
            log('resumen:', e.get_dbus_message())

    def start(self, floor):
        if self.since is None:
            self.since = time.time()
            self.floors, self.items = [], []
        if floor not in self.floors:
            self.floors.append(floor)

    def heard(self, _conn, msg):
        try:
            if self.since is None or msg.get_member() != 'Notify':
                return
            app, _rid, icon, title, body, _actions, hints, _timeout = msg.get_args_list()[:8]
            if hints.get('transient') or not (str(title).strip() or str(body).strip()):
                return
            self.items.append({
                'app': str(app), 'icono': str(icon or hints.get('image-path', '') or ''), 'titulo': str(title)[:140],
                'texto': ' '.join(str(body).split())[:240], 'hora': time.strftime('%H:%M'),
                'urgencia': int(hints.get('urgency', 1)), 'desktop': str(hints.get('desktop-entry', '')),
            })
            del self.items[:-200]
        except Exception as e:  # un aviso raro no tumba los pisos
            log('resumen:', e)

    def finish(self):
        if self.since is None:
            return
        since, floors, items = self.since, self.floors, self.items
        self.since, self.floors, self.items = None, [], []
        if not items or not os.access(self.RESUMEN, os.X_OK):
            return
        data = {'pisos': floors, 'segundos': int(time.time() - since), 'avisos': items}
        with tempfile.NamedTemporaryFile('w', suffix='.json', prefix='apogeo-resumen-', delete=False,
                                         dir=os.environ.get('XDG_RUNTIME_DIR')) as f:
            json.dump(data, f, ensure_ascii=False)
        log('resumen:', len(items), 'avisos')
        subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                          f'--unit=app-apogeo-resumen-{int(time.time())}', self.RESUMEN, f.name],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


class Floors:
    def __init__(self, bus, system):
        self.bus = bus
        self.system = system
        self.cookie = None
        self.light_cookie = None   # la luz nocturna de KWin, apagada (inhibida) fuera de Estudiar
        self.light_conf = None     # lo último que se escribió en kwinrc (para no reescribirlo en cada piso)
        self.missed = Missed(bus)  # los avisos que llegan mientras no salen (para el resumen al volver)
        self.visited = set()
        self.last = None
        self.rotate_timer = None   # «que cambie solo»: el temporizador del piso en el que estás
        self.shown = {}            # piso → el fondo que se ve ahora (el elegido o el de «que cambie solo»)
        self.chosen = {}           # piso → el que elegiste a mano (si cambia, se ve ese aunque cambie solo)

    def apply(self, index, force=False):
        if index == self.last and not force:
            return
        self.last = index
        f = FLOORS[min(index, len(FLOORS) - 1)]
        st = ajustes.load()
        mine = st['pisos'][f['key']]
        log('piso', f['name'])
        self.wallpaper(self.pick_wallpaper(st, f['key'], entering=not force), st['animar'], f['key'])
        self.schedule_rotation(st, f['key'])
        self.quiet(st['silencio'] or not mine['avisos'], f['key'])
        self.light(st, f['key'])
        self.power(mine['energia'])
        if force:
            return
        if index not in self.visited:
            # Solo si se queda en el piso: pasar de largo con la rueda no abre nada (y la ventana, al aparecer tarde,
            # le devolvería a este piso)
            GLib.timeout_add(1500, self.first_visit, index)

    def first_visit(self, index):
        if self.last == index and welcome_open():
            return True  # con la bienvenida delante no se abre nada (Ágape, por ejemplo, lo instala ella): luego
        if self.last == index and index not in self.visited:
            self.visited.add(index)
            self.open_apps(ajustes.load()['pisos'][FLOORS[index]['key']]['apps'])
        return False

    def settings_changed(self):
        """Has cambiado algo en los ajustes: el piso en el que estás y la isla, ya."""
        self.apply(self.last if self.last is not None else current_index(self.bus), force=True)
        island(self.bus, ajustes.load())

    # ----- «Que cambie solo» -----

    def pick_wallpaper(self, st, floor, entering=False, advance=False):
        """El fondo que toca en el piso: el que elegiste o, con «que cambie solo», el siguiente de la lista (al entrar en
        el piso, si es «al entrar», o cuando pasa el tiempo)."""
        rot = st['fondos']['cambiar'][floor]
        chosen = st['pisos'][floor]['fondo']
        if not rot['activo'] or self.chosen.get(floor, chosen) != chosen:
            # Sin «que cambie solo», o acabas de elegir uno a mano: se ve ese
            self.chosen[floor] = chosen
            self.shown[floor] = chosen
            return chosen
        self.chosen[floor] = chosen
        if advance or (entering and rot['cada'] == 'piso') or floor not in self.shown:
            pool = ajustes.rotation_pool(st, floor)
            state = load_state()
            idx = state.setdefault('rotacion', {}).get(floor, -1)
            if advance or (entering and rot['cada'] == 'piso'):
                idx += 1
            idx = max(0, idx) % len(pool)
            state['rotacion'][floor] = idx
            save_state(state)
            self.shown[floor] = pool[idx]
        return self.shown[floor]

    def schedule_rotation(self, st, floor):
        if self.rotate_timer:
            GLib.source_remove(self.rotate_timer)
            self.rotate_timer = None
        rot = st['fondos']['cambiar'][floor]
        every = ajustes.EVERY[rot['cada']]
        if rot['activo'] and every:
            self.rotate_timer = GLib.timeout_add_seconds(every, self.rotate, floor)

    def rotate(self, floor):
        if self.last is None or FLOORS[self.last]['key'] != floor:
            self.rotate_timer = None
            return False
        st = ajustes.load()
        if not st['fondos']['cambiar'][floor]['activo']:
            self.rotate_timer = None
            return False
        self.wallpaper(self.pick_wallpaper(st, floor, advance=True), st['animar'], floor)
        return True

    def wallpaper(self, style, animate, floor):
        """El fondo animado de Ágape del piso (org.apogeo.fondo). Sin gráfica de verdad, quieto (lo dibujaría el
        procesador), y también si lo apagas en los ajustes. También en la pantalla de bloqueo, que así sabe en qué piso
        estabas."""
        animate = 'true' if animate and real_gpu() else 'false'
        # Un fondo animado de Apogeo o una imagen o un vídeo tuyo (Archivo)
        if style in ajustes.STYLES:
            archivo = ''
        else:
            archivo, style = style, 'tinta'
        archivo_js = json.dumps(archivo)
        run('kwriteconfig6', '--file', 'kscreenlockerrc', '--group', 'Greeter', '--key', 'WallpaperPlugin',
            'org.apogeo.fondo')
        for key, value in (('Estilo', style), ('Animar', animate), ('Piso', floor), ('Archivo', archivo)):
            run('kwriteconfig6', '--file', 'kscreenlockerrc', '--group', 'Greeter', '--group', 'Wallpaper', '--group',
                'org.apogeo.fondo', '--group', 'General', '--key', key, value)
        plasma_script(self.bus, """
            desktops().forEach(function (d) {
                d.wallpaperPlugin = 'org.apogeo.fondo';
                d.currentConfigGroup = ['Wallpaper', 'org.apogeo.fondo', 'General'];
                d.writeConfig('Estilo', '%s');
                d.writeConfig('Animar', %s);
                d.writeConfig('Piso', '%s');
                d.writeConfig('Archivo', %s);
            });
        """ % (style, animate, floor, archivo_js))

    def quiet(self, on, floor):
        """No molestar mientras se esté en el piso: lo que llegue se queda en el historial de avisos y, al volver a un
        piso con avisos, sale el resumen de lo que llegó."""
        if on:
            self.missed.start(floor)
        try:
            n = dbus.Interface(self.bus.get_object('org.freedesktop.Notifications', '/org/freedesktop/Notifications'),
                               'org.freedesktop.Notifications')
            if on and self.cookie is None:
                self.cookie = n.Inhibit('apogeo-pisos', 'Piso sin avisos', dbus.Dictionary({}, signature='sv'))
            elif not on and self.cookie is not None:
                n.UnInhibit(self.cookie)
                self.cookie = None
        except dbus.DBusException as e:
            log('avisos:', e.get_dbus_message())
        if not on:
            self.missed.finish()

    def light(self, st, floor):
        """Luz cálida en Estudiar por la noche: la luz nocturna de KWin (sigue el día y la noche de tu zona: al anochecer
        entra poco a poco y al amanecer se va), encendida con tu calor y apagada (inhibida) en los demás pisos. Si Plasma
        no sabe dónde estás, tu zona sale de tu zona horaria (sin preguntar a internet)."""
        luz = st['luz']
        conf = (luz['activa'], luz['calor'])
        if conf != self.light_conf:
            self.light_conf = conf
            if luz['activa']:
                lat = run_out('kreadconfig6', '--file', 'knighttimerc', '--group', 'Location', '--key', 'Latitude')
                auto = run_out('kreadconfig6', '--file', 'knighttimerc', '--group', 'Location', '--key', 'Automatic')
                if not lat and auto != 'false':
                    lat, lon = zone_location()
                    kwn('knighttimerc', 'Location', 'Automatic', 'false')
                    kwn('knighttimerc', 'Location', 'Latitude', f'{lat:.2f}')
                    kwn('knighttimerc', 'Location', 'Longitude', f'{lon:.2f}')
                kwn('kwinrc', 'NightColor', 'NightTemperature', str(luz['calor']))
                kwn('kwinrc', 'NightColor', 'Active', 'true')
            else:
                kwn('kwinrc', 'NightColor', 'Active', 'false')
        try:
            nl = dbus.Interface(self.bus.get_object('org.kde.KWin', '/org/kde/KWin/NightLight'), 'org.kde.KWin.NightLight')
            off = floor != 'estudiar' or not luz['activa']
            if off and self.light_cookie is None:
                self.light_cookie = nl.inhibit()
            elif not off and self.light_cookie is not None:
                nl.uninhibit(dbus.UInt32(self.light_cookie))
                self.light_cookie = None
        except dbus.DBusException as e:
            log('luz:', e.get_dbus_message())

    def power(self, profile):
        try:
            pp = self.system.get_object('org.freedesktop.UPower.PowerProfiles', '/org/freedesktop/UPower/PowerProfiles')
            pp.Set('org.freedesktop.UPower.PowerProfiles', 'ActiveProfile', profile,
                   dbus_interface='org.freedesktop.DBus.Properties')
        except dbus.DBusException as e:
            log('energía:', e.get_dbus_message())

    def open_apps(self, app_ids):
        for app_id in app_ids:
            info = ajustes.app_info(app_id)
            if not info:
                continue  # ya no está instalada
            exe = os.path.basename(info[2].strip('"'))
            if exe and subprocess.run(['pgrep', '-x', exe], stdout=subprocess.DEVNULL).returncode == 0:
                continue  # ya está abierta (en este u otro piso)
            log('abriendo', app_id)
            path = ajustes.desktop_info(app_id).get_filename()
            # En su propio grupo de systemd (como si la abrieras tú): si este programa se reinicia, la app sigue abierta
            subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                              f'--unit=app-apogeo-{exe or "app"}-{os.getpid()}-{len(self.visited)}', 'gio', 'launch', path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                             env=dict(os.environ, APOGEO_AUTO='1'))  # (la abre el piso, no tú)


def island(bus, st):
    """La isla como en los ajustes: si se esconde sola, lo de cada piso (temperatura y FPS, música, temporizador) y los
    números de la salud del PC que enseña en Jugar."""
    cfg = st['isla']
    # Las dos se esconden del todo (o no, si lo quitas en los ajustes); el script de KWin «apogeo-bordes» las saca al
    # acercar el ratón a una franja ancha del borde, y tiene que saber si lo hace
    kw('kwinrc', 'Script-apogeo-bordes', 'isla', 'true' if cfg['esconder'] else 'false')
    kw('kwinrc', 'Script-apogeo-bordes', 'pisos', 'true' if cfg['esconderPisos'] else 'false')
    kwin_reconfigure()
    plasma_script(bus, """
        panels().forEach(function (p) {
            if (p.location == 'right') p.hiding = %s;
            if (p.location != 'bottom') return;
            p.hiding = %s;
            p.widgets().forEach(function (w) {
                if (w.type != 'org.apogeo.isla') return;
                w.currentConfigGroup = ['General'];
                w.writeConfig('extraJugar', %s);
                w.writeConfig('extraNavegar', %s);
                w.writeConfig('extraEstudiar', %s);
                w.writeConfig('fps', %d);
                w.writeConfig('limite', %d);
                w.reloadConfig();
            });
        });
    """ % (json.dumps('autohide' if cfg['esconderPisos'] else 'none'), json.dumps('autohide' if cfg['esconder'] else 'none'),
           json.dumps(cfg['jugar']), json.dumps(cfg['navegar']),
           json.dumps(cfg['estudiar']), st['fps'], ajustes.health()['limite']))


def welcome_open():
    return subprocess.run(['pgrep', '-f', WELCOME], stdout=subprocess.DEVNULL).returncode == 0


def welcome():
    """La bienvenida, hasta que se termine (o se pulse «No volver a mostrar»)."""
    if os.path.exists(WELCOME_DONE) or welcome_open() or not os.access(WELCOME, os.X_OK):
        return
    log('bienvenida')
    subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                      f'--unit=app-apogeo-bienvenida-{os.getpid()}', WELCOME, '--auto'],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def real_gpu():
    """¿Hay una gráfica que dibuje el fondo animado? En una máquina virtual sin 3D lo dibujaría el procesador."""
    for card in glob.glob('/sys/class/drm/card[0-9]/device/driver'):
        if os.path.basename(os.path.realpath(card)) in ('amdgpu', 'radeon', 'i915', 'xe', 'nouveau', 'nvidia'):
            return True
    return False


def start_floor():
    """El piso elegido en la pantalla de inicio de sesión (lo apunta apogeo-sesion); si no, Navegar. Se borra al leerlo:
    si este programa se reinicia a media sesión, no te cambia de piso."""
    path = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'apogeo-piso')
    try:
        with open(path) as f:
            key = f.read().strip()
        os.remove(path)
    except OSError:
        return 1
    return next((k for k, f in enumerate(FLOORS) if f['key'] == key), 1)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == 'ir' and len(sys.argv) > 2:
            go(bus, int(sys.argv[2]))
        elif cmd in ('subir', 'bajar'):
            go(bus, current_index(bus) + (-1 if cmd == 'subir' else 1))
        elif cmd == 'url' and len(sys.argv) > 2 and sys.argv[2].partition(':')[2].strip('/').isdigit():
            go(bus, int(sys.argv[2].partition(':')[2].strip('/')))
        return
    setup(bus)
    import apogeo_datos
    datos = apogeo_datos.Datos(bus)  # noqa: F841 (los datos de los widgets: el tiempo, el estudio… por D-Bus)
    floors = Floors(bus, dbus.SystemBus())
    bus.add_signal_receiver(lambda _id: floors.apply(current_index(bus)), signal_name='currentChanged',
                            dbus_interface='org.kde.KWin.VirtualDesktopManager', path='/VirtualDesktopManager')
    go(bus, start_floor())
    # El buscador, preparado (para que la lupa de la isla y la tecla Meta lo saquen al momento), y la música de abajo a
    # la izquierda (sale sola cuando suena algo)
    for name, args in (('buscador', ['--fondo']), ('musica', [])):
        subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                          f'--unit=app-apogeo-{name}-{os.getpid()}', f'/usr/lib/apogeo/apogeo-{name}', *args],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    welcome()
    floors.apply(current_index(bus))
    GLib.timeout_add_seconds(6, lambda: desktop_fill(bus))
    # Los ajustes: al guardarlos (de golpe, con un archivo nuevo) se aplican
    monitor = Gio.File.new_for_path(os.path.dirname(ajustes.SETTINGS)).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES,
                                                                                          None)
    pending = {'id': None}

    def changed(_m, f, other, _event):
        names = {x.get_basename() for x in (f, other) if x}
        if os.path.basename(ajustes.SETTINGS) not in names:
            return
        if pending['id']:
            GLib.source_remove(pending['id'])
        pending['id'] = GLib.timeout_add(250, lambda: (pending.update(id=None), floors.settings_changed(), False)[-1])
    os.makedirs(os.path.dirname(ajustes.SETTINGS), exist_ok=True)
    monitor.connect('changed', changed)
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
