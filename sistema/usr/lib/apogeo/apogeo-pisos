def log(*a):
    print('[pisos]', *a, flush=True)


def vdm(bus):
    return bus.get_object('org.kde.KWin', '/VirtualDesktopManager')


def prop(obj, name):
    return obj.Get('org.kde.KWin.VirtualDesktopManager', name, dbus_interface='org.freedesktop.DBus.Properties')


def desktops(bus):
    """[(posición, id, nombre)] en orden."""
    return sorted((int(p), str(i), str(n)) for p, i, n in prop(vdm(bus), 'desktops'))


def go(bus, index):
    ds = desktops(bus)
    index = max(0, min(index, len(ds) - 1))
    vdm(bus).Set('org.kde.KWin.VirtualDesktopManager', 'current', ds[index][1],
                 dbus_interface='org.freedesktop.DBus.Properties')


def current_index(bus):
    cur = str(prop(vdm(bus), 'current'))
    return next((k for k, (_, i, _n) in enumerate(desktops(bus)) if i == cur), 0)


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, 'w') as f:
        json.dump(st, f)


def write_mode(index):
    """Publica el modo actual para quien no hable D-Bus (apps, scripts, la consola): ~/.config/apogeo/modo.json."""
    index = max(0, min(int(index), len(FLOORS) - 1))
    data = {'modo': FLOORS[index]['key'], 'piso': index, 'desde': int(time.time()), 'version': 1}
    try:
        os.makedirs(os.path.dirname(MODE), exist_ok=True)
        tmp = MODE + '.nuevo'
        with open(tmp, 'w') as f:
            json.dump(data, f)
        os.replace(tmp, MODE)
    except OSError as e:
        log('modo:', e)
    return data


_modos = None


class Modos(dbus.service.Object):
    """org.apogeo.Modos1: el modo actual, cambiar de modo y una señal cuando cambia. apogeo-pisos es su dueño."""

    def __init__(self, bus, name):
        super().__init__(bus, '/Modos')
        self.bus = bus
        self.name = name
        self.actual = write_mode(current_index(bus))['modo']
        self.missed = None   # (los avisos que no salen: los pone Floors)

    def publish(self, index):
        data = write_mode(index)
        if data['modo'] != self.actual:
            self.actual = data['modo']
            self.Cambiado(data['modo'])
        return data

    @dbus.service.method('org.apogeo.Modos1', in_signature='', out_signature='s')
    def Actual(self):
        return self.actual

    @dbus.service.method('org.apogeo.Modos1', in_signature='', out_signature='i')
    def Piso(self):
        return FLOORS.index(next((f for f in FLOORS if f['key'] == self.actual), FLOORS[1]))

    @dbus.service.method('org.apogeo.Modos1', in_signature='s', out_signature='b')
    def Cambiar(self, modo):
        modo = str(modo)
        if modo not in MODE_KEYS:
            return False
        go(self.bus, MODE_KEYS.index(modo))
        return True

    @dbus.service.method('org.apogeo.Modos1', in_signature='', out_signature='s')
    def Siguiente(self):
        i = (self.Piso() + 1) % len(FLOORS)
        self.Cambiar(FLOORS[i]['key'])
        return FLOORS[i]['key']

    @dbus.service.method('org.apogeo.Modos1', in_signature='', out_signature='s')
    def Anterior(self):
        i = (self.Piso() - 1) % len(FLOORS)
        self.Cambiar(FLOORS[i]['key'])
        return FLOORS[i]['key']

    @dbus.service.method('org.apogeo.Modos1', in_signature='', out_signature='s')
    def Avisos(self):
        """Los avisos que han llegado sin salir (en Jugar, Estudiar o con «No molestar»), el último primero, en JSON: los
        enseña el centro de control de Jugar."""
        items = self.missed.items if self.missed and self.missed.since is not None else []
        return json.dumps(items[::-1][:30], ensure_ascii=False)

    @dbus.service.signal('org.apogeo.Modos1', signature='s')
    def Cambiado(self, modo):
        pass


def plasma_script(bus, js):
    """Ejecuta un script de Plasma y devuelve lo que imprima (None si Plasma no está)."""
    try:
        return str(bus.get_object('org.kde.plasmashell', '/PlasmaShell').evaluateScript(js, dbus_interface='org.kde.PlasmaShell'))
    except dbus.DBusException as e:
        log('plasmashell:', e.get_dbus_message())
        return None


restart_plasma = {'pending': False}  # el estilo de Plasma recién puesto solo se ve al reiniciarlo


def set_keys(path, group, values):
    """Pone claves en un grupo de un archivo de configuración de KDE (con Plasma parado, para que no lo pise)."""
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return
    header = f'[{group}]'
    out, inside, left = [], False, dict(values)
    for line in lines:
        if line.startswith('['):
            if inside and left:
                out += [f'{k}={v}' for k, v in left.items()]
                left = {}
            inside = line == header
        elif inside and '=' in line and line.split('=', 1)[0] in left:
            k = line.split('=', 1)[0]
            out.append(f'{k}={left.pop(k)}')
            continue
        out.append(line)
    if inside and left:
        out += [f'{k}={v}' for k, v in left.items()]
    elif left:
        out += ['', header] + [f'{k}={v}' for k, v in left.items()]
    with open(path, 'w') as f:
        f.write('\n'.join(out) + '\n')


def desktop_fill(bus):
    """El widget del escritorio tiene que ocupar la pantalla entera. Plasma guarda el sitio de cada widget por tamaño de
    pantalla y lo pisa al cerrarse, así que se corrige con Plasma parado (un instante, solo cuando hace falta: la
    primera vez, al cambiar de pantalla o de resolución)."""
    out = plasma_script(bus, """
        var o = [];
        desktops().forEach(function (d) {
            var g = screenGeometry(d.screen);
            d.widgets().forEach(function (w) {
                if (w.type == 'org.apogeo.escritorio') o.push([d.id, w.id, g.width, g.height, w.geometry.x, w.geometry.y, w.geometry.width, w.geometry.height]);
            });
        });
        print(JSON.stringify(o));
    """)
    if out is None:  # Plasma aún arrancando: se vuelve a mirar en un rato (hasta un minuto)
        desktop_fill.tries = getattr(desktop_fill, 'tries', 0) + 1
        return desktop_fill.tries < 12
    try:
        items = json.loads(out) if out else []
    except ValueError:
        items = []
    # Plasma le quita el hueco de la isla cuando la isla no se esconde: eso vale
    # (Plasma le quita al widget el hueco de una barra que no se esconde: la isla abajo o la columna de pisos a la derecha,
    # hasta 120 px; eso vale)
    bad = [i for i in items if round(i[4]) != 0 or round(i[5]) != 0 or not i[2] - 120 <= round(i[6]) <= i[2]
           or not i[3] - 120 <= round(i[7]) <= i[3]]
    if not bad and not restart_plasma['pending']:
        desktop_fill.seen = None
        return False
    # Al entrar, la pantalla cambia de tamaño un momento (sobre todo en una máquina virtual) y el widget parece mal puesto
    # sin estarlo: solo se arregla si sigue mal 8 segundos después con el mismo tamaño de pantalla, y una vez por sesión
    # (reiniciar Plasma deja todo pillado unos segundos: antes pasaba varias veces seguidas)
    key = json.dumps([[i[2], i[3], round(i[4]), round(i[5]), round(i[6]), round(i[7])] for i in bad])
    if not restart_plasma['pending']:
        if getattr(desktop_fill, 'done', False):
            log('escritorio: sigue sin ocupar la pantalla; no se reinicia Plasma otra vez en esta sesión')
            return False
        if getattr(desktop_fill, 'seen', None) != key:
            desktop_fill.seen = key
            GLib.timeout_add_seconds(8, lambda: desktop_fill(bus))
            return False
    desktop_fill.done = True
    log('escritorio a pantalla completa: Plasma se reinicia', key)
    run('systemctl', '--user', 'stop', 'plasma-plasmashell')
    rc = os.path.expanduser('~/.config/plasma-org.kde.plasma.desktop-appletsrc')
    for cid, aid, w, h, *_ in bad:
        v = f'Applet-{aid}:0,0,{w},{h},0;'
        set_keys(rc, f'Containments][{cid}', {f'ItemGeometries-{w}x{h}': v, 'ItemGeometriesHorizontal': v})
    restart_plasma['pending'] = False
    run('systemctl', '--user', 'start', 'plasma-plasmashell')
    return False


def setup(bus):
    """La primera vez: tres escritorios en columna con los nombres de los pisos, la isla y los dos paneles de los lados."""
    st = load_state()
    ds = desktops(bus)
    m = vdm(bus)
    for k, f in enumerate(FLOORS):
        if k < len(ds):
            if ds[k][2] != f['name']:
                m.setDesktopName(ds[k][1], f['name'], dbus_interface='org.kde.KWin.VirtualDesktopManager')
        else:
            m.createDesktop(dbus.UInt32(k), f['name'], dbus_interface='org.kde.KWin.VirtualDesktopManager')
    props = 'org.freedesktop.DBus.Properties'
    m.Set('org.kde.KWin.VirtualDesktopManager', 'rows', dbus.UInt32(len(FLOORS)), dbus_interface=props)
    m.Set('org.kde.KWin.VirtualDesktopManager', 'navigationWrappingAround', False, dbus_interface=props)
    if st.get('isla', 0) < ISLAND:
        # La isla: fuera la barra de abajo de CachyOS; una isla centrada, flotante, que se esconde sola
        plasma_script(bus, """
            panels().forEach(function (p) { if (p.location == 'bottom') p.remove(); });
            var p = new Panel;
            p.location = 'bottom';
            p.floating = true;
            p.height = 56;
            p.lengthMode = 'fit';
            p.alignment = 'center';
            p.hiding = 'autohide';
            p.addWidget('org.apogeo.isla');
            p.addWidget('org.kde.plasma.systemtray');
            p.addWidget('org.apogeo.rapido');
        """)
        st['isla'] = ISLAND
    if st.get('bandeja', 0) < TRAY:
        # La bandeja de la isla, limpia: a la vista solo red, sonido, batería, brillo y avisos; lo demás, en la flecha
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.location != 'bottom') return;
                p.widgets().forEach(function (w) {
                    if (w.type == 'org.kde.plasma.systemtray') {
                        w.currentConfigGroup = ['General'];
                        w.writeConfig('hiddenItems', %s);
                        w.reloadConfig();
                    }
                    if (w.type == 'org.kde.plasma.digitalclock') {
                        w.currentConfigGroup = ['Appearance'];
                        w.writeConfig('use24hFormat', 2);
                        w.reloadConfig();
                    }
                });
            });
        """ % json.dumps(TRAY_HIDDEN))
        st['bandeja'] = TRAY
    if st.get('reloj', 0) < CLOCK:
        # La hora de la isla con la letra de Órbita (en negrita)
        plasma_script(bus, """
            panels().forEach(function (p) {
                p.widgets().forEach(function (w) {
                    if (w.type != 'org.kde.plasma.digitalclock') return;
                    w.currentConfigGroup = ['Appearance'];
                    w.writeConfig('autoFontAndSize', false);
                    w.writeConfig('fontFamily', 'Geist');
                    w.writeConfig('boldText', true);
                    w.writeConfig('fontSize', 11);
                    w.writeConfig('use24hFormat', 2);
                    w.reloadConfig();
                });
            });
        """)
        st['reloj'] = CLOCK
    if st.get('escritorio', 0) < DESKTOP:
        # El escritorio sin iconos de apps (enseña una carpeta vacía) y, encima, el widget de Apogeo a pantalla completa
        # (en Navegar la hora y tus widgets; en Estudiar tu carpeta de estudio, el temporizador, exámenes y tareas)
        plasma_script(bus, """
            desktops().forEach(function (d) {
                d.currentConfigGroup = ['General'];
                d.writeConfig('url', 'file:///usr/share/apogeo/escritorio-vacio');
                d.reloadConfig();
                var g = screenGeometry(d.screen);
                var w = d.widgets().filter(function (x) { return x.type == 'org.apogeo.escritorio'; })[0];
                if (!w) w = d.addWidget('org.apogeo.escritorio', 0, 0, g.width, g.height);
            });
        """)
        st['escritorio'] = DESKTOP
        save_state(st)
        # A pantalla completa lo pone desktop_fill (se mira en cada inicio de sesión)
    if st.get('rapido', 0) < QUICK:
        # El panel rápido (red, bluetooth, volumen, energía, no molestar…) al final de la isla, después de la hora
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.location != 'bottom') return;
                var has = p.widgets().some(function (w) { return w.type == 'org.apogeo.rapido'; });
                if (!has && p.widgets().some(function (w) { return w.type == 'org.apogeo.isla'; })) p.addWidget('org.apogeo.rapido');
            });
        """)
        st['rapido'] = QUICK
    if st.get('isla2', 0) < ISLAND2:
        # I1 · Una sola isla: la red, el sonido, los avisos y la hora van en el panel rápido de Apogeo (dentro de la
        # isla). Fuera el reloj de KDE y, de la bandeja, lo del sistema: solo quedan los iconos de tus apps (Discord,
        # Steam…), sin la flechita. Los avisos (los da Plasma igual, sin su campana) salen abajo a la derecha.
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.location != 'bottom') return;
                if (!p.widgets().some(function (w) { return w.type == 'org.apogeo.isla'; })) return;
                p.widgets().forEach(function (w) {
                    if (w.type == 'org.kde.plasma.digitalclock') w.remove();
                    if (w.type == 'org.kde.plasma.systemtray') {
                        w.currentConfigGroup = ['General'];
                        w.writeConfig('extraItems', []);
                        w.writeConfig('hiddenItems', []);
                        w.reloadConfig();
                    }
                });
                if (!p.widgets().some(function (w) { return w.type == 'org.apogeo.rapido'; })) p.addWidget('org.apogeo.rapido');
            });
        """)
        run('kwriteconfig6', '--notify', '--file', 'plasmanotifyrc', '--group', 'Notifications', '--key',
            'PopupPosition', 'BottomRight')
        st['isla2'] = ISLAND2
    if st.get('mangohud', 0) < MANGOHUD:
        # MangoHud en los juegos (pequeño, siempre a la vista) con el límite de FPS: su configuración y el entorno
        cfg = ajustes.load()
        ajustes.write_fps(cfg['fps'], cfg.get('juegos_fps'))
        st['mangohud'] = MANGOHUD
    if st.get('ligero', 0) < LIGHTER:
        # Menos cosas en marcha: el menú global (Apogeo no tiene barra de menús arriba), el ayudante de accesibilidad
        # (teclas especiales; se puede volver a encender en Ajustes del sistema → Accesibilidad) y los avisos de Limine y
        # Snapper de CachyOS al arrancar (lo de volver a una instantánea lo cuenta Apogeo: Ajustes → Actualizaciones)
        for name in ('gmenudbusmenuproxy', 'kaccess', 'limine-snapper-notify', 'limine-restore-notify'):
            path = os.path.join(HOME, '.config/autostart', name + '.desktop')
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w') as f:
                f.write(f'[Desktop Entry]\nType=Application\nName={name}\nHidden=true\n')
        st['ligero'] = LIGHTER
    if st.get('cristal', 0) < CRYSTAL:
        # B1 · Cristal: la isla y la columna de modos un poco más altas (56) para sus botones de 38-40
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.widgets().some(function (w) { return w.type == 'org.apogeo.isla' || w.type == 'org.apogeo.pisos'; })) p.height = 56;
            });
        """)
        st['cristal'] = CRYSTAL
    if st.get('paneles', 0) < PANELS:
        # «Nivel pro»: fuera la columna de pisos (los pisos van arriba del panel rápido) y, a la derecha, el panel rápido
        # alto. Escondido: lo saca el script apogeo-bordes (Meta+N, la barra de arriba o el ratón contra el borde) y,
        # abierto, hace sitio. (El de widgets de la izquierda ya no está: lo suyo va en la Órbita abierta.)
        plasma_script(bus, """
            panels().forEach(function (p) {
                if (p.widgets().some(function (w) { return w.type == 'org.apogeo.pisos'; })) p.remove();
            });
            [['right', 'org.apogeo.derecho']].forEach(function (s) {
                var has = panels().some(function (p) {
                    return p.widgets().some(function (w) { return w.type == s[1]; });
                });
                if (has) return;
                var p = new Panel;
                p.location = s[0];
                p.floating = true;
                p.height = %d;
                p.lengthMode = 'fill';
                p.hiding = 'autohide';
                p.addWidget(s[1]);
            });
        """ % PANEL_WIDTH)
        panel_shortcuts()
        kwin_reconfigure()
        st['paneles'] = PANELS
    if st.get('dinamica', 0) < DYNAMIC:
        # Isla dinámica: el volumen sale en la isla (no en la ventanita de KDE); «7 · Animaciones con vida» (abrir con
        # un saltito y cerrar encogiéndose: apogeo-vida; minimizar con la lámpara mágica, hacia su icono en la isla) y
        # «6 · Alt+Tab de cristal» (el selector de ventanas «apogeo»)
        kw('plasmaparc', 'General', 'VolumeOsd', 'false')
        kw('plasmaparc', 'General', 'MuteOsd', 'false')
        for action in ('unloadModule', 'loadModule'):  # (el que la saca lo lee al empezar)
            run('qdbus6', 'org.kde.kded6', '/kded', 'org.kde.kded6.' + action, 'audioshortcutsservice')
        for effect, on in (('apogeo-vida', 'true'), ('scale', 'false'), ('fade', 'false'), ('glide', 'false'),
                           ('magiclamp', 'true'), ('squash', 'false')):
            kw('kwinrc', 'Plugins', effect + 'Enabled', on)
        kw('kwinrc', 'TabBox', 'LayoutName', 'apogeo')
        kw('kwinrc', 'TabBox', 'ShowTabBox', 'true')
        kwin_reconfigure()
        # (antes Alt+Tab se guardaba como «Alt+\x01» y no hacía nada: se vuelve a poner bien)
        try:
            g = dbus.Interface(dbus.SessionBus().get_object('org.kde.kglobalaccel', '/kglobalaccel'),
                               'org.kde.KGlobalAccel')
            g.setForeignShortcutKeys(['kwin', 'Walk Through Windows', '', ''], _keys(0x09000001))
        except dbus.DBusException as e:
            log('Alt+Tab: %s' % e)
        st['dinamica'] = DYNAMIC
    if st.get('orbe', 0) < ORB:
        # «C · Orbe central»: arriba, una barra fina sin fondo con el modo a la izquierda y, a la derecha, los iconos de
        # tus apps (bandeja) y el panel rápido (la hora, la red, los avisos); abajo, solo el orbe (la isla)
        plasma_script(bus, """
            var bar = panels().filter(function (p) {
                return p.widgets().some(function (w) { return w.type == 'org.apogeo.modo'; });
            })[0];
            if (!bar) {
                bar = new Panel;
                bar.location = 'top';
                bar.floating = false;
                bar.height = 30;
                bar.lengthMode = 'fill';
                bar.hiding = 'none';
                bar.addWidget('org.apogeo.modo');
                bar.addWidget('org.kde.plasma.panelspacer');
                var tray = bar.addWidget('org.kde.plasma.systemtray');
                tray.currentConfigGroup = ['General'];
                tray.writeConfig('extraItems', []);
                tray.writeConfig('hiddenItems', []);
                tray.reloadConfig();
                bar.addWidget('org.apogeo.rapido');
            }
            panels().forEach(function (p) {
                if (!p.widgets().some(function (w) { return w.type == 'org.apogeo.isla'; })) return;
                p.widgets().forEach(function (w) {
                    if (w.type == 'org.kde.plasma.systemtray' || w.type == 'org.apogeo.rapido') w.remove();
                });
            });
            // (2) Fuera el panel de widgets de la izquierda: la agenda, tus notas y Estudios están en la Órbita abierta
            panels().forEach(function (p) {
                if (p.widgets().some(function (w) { return w.type == 'org.apogeo.izquierdo'; })) p.remove();
            });
        """)
        panel_shortcuts()
        st['orbe'] = ORB
    if st.get('estetica', 0) < AESTHETICS:
        aesthetics()
        st['estetica'] = AESTHETICS
        restart_plasma['pending'] = True
    save_state(st)
    # Al volver de un piso sin avisos sale el resumen de Apogeo, no el «Notificaciones sin leer» de Plasma (también en
    # /etc/xdg; aquí por si la cuenta tenía el suyo). Plasma lo lee la primera vez que lo necesita en la sesión
    kw('libnotificationmanager.notifyrc', 'Event/inhibitionSummary', 'Action', '')
    island(bus, ajustes.load())


