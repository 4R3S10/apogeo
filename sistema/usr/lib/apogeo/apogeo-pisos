    except dbus.DBusException as e:
        log('kwin:', e.get_dbus_message())


def plasma_theme():
    """El estilo de Plasma «apogeo», escrito en la configuración del usuario. plasma-apply-desktoptheme y kwriteconfig6 no
    lo escriben si /etc/xdg/plasmarc ya dice lo mismo, y entonces Plasma se quedaba con el estilo por defecto (gris)."""
    path = os.path.expanduser('~/.config/plasmarc')
    lines = []
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        pass
    out, group, done = [], None, False
    for line in lines:
        if line.startswith('[') and line.endswith(']'):
            if group == '[Theme]' and not done:
                out.append('name=apogeo')
                done = True
            group = line
        elif group == '[Theme]' and line.startswith('name='):
            if not done:
                out.append('name=apogeo')
                done = True
            continue
        out.append(line)
    if not done:
        if group != '[Theme]':
            out += ([''] if out else []) + ['[Theme]']
        out.append('name=apogeo')
    with open(path, 'w') as f:
        f.write('\n'.join(out) + '\n')


