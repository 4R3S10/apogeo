def obsidian_notes(st):
    """Tus bóvedas de Obsidian con la letra de los apuntes (Source Serif 4) y el ámbar de Estudiar: un fragmento CSS
    que se enciende una sola vez por bóveda (si luego lo apagas, se respeta)."""
    try:
        with open(os.path.join(HOME, '.config/obsidian/obsidian.json')) as f:
            vaults = [v.get('path') for v in (json.load(f).get('vaults') or {}).values() if isinstance(v, dict)]
    except (OSError, ValueError, AttributeError):
        return
    done = st.setdefault('obsidian', [])
    for path in vaults:
        conf = os.path.join(path or '', '.obsidian')
        if not path or not os.path.isdir(conf) or path in done:
            continue
        try:
            os.makedirs(os.path.join(conf, 'snippets'), exist_ok=True)
            with open(os.path.join(conf, 'snippets', 'orbita-apuntes.css'), 'w') as f:
                f.write(OBSIDIAN_SNIPPET)
            look = os.path.join(conf, 'appearance.json')
            try:
                with open(look) as f:
                    data = json.load(f)
            except (OSError, ValueError):
                data = {}
            on = data.setdefault('enabledCssSnippets', [])
            if 'orbita-apuntes' not in on:
                on.append('orbita-apuntes')
            with open(look + '.nuevo', 'w') as f:
                json.dump(data, f, indent=2)
            os.replace(look + '.nuevo', look)
            done.append(path)
        except OSError as e:
            log('obsidian:', e)


def carousel(st):
    """Karousel en los pisos que lo tienen (por el nombre del escritorio), con los huecos y anchos de Ajustes y sus
    atajos en Meta+Alt. Sin ningún piso, apagado y con los atajos de KWin de siempre."""
    global _carousel_done
    names = [f['name'] for f in FLOORS if st['pisos'][f['key']]['carrusel']]
    car = st['carrusel']
    want = (tuple(names), car['huecos'], tuple(car['anchos']))
    if want == _carousel_done:
        return
    reload = _carousel_done is not None and bool(_carousel_done[0]) and bool(names)
    _carousel_done = want
    on = bool(names)
    try:
        g = dbus.Interface(dbus.SessionBus().get_object('org.kde.kglobalaccel', '/kglobalaccel'), 'org.kde.KGlobalAccel')
        # (antes de que cargue Karousel: así se queda con estas teclas y no con las suyas de serie)
        for name in list(CAROUSEL_KEYS) + CAROUSEL_OTHERS:
            action = ['kwin', 'karousel-' + name, 'KWin', 'Karousel: ' + name]
            g.doRegister(action)
            code = CAROUSEL_KEYS.get(name) if on else None
            g.setForeignShortcutKeys(action[:2] + ['', ''], _keys(code) if code else _keys())
        for name, code in KWIN_SWITCH.items():
            g.setForeignShortcutKeys(['kwin', name, '', ''], _keys() if on else _keys(code))
    except dbus.DBusException as e:
        log('carrusel:', e.get_dbus_message())
    gap = str(car['huecos'])
    for key in ('gapsOuterTop', 'gapsOuterBottom', 'gapsOuterLeft', 'gapsOuterRight', 'gapsInnerHorizontal',
                'gapsInnerVertical'):
        kw('kwinrc', 'Script-karousel', key, gap)
    kw('kwinrc', 'Script-karousel', 'presetWidths', ', '.join(ajustes.WIDTHS[w] for w in car['anchos']))
    kw('kwinrc', 'Script-karousel', 'tiledDesktops', '^(' + '|'.join(names) + ')$' if on else '^$')
    kw('kwinrc', 'Plugins', 'karouselEnabled', 'true' if on else 'false')
    if reload:  # (Karousel lee su configuración al cargar: fuera y dentro otra vez)
        try:
            dbus.SessionBus().get_object('org.kde.KWin', '/Scripting').unloadScript(
                'karousel', dbus_interface='org.kde.kwin.Scripting')
        except dbus.DBusException as e:
            log('carrusel:', e.get_dbus_message())
    kwin_reconfigure()
    log('carrusel:', ', '.join(names) or 'apagado')


def zone_location():
    """(latitud, longitud) de tu zona horaria (la ciudad de zone1970.tab: para el anochecer basta). Madrid si no se sabe."""
    try:
        zone = os.path.realpath('/etc/localtime').split('/zoneinfo/', 1)[1]
        with open('/usr/share/zoneinfo/zone1970.tab') as f:
            for line in f:
                cols = line.split('\t')
                if line.startswith('#') or len(cols) < 3 or cols[2].strip() != zone:
                    continue
                c = cols[1]
                cut = max(c.rfind('+'), c.rfind('-'))
                return dms(c[:cut]), dms(c[cut:])
    except (OSError, IndexError, ValueError):
        pass
    return 40.4, -3.7


def dms(text):
    """«+4024» o «-00341» (grados y minutos, y a veces segundos) → grados."""
    sign, d = (-1 if text[0] == '-' else 1), text[1:]
    deg_len = 2 if len(d) in (4, 6) else 3
    deg, rest = int(d[:deg_len]), d[deg_len:]
    mins, secs = int(rest[:2]), int(rest[2:4] or 0)
    return sign * (deg + mins / 60 + secs / 3600)


class Missed:
    """Los avisos que llegan mientras no salen (en Jugar y Estudiar, o con «No molestar»). Se escuchan en el bus (como
    dbus-monitor, sin quitárselos a Plasma, que los guarda en su historial) y, al volver a un piso con avisos, si llegó
    alguno, apogeo-resumen enseña el resumen encima de la isla."""
    RESUMEN = '/usr/lib/apogeo/apogeo-resumen'

    def __init__(self, bus):
        self.since = None        # desde cuándo no salen
        self.floors = []         # los pisos en los que has estado mientras tanto
        self.items = []
        try:
            self.mon = dbus.bus.BusConnection(dbus.bus.BUS_SESSION)
            self.mon.call_blocking('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus.Monitoring',
                                   'BecomeMonitor', 'asu',
                                   (["type='method_call',interface='org.freedesktop.Notifications',member='Notify'"], 0))
            self.mon.add_message_filter(self.heard)
        except dbus.DBusException as e:
            log('resumen:', e.get_dbus_message())

    def start(self, floor):
        if self.since is None:
            self.since = time.time()
            self.floors, self.items = [], []
        if floor not in self.floors:
            self.floors.append(floor)

    def heard(self, _conn, msg):
        try:
            if self.since is None or msg.get_member() != 'Notify':
                return
            app, _rid, icon, title, body, _actions, hints, _timeout = msg.get_args_list()[:8]
            if hints.get('transient') or not (str(title).strip() or str(body).strip()):
                return
            self.items.append({
                'app': str(app), 'icono': str(icon or hints.get('image-path', '') or ''), 'titulo': str(title)[:140],
                'texto': ' '.join(str(body).split())[:240], 'hora': time.strftime('%H:%M'),
                'urgencia': int(hints.get('urgency', 1)), 'desktop': str(hints.get('desktop-entry', '')),
            })
            del self.items[:-200]
        except Exception as e:  # un aviso raro no tumba los pisos
            log('resumen:', e)

    def finish(self):
        if self.since is None:
            return
        since, floors, items = self.since, self.floors, self.items
        self.since, self.floors, self.items = None, [], []
        if not items or not os.access(self.RESUMEN, os.X_OK):
            return
        data = {'pisos': floors, 'segundos': int(time.time() - since), 'avisos': items}
        with tempfile.NamedTemporaryFile('w', suffix='.json', prefix='apogeo-resumen-', delete=False,
                                         dir=os.environ.get('XDG_RUNTIME_DIR')) as f:
            json.dump(data, f, ensure_ascii=False)
        log('resumen:', len(items), 'avisos')
        subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                          f'--unit=app-apogeo-resumen-{int(time.time())}', self.RESUMEN, f.name],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


class Floors:
    def __init__(self, bus, system, modos=None):
        self.bus = bus
        self.system = system
        self.modos = modos
        self.cookie = None
        self.light_on = None       # la luz nocturna de KWin encendida (solo en Estudiar)
        self.light_conf = None     # el calor que se escribió en kwinrc (para no reescribirlo en cada piso)
        self.missed = Missed(bus)  # los avisos que llegan mientras no salen (para el resumen al volver)
        if modos:
            modos.missed = self.missed
        self.visited = set()
        self.last = None
        self.rotate_timer = None   # «que cambie solo»: el temporizador del piso en el que estás
        self.shown = {}            # piso → el fondo que se ve ahora (el elegido o el de «que cambie solo»)
        self.wall_written = {}     # piso → lo último que se escribió de su fondo (para no reescribirlo)
        self.lock_written = None   # lo último que se escribió para la pantalla de bloqueo
        self.chosen = {}           # piso → el que elegiste a mano (si cambia, se ve ese aunque cambie solo)
        self.colours_timer = None  # los colores del piso (Aspecto «Del fondo»): al acabar el cambio de piso

    def apply(self, index, force=False):
        if index == self.last and not force:
            return
        self.last = index
        f = FLOORS[min(index, len(FLOORS) - 1)]
        st = ajustes.load()
        mine = st['pisos'][f['key']]
        log('piso', f['name'])
        if self.modos:
            self.modos.publish(index)
        else:
            write_mode(index)
        self.wallpaper(self.pick_wallpaper(st, f['key'], entering=not force), st['animar'], f['key'])
        self.schedule_rotation(st, f['key'])
        self.quiet(st['silencio'] or not mine['avisos'], f['key'])
        self.light(st, f['key'])
        self.power(mine['energia'])
        self.colours_later()
        if force:
            return
        if index not in self.visited:
            # Solo si se queda en el piso: pasar de largo con la rueda no abre nada (y la ventana, al aparecer tarde,
            # le devolvería a este piso)
            GLib.timeout_add(1500, self.first_visit, index)
        elif FLOORS[index]['key'] == 'jugar':
            GLib.timeout_add(800, self.wake_console, index)

    def wake_console(self, index):
        """La consola se cierra sola tras media hora sin usarla fuera de Jugar (devuelve su memoria): al volver a Jugar,
        se abre otra vez."""
        try:
            running = self.bus.name_has_owner('org.apogeo.Consola')
        except dbus.DBusException:
            running = True
        if self.last == index and not running and 'apogeo-consola.desktop' in ajustes.load()['pisos']['jugar']['apps']:
            self.open_apps(['apogeo-consola.desktop'])
        return False

    def first_visit(self, index):
        if self.last == index and welcome_open():
            return True  # con la bienvenida delante no se abre nada (Ágape, por ejemplo, lo instala ella): luego
        if self.last == index and index not in self.visited:
            self.visited.add(index)
            self.open_apps(ajustes.load()['pisos'][FLOORS[index]['key']]['apps'])
        return False

    def settings_changed(self):
        """Has cambiado algo en los ajustes: el piso en el que estás, la isla y tu aspecto, ya."""
        self.apply(self.last if self.last is not None else current_index(self.bus), force=True)
        st = ajustes.load()
        island(self.bus, st)
        self.look(st)
        fluid_screen(st)
        carousel(st)

    # ----- Los colores (Ajustes → Aspecto) -----

    def floor_key(self):
        return FLOORS[min(self.last or 0, len(FLOORS) - 1)]['key'] if self.last is not None else 'navegar'

    def look(self, st=None, force=False):
        """Tu aspecto en todo el sistema (si ha cambiado), con los colores del piso en el que estás."""
        apply_look(st or ajustes.load(), self.floor_key(), dict(self.shown), force=force)

    def colours_later(self):
        """Con «Del fondo», los colores del piso al que llegas (o del fondo nuevo): un momento después, cuando ya ha
        acabado la animación del cambio (y si pasas de largo con la rueda, solo los del piso en el que te quedas)."""
        if self.colours_timer:
            GLib.source_remove(self.colours_timer)
        self.colours_timer = GLib.timeout_add(900, self._colours)

    def _colours(self):
        self.colours_timer = None
        switch_look(ajustes.load(), self.floor_key(), dict(self.shown))
        return False

    # ----- «Que cambie solo» -----

    def pick_wallpaper(self, st, floor, entering=False, advance=False):
        """El fondo que toca en el piso: el que elegiste o, con «que cambie solo», el siguiente de la lista (al entrar en
        el piso, si es «al entrar», o cuando pasa el tiempo)."""
        rot = st['fondos']['cambiar'][floor]
        chosen = st['pisos'][floor]['fondo']
        if not rot['activo'] or self.chosen.get(floor, chosen) != chosen:
            # Sin «que cambie solo», o acabas de elegir uno a mano: se ve ese
            self.chosen[floor] = chosen
            self.shown[floor] = chosen
            return chosen
        self.chosen[floor] = chosen
        if advance or (entering and rot['cada'] == 'piso') or floor not in self.shown:
            pool = ajustes.rotation_pool(st, floor)
            state = load_state()
            idx = state.setdefault('rotacion', {}).get(floor, -1)
            if advance or (entering and rot['cada'] == 'piso'):
                idx += 1
            idx = max(0, idx) % len(pool)
            state['rotacion'][floor] = idx
            save_state(state)
            self.shown[floor] = pool[idx]
        return self.shown[floor]

    def schedule_rotation(self, st, floor):
        if self.rotate_timer:
            GLib.source_remove(self.rotate_timer)
            self.rotate_timer = None
        rot = st['fondos']['cambiar'][floor]
        every = ajustes.EVERY[rot['cada']]
        if rot['activo'] and every:
            self.rotate_timer = GLib.timeout_add_seconds(every, self.rotate, floor)

    def rotate(self, floor):
        if self.last is None or FLOORS[self.last]['key'] != floor:
            self.rotate_timer = None
            return False
        st = ajustes.load()
        if not st['fondos']['cambiar'][floor]['activo']:
            self.rotate_timer = None
            return False
        self.wallpaper(self.pick_wallpaper(st, floor, advance=True), st['animar'], floor)
        self.colours_later()
        return True

    def wallpaper(self, style, animate, floor):
        """El fondo del piso (org.apogeo.fondo). Cada piso tiene el suyo en la configuración del fondo (EstiloJugar,
        ArchivoJugar…) y el fondo elige solo según el piso en el que estás: aquí solo se escribe cuando cambia (elegir
        otro, «que cambie solo»…), no en cada cambio de piso (eso daba tirones). Sin gráfica de verdad, quieto (lo
        dibujaría el procesador), y también si lo apagas en los ajustes. La pantalla de bloqueo, que no sabe en qué piso
        estás, recibe el del piso actual (sin esperar)."""
        animate = 'true' if animate and real_gpu() else 'false'
        # Un fondo animado de Apogeo o una imagen o un vídeo tuyo (Archivo)
        if style in ajustes.STYLES:
            archivo = ''
        else:
            archivo, style = style, 'tinta'
        lock = (style, animate, floor, archivo)
        if lock != self.lock_written:
            self.lock_written = lock

            def write_lock():
                run('kwriteconfig6', '--file', 'kscreenlockerrc', '--group', 'Greeter', '--key', 'WallpaperPlugin',
                    'org.apogeo.fondo')
                for key, value in (('Estilo', style), ('Animar', animate), ('Piso', floor), ('Archivo', archivo)):
                    run('kwriteconfig6', '--file', 'kscreenlockerrc', '--group', 'Greeter', '--group', 'Wallpaper',
                        '--group', 'org.apogeo.fondo', '--group', 'General', '--key', key, '--', value)
            threading.Thread(target=write_lock, daemon=True).start()
        want = (style, archivo, animate)
        if self.wall_written.get(floor) == want:
            return
        self.wall_written[floor] = want
        cap = floor.capitalize()
        plasma_script(self.bus, """
            desktops().forEach(function (d) {
                d.wallpaperPlugin = 'org.apogeo.fondo';
                d.currentConfigGroup = ['Wallpaper', 'org.apogeo.fondo', 'General'];
                d.writeConfig('PorPiso', true);
                d.writeConfig('Estilo%s', %s);
                d.writeConfig('Archivo%s', %s);
                d.writeConfig('Animar', %s);
            });
        """ % (cap, json.dumps(style), cap, json.dumps(archivo), animate))

    def prepare_wallpapers(self):
        """Al empezar: el fondo de los tres pisos (así el primer cambio a cada uno ya no escribe nada)."""
        st = ajustes.load()
        for f in FLOORS:
            if self.last is not None and FLOORS[self.last]['key'] == f['key']:
                continue
            self.wallpaper(self.pick_wallpaper(st, f['key']), st['animar'], f['key'])
        return False

    def quiet(self, on, floor):
        """No molestar mientras se esté en el piso: lo que llegue se queda en el historial de avisos y, al volver a un
        piso con avisos, sale el resumen de lo que llegó."""
        if on:
            self.missed.start(floor)
        try:
            n = dbus.Interface(self.bus.get_object('org.freedesktop.Notifications', '/org/freedesktop/Notifications'),
                               'org.freedesktop.Notifications')
            if on and self.cookie is None:
                self.cookie = n.Inhibit('apogeo-pisos', 'Piso sin avisos', dbus.Dictionary({}, signature='sv'))
            elif not on and self.cookie is not None:
                n.UnInhibit(self.cookie)
                self.cookie = None
        except dbus.DBusException as e:
            log('avisos:', e.get_dbus_message())
        if not on:
            self.missed.finish()

    def light(self, st, floor):
        """Luz cálida en Estudiar por la noche: la luz nocturna de KWin (sigue el día y la noche de tu zona: al anochecer
        entra poco a poco y al amanecer se va), encendida solo en Estudiar. Se enciende y se apaga con su ajuste (no
        suspendiéndola: eso saca el aviso «Luz nocturna suspendida» al cambiar de piso). Si Plasma no sabe dónde estás, tu
        zona sale de tu zona horaria (sin preguntar a internet)."""
        luz = st['luz']
        if luz['activa'] and self.light_conf != luz['calor']:
            self.light_conf = luz['calor']
            lat = run_out('kreadconfig6', '--file', 'knighttimerc', '--group', 'Location', '--key', 'Latitude')
            auto = run_out('kreadconfig6', '--file', 'knighttimerc', '--group', 'Location', '--key', 'Automatic')
            if not lat and auto != 'false':
                lat, lon = zone_location()
                kwn('knighttimerc', 'Location', 'Automatic', 'false')
                kwn('knighttimerc', 'Location', 'Latitude', f'{lat:.2f}')
                kwn('knighttimerc', 'Location', 'Longitude', f'{lon:.2f}')
            kwn('kwinrc', 'NightColor', 'NightTemperature', str(luz['calor']))
        on = luz['activa'] and floor == 'estudiar'
        if on != self.light_on:
            self.light_on = on
            kwn('kwinrc', 'NightColor', 'Active', 'true' if on else 'false')

    def power(self, profile):
        try:
            pp = self.system.get_object('org.freedesktop.UPower.PowerProfiles', '/org/freedesktop/UPower/PowerProfiles')
            pp.Set('org.freedesktop.UPower.PowerProfiles', 'ActiveProfile', profile,
                   dbus_interface='org.freedesktop.DBus.Properties')
        except dbus.DBusException as e:
            log('energía:', e.get_dbus_message())

    def open_apps(self, app_ids):
        for app_id in app_ids:
            info = ajustes.app_info(app_id)
            if not info:
                continue  # ya no está instalada
            exe = os.path.basename(info[2].strip('"'))
            if exe and subprocess.run(['pgrep', '-x', exe], stdout=subprocess.DEVNULL).returncode == 0:
                continue  # ya está abierta (en este u otro piso)
            log('abriendo', app_id)
            path = ajustes.desktop_info(app_id).get_filename()
            # En su propio grupo de systemd (como si la abrieras tú): si este programa se reinicia, la app sigue abierta
            subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                              f'--unit=app-apogeo-{exe or "app"}-{os.getpid()}-{len(self.visited)}', 'gio', 'launch', path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                             env=dict(os.environ, APOGEO_AUTO='1', APOGEO_MODO=self.floor_key()))  # (la abre el piso, no tú)


def island(bus, st):
    """La isla como en los ajustes: si se esconde sola, lo de cada piso (temperatura y FPS, música, temporizador) y los
    números de la salud del PC que enseña en Jugar."""
    cfg = st['isla']
    # Dónde va y su tamaño (Ajustes → Aspecto): la isla abajo o arriba
    t = aspecto.tokens(aspecto.settings_of(st))
    top = t['posicion'] == 'arriba-dcha'
    # Se aparta de las ventanas (o no, si lo quitas en los ajustes): con el escritorio a la vista se ve («C · Orbe
    # central»); el script de KWin «apogeo-bordes» la saca al acercar el ratón a una franja ancha del borde, y tiene que
    # saber si lo hace (y en qué borde está)
    kw('kwinrc', 'Script-apogeo-bordes', 'isla', 'true' if cfg['esconder'] else 'false')
    kw('kwinrc', 'Script-apogeo-bordes', 'islaArriba', 'true' if top else 'false')
    kwin_reconfigure()
    plasma_script(bus, """
        panels().forEach(function (p) {
            var types = p.widgets().map(function (w) { return w.type; });
            if (types.indexOf('org.apogeo.modo') >= 0) {   // la barra fina, en el borde contrario al de la isla
                if (p.location != %s) p.location = %s;
                return;
            }
            if (types.indexOf('org.apogeo.isla') < 0) return;
            if (p.location != %s) p.location = %s;
            if (p.height != %d) p.height = %d;
            p.hiding = %s;
            p.widgets().forEach(function (w) {
                if (w.type != 'org.apogeo.isla') return;
                w.currentConfigGroup = ['General'];
                w.writeConfig('extraJugar', %s);
                w.writeConfig('extraNavegar', %s);
                w.writeConfig('extraEstudiar', %s);
                w.writeConfig('fps', %d);
                w.writeConfig('limite', %d);
                w.reloadConfig();
            });
        });
    """ % (json.dumps('bottom' if top else 'top'), json.dumps('bottom' if top else 'top'),
           json.dumps('top' if top else 'bottom'), json.dumps('top' if top else 'bottom'), t['isla'], t['isla'],
           json.dumps('dodgewindows' if cfg['esconder'] else 'none'),
           json.dumps(cfg['jugar']), json.dumps(cfg['navegar']),
           json.dumps(cfg['estudiar']), st['fps'], ajustes.health()['limite']))


_look = {'ultimo': None, 'cerrojo': threading.Lock()}


def apply_look(st, floor, shown, force=False):
    """Ajustes → Aspecto: solo si ha cambiado (genera temas y los pone: tarda un poco) y en segundo plano. Con «según la
    hora», también al pasar de día a noche (lo mira el reloj cada 10 minutos). Con «Del fondo», cuentan los colores de
    los tres pisos (sacarlos de un fondo nuevo también tarda: por eso todo va en segundo plano y de uno en uno)."""
    def work():
        with _look['cerrojo']:
            _t, per = aspecto.all_tokens(st, floor, shown)
            want = json.dumps(per, sort_keys=True)
            if not force and want == _look['ultimo']:
                return
            _look['ultimo'] = want
            aspecto.apply(st, floor, shown, log=log)
    threading.Thread(target=work, daemon=True).start()


def switch_look(st, floor, shown):
    """Los colores del piso en el que estás (cambio de piso o de fondo), en segundo plano."""
    def work():
        with _look['cerrojo']:
            aspecto.switch(st, floor, shown, log=log)
    threading.Thread(target=work, daemon=True).start()


def light_effects():
    """Sin gráfica de verdad (una máquina virtual sin 3D), KWin lo dibuja todo con el procesador y el desenfoque del
    cristal (la isla, los menús, los avisos) lo deja al límite: cambiar de piso iba a tirones. Ahí se quita el desenfoque
    (y el contraste que va con él); con gráfica, el cristal se queda. Se mira al entrar en cada sesión."""
    want = 'true' if real_gpu() else 'false'
    changed = False
    for effect in ('blur', 'contrast'):
        if run_out('kreadconfig6', '--file', 'kwinrc', '--group', 'Plugins', '--key', f'{effect}Enabled') != want:
            kw('kwinrc', 'Plugins', f'{effect}Enabled', want)
            changed = True
    if changed:
        log('efectos:', 'cristal' if want == 'true' else 'sin desenfoque (no hay gráfica de verdad)')
        kwin_reconfigure()


def fluid_screen(st):
    """«Pantalla fluida» (Ajustes → Salud del PC): con ella, la pantalla va al ritmo del juego cuando juegas a pantalla
    completa (menos tirones y sin cortes de imagen); sin ella, a su ritmo fijo de siempre."""
    on = st.get('pantallaFluida', True)
    for name, policy in ajustes.vrr_outputs().items():
        if on != (policy != 'never'):
            run('kscreen-doctor', f'output.{name}.vrrpolicy.' + ('automatic' if on else 'never'))
            log('pantalla fluida:', name, 'sí' if on else 'no')


def welcome_open():
    return subprocess.run(['pgrep', '-f', WELCOME], stdout=subprocess.DEVNULL).returncode == 0


def welcome():
    """La bienvenida, hasta que se termine (o se pulse «No volver a mostrar»)."""
    if os.path.exists(WELCOME_DONE) or welcome_open() or not os.access(WELCOME, os.X_OK):
        return
    log('bienvenida')
    subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                      f'--unit=app-apogeo-bienvenida-{os.getpid()}', WELCOME, '--auto'],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def real_gpu():
    """¿Hay una gráfica que dibuje el fondo animado? En una máquina virtual sin 3D lo dibujaría el procesador."""
    for card in glob.glob('/sys/class/drm/card[0-9]/device/driver'):
        if os.path.basename(os.path.realpath(card)) in ('amdgpu', 'radeon', 'i915', 'xe', 'nouveau', 'nvidia'):
            return True
    return False


def start_floor():
    """El piso elegido en la pantalla de inicio de sesión (lo apunta apogeo-sesion); si no, Navegar. Se borra al leerlo:
    si este programa se reinicia a media sesión, no te cambia de piso."""
    path = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'apogeo-piso')
    try:
        with open(path) as f:
            key = f.read().strip()
        os.remove(path)
    except OSError:
        return 1
    return next((k for k, f in enumerate(FLOORS) if f['key'] == key), 1)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == 'ir' and len(sys.argv) > 2:
            go(bus, int(sys.argv[2]))
        elif cmd in ('subir', 'bajar'):
            go(bus, current_index(bus) + (-1 if cmd == 'subir' else 1))
        elif cmd == 'url' and len(sys.argv) > 2 and sys.argv[2].partition(':')[2].strip('/').isdigit():
            go(bus, int(sys.argv[2].partition(':')[2].strip('/')))
        return
    setup(bus)
    st = load_state()
    obsidian_notes(st)
    save_state(st)
    light_effects()
    fluid_screen(ajustes.load())
    carousel(ajustes.load())
    import apogeo_datos
    datos = apogeo_datos.Datos(bus)  # noqa: F841 (los datos de los widgets: el tiempo, el estudio… por D-Bus)
    global _modos
    try:
        _modos = Modos(bus, dbus.service.BusName('org.apogeo.Modos', bus))
        log('modos: org.apogeo.Modos1')
    except dbus.DBusException as e:
        log('modos:', e.get_dbus_message())
    floors = Floors(bus, dbus.SystemBus(), _modos)
    bus.add_signal_receiver(lambda _id: floors.apply(current_index(bus)), signal_name='currentChanged',
                            dbus_interface='org.kde.KWin.VirtualDesktopManager', path='/VirtualDesktopManager')
    go(bus, start_floor())
    # Jugar es la consola («full modo consola»): si se cierra estando en Jugar, vuelve (si se cerrara sola nada más
    # abrirse, como mucho 3 veces por minuto)
    reopened = []

    def console_gone(name, old, new):
        if name != 'org.apogeo.Consola' or not old or new or floors.last is None or FLOORS[floors.last]['key'] != 'jugar':
            return
        now = time.time()
        reopened[:] = [t for t in reopened if now - t < 60] + [now]
        if len(reopened) <= 3:
            GLib.timeout_add(1500, floors.wake_console, floors.last)
    bus.add_signal_receiver(console_gone, 'NameOwnerChanged', 'org.freedesktop.DBus', path='/org/freedesktop/DBus')
    # El buscador, preparado (para que la lupa de la isla y la tecla Meta lo saquen al momento), y la música de abajo a
    # la izquierda (sale sola cuando suena algo)
    for name, args in (('buscador', ['--fondo']), ('musica', [])):
        subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                          f'--unit=app-apogeo-{name}-{os.getpid()}', f'/usr/lib/apogeo/apogeo-{name}', *args],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    welcome()
    # Tu aspecto (Ajustes → Aspecto) y, con «según la hora», el cambio de claro a oscuro (se mira cada 10 minutos)
    floors.apply(current_index(bus))
    floors.look()
    GLib.timeout_add_seconds(600, lambda: (floors.look(), True)[-1])
    GLib.timeout_add_seconds(3, floors.prepare_wallpapers)
    GLib.timeout_add_seconds(6, lambda: desktop_fill(bus))
    # Los ajustes: al guardarlos (de golpe, con un archivo nuevo) se aplican
    monitor = Gio.File.new_for_path(os.path.dirname(ajustes.SETTINGS)).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES,
                                                                                          None)
    pending = {'id': None}

    def changed(_m, f, other, _event):
        names = {x.get_basename() for x in (f, other) if x}
        if os.path.basename(ajustes.SETTINGS) not in names:
            return
        if pending['id']:
            GLib.source_remove(pending['id'])
        pending['id'] = GLib.timeout_add(250, lambda: (pending.update(id=None), floors.settings_changed(), False)[-1])
    os.makedirs(os.path.dirname(ajustes.SETTINGS), exist_ok=True)
    monitor.connect('changed', changed)
    # «Como Ágape»: cuando Ágape guarda sus ajustes (cambias su aspecto en Personalizar), Apogeo lo sigue (solo hace
    # algo si lo de su aspecto ha cambiado)
    os.makedirs(os.path.dirname(aspecto.AGAPE), exist_ok=True)
    agape_monitor = Gio.File.new_for_path(os.path.dirname(aspecto.AGAPE)).monitor_directory(
        Gio.FileMonitorFlags.WATCH_MOVES, None)
    agape_pending = {'id': None}

    def agape_changed(_m, f, other, _event):
        if os.path.basename(aspecto.AGAPE) not in {x.get_basename() for x in (f, other) if x}:
            return
        if agape_pending['id']:
            GLib.source_remove(agape_pending['id'])
        agape_pending['id'] = GLib.timeout_add(1500, lambda: (agape_pending.update(id=None),
                                                              floors.look(), False)[-1])
    agape_monitor.connect('changed', agape_changed)
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
