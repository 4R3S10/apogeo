#!/bin/sh
# Fuera del menú y del buscador lo que no pinta nada en Apogeo: las apps de CachyOS (si no las ha quitado ya
# apogeo-limpieza) y las piezas de otros programas que no son apps (herramientas de Qt, de Avahi, de cámaras…). Siguen
# instaladas: se abren con su nombre desde una terminal. Lo lanza un gancho de pacman: si una actualización las vuelve
# a poner, se vuelven a esconder.
set -e
for f in cachyos-hello cachyos-pi org.cachyos.KernelManager org.cachyos.scx-manager arch-update arch-update-tray \
         avahi-discover bssh bvnc assistant designer linguist qdbusviewer qv4l2 qvidcap lstopo kvantummanager \
         org.kde.kwrite org.kde.kdeconnect.nonplasma org.kde.kdeconnect.sms; do
  p="/usr/share/applications/$f.desktop"
  [ -f "$p" ] || continue
  grep -q '^NoDisplay=true' "$p" && continue
  if grep -q '^NoDisplay=' "$p"; then
    sed -i 's/^NoDisplay=.*/NoDisplay=true/' "$p"
  else
    sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' "$p"
  fi
done
