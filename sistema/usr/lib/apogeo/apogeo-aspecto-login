#!/usr/bin/python3
"""
Tu aspecto también en la pantalla de inicio de sesión (SDDM): esa pantalla sale antes de entrar y no puede leer tus
ajustes, así que Apogeo le deja una copia de tus colores en /var/lib/apogeo/aspecto-login.json (solo colores, la letra,
las esquinas y, por piso, sus colores y qué fondo animado de Apogeo lleva, comprobados; nada más). Lo llama apogeo_aspecto
al aplicar tu aspecto y cuando cambian los colores de un piso.

  pkexec apogeo-aspecto-login     (lee de la entrada las fichas de tu aspecto)
"""
import json
import os
import re
import sys

OUT = '/var/lib/apogeo/aspecto-login.json'
HEX = re.compile(r'^#[0-9a-fA-F]{6}$')


FLOORS = ('jugar', 'navegar', 'estudiar')


def colors(t):
    out = {}
    for k in ('fondo', 'superficie', 'texto', 'acento', 'sobreAcento', 'vivo'):
        if HEX.match(str(t.get(k, ''))):
            out[k] = t[k].lower()
    wp = t.get('wp')
    if isinstance(wp, list) and len(wp) == 3 and all(HEX.match(str(c)) for c in wp):
        out['wp'] = [c.lower() for c in wp]
    return out


def main():
    if os.geteuid() != 0:
        return 2
    try:
        t = json.loads(sys.stdin.read(20000))
    except ValueError:
        return 1
    out = colors(t)
    pisos = t.get('pisos') if isinstance(t.get('pisos'), dict) else {}
    out['pisos'] = {}
    for k in FLOORS:
        x = pisos.get(k) if isinstance(pisos.get(k), dict) else {}
        style = x.get('estilo', -1)
        out['pisos'][k] = dict(colors(x), estilo=style if isinstance(style, int) and 0 <= style < 11 else -1)
    font = str(t.get('letra', ''))
    if re.fullmatch(r"[\w .'-]{1,40}", font):
        out['letra'] = font
    try:
        out['radio'] = max(0.2, min(2.0, float(t.get('radio', 1))))
    except (TypeError, ValueError):
        pass
    out['claro'] = bool(t.get('claro'))
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = OUT + '.nuevo'
    with open(tmp, 'w') as f:
        json.dump(out, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)
    return 0


if __name__ == '__main__':
    sys.exit(main())
