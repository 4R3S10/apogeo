#!/usr/bin/python3
"""
La Órbita abierta («C · Orbe central»; sustituye al buscador): al pulsar el orbe o Meta, arriba la paleta y, debajo, a la
izquierda tus apps del modo (las que fijas tú: ~/.config/apogeo/fijadas.json; «Todas» con todas por tipo) y a la
derecha el inspector (lo que suena, los avisos de tus apps, lo que se baja y lo próximo de tu calendario). En cuanto
escribes: arriba la cuenta si es una («15% de 80», «10 € en dólares»: apogeo_calculo), las órdenes (los modos, apagar,
reiniciar, bloquear, ajustes…), lo que encuentran los buscadores de KDE (apps, ajustes…) agrupado, tus archivos por su
nombre (el índice ligero de apogeo-archivos) y al final «Buscar en la web con Ágape». Todo con el teclado: flechas
elegir, Intro abrir, Esc cerrar. Se queda preparado en segundo plano (lo arranca apogeo-pisos al entrar, o D-Bus la
primera vez) para salir al momento.

También la guía de atajos («G1 + G3», Atajos.qml): todos los de Apogeo y, arriba, los del piso en el que estás. Sale
mientras mantienes Meta (lo avisa apogeo-meta por el bus del sistema; al soltar se va y Meta no abre el buscador) o con
Meta+/ (entonces Esc o un clic la cierran).

  apogeo-buscador           lo enseña (o lo esconde, si ya se ve)
  apogeo-buscador --fondo   lo deja preparado, sin enseñarlo
  apogeo-buscador --atajos  la guía de atajos
D-Bus: org.apogeo.Buscador /Buscador org.apogeo.Buscador.Toggle (la tecla Meta), .AbrirDesde(«x,y,…») (el orbe de la isla:
dónde está él y sus bolitas, para salir de él), .Orbe(«x,y,…») (solo dónde está) y .Atajos (Meta+/: apogeo-atajos.desktop)
"""
import json
import os
import subprocess
import time
import sys

SERVICE, PATH, IFACE = 'org.apogeo.Buscador', '/Buscador', 'org.apogeo.Buscador'
QML = os.environ.get('APOGEO_BUSCADOR_QML', '/usr/share/apogeo/buscador/Buscador.qml')
ATAJOS_QML = os.path.join(os.path.dirname(QML), 'Atajos.qml')
MODO = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'apogeo', 'modo.json')
sys.path.insert(0, os.environ.get('APOGEO_LIB', '/usr/lib/apogeo'))

# Los grupos del cajón, en orden. Una app va al primero que encaje: primero por su nombre (las de Apogeo), luego por sus
# categorías (las del .desktop)
GROUPS = [
    ('Jugar', {'steam.desktop', 'com.heroicgameslauncher.hgl.desktop', 'discord.desktop',
               'apogeo-consola.desktop', 'hydralauncher.desktop', 'com.vysp3r.ProtonPlus.desktop'}, {'Game'}),
    ('Estudiar', {'obsidian.desktop', 'org.kde.okular.desktop', 'com.github.xournalpp.xournalpp.desktop', 'anki.desktop'},
     {'Education', 'Office', 'Science', 'Dictionary'}),
    ('Internet y chat', {'ares.desktop'}, {'Network', 'WebBrowser', 'Email', 'Chat', 'InstantMessaging'}),
    ('Ver y crear', set(), {'AudioVideo', 'Audio', 'Video', 'Graphics', 'Photography', 'Music'}),
    ('Sistema', set(), set()),  # (lo demás)
]


def grouped_apps():
    """[{grupo, apps: [{id, nombre, icono}]}] con las apps del menú."""
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio
    out = {g[0]: [] for g in GROUPS}
    for info in Gio.AppInfo.get_all():
        if not info.should_show() or not info.get_id():
            continue
        did = info.get_id()
        cats = set((info.get_categories() or '').split(';')) if hasattr(info, 'get_categories') else set()
        group = next((name for name, ids, wanted in GROUPS if did in ids), None) or \
            next((name for name, ids, wanted in GROUPS if cats & wanted), 'Sistema')
        icon = info.get_icon()
        out[group].append({'id': did, 'nombre': info.get_name(), 'icono': icon.to_string() if icon else 'application-x-executable'})
    return [{'grupo': g, 'apps': sorted(a, key=lambda x: x['nombre'].lower())} for g, a in out.items() if a]


# ---------- Tus apps de cada modo (las de la Órbita abierta) ----------

PINS = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'apogeo', 'fijadas.json')
# De serie: Estudiar con lo de estudiar, Ágape y Spotify; Navegar vacío (pones las que quieras); Jugar no tiene orbe
PINS_DEFAULT = {
    'navegar': [],
    'estudiar': ['obsidian.desktop', 'org.kde.okular.desktop', 'com.github.xournalpp.xournalpp.desktop', 'anki.desktop',
                 'org.onlyoffice.desktopeditors.desktop', 'ares.desktop', 'spotify-launcher.desktop'],
    'jugar': [],
}


def load_pins():
    try:
        with open(PINS) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    return {k: [str(x) for x in data.get(k, v)] if isinstance(data.get(k, v), list) else list(v)
            for k, v in PINS_DEFAULT.items()}


def save_pins(pins):
    os.makedirs(os.path.dirname(PINS), exist_ok=True)
    tmp = PINS + '.nuevo'
    with open(tmp, 'w') as f:
        json.dump(pins, f, ensure_ascii=False, indent=1)
    os.replace(tmp, PINS)


def app_info(desktop_id):
    """{id, nombre, icono} de una app instalada (None si no está)."""
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio
    try:
        info = Gio.DesktopAppInfo.new(desktop_id)
    except TypeError:
        info = None
    if not info:
        return None
    icon = info.get_icon()
    return {'id': desktop_id, 'nombre': info.get_name(), 'icono': icon.to_string() if icon else 'application-x-executable'}


# ---------- Las órdenes de la paleta ----------

def plain(text):
    import unicodedata
    return ''.join(c for c in unicodedata.normalize('NFD', text.lower()) if unicodedata.category(c) != 'Mn').strip()


# (id, nombre, lo que hace, icono de Apogeo, palabras con las que sale)
COMMANDS = [
    ('modo:jugar', 'Jugar', 'Ir al modo Jugar (la consola)', 'jugar', 'jugar juegos consola modo'),
    ('modo:navegar', 'Navegar', 'Ir al modo Navegar', 'navegar', 'navegar internet web modo'),
    ('modo:estudiar', 'Estudiar', 'Ir al modo Estudiar', 'estudiar', 'estudiar estudio apuntes modo'),
    ('apagar', 'Apagar', 'Apagar el PC (te pregunta antes)', 'apagar', 'apagar apaga shutdown'),
    ('reiniciar', 'Reiniciar', 'Reiniciar el PC (te pregunta antes)', 'actualizar', 'reiniciar reinicia reboot'),
    ('suspender', 'Suspender', 'Dormir el PC: vuelve al momento', 'luna', 'suspender dormir suspend'),
    ('bloquear', 'Bloquear', 'Bloquear la pantalla', 'llave', 'bloquear bloquea lock'),
    ('sesion', 'Cerrar sesión', 'Salir de tu sesión (te pregunta antes)', 'salir', 'cerrar sesion salir logout'),
    ('ajustes', 'Ajustes de Apogeo', 'Abrir los ajustes', 'ajustes', 'ajustes configuracion opciones'),
    ('atajos', 'Atajos', 'La guía de atajos de teclado', 'texto', 'atajos teclado teclas'),
]


def find_commands(text):
    q = plain(text)
    if len(q) < 2:
        return []
    out = []
    for cid, name, what, icon, words in COMMANDS:
        if any(w.startswith(q) for w in words.split()) or plain(name).startswith(q):
            out.append({'id': cid, 'nombre': name, 'detalle': what, 'icono': icon})
    return out[:4]


ARCHIVOS = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')), 'apogeo', 'archivos.db')


def find_files(text, limit=8):
    """Tus archivos y carpetas cuyo nombre lleva todas las palabras, los que empiezan así y los más recientes primero."""
    import subprocess
    words = text.lower().split()
    if not words or len(text) < 2 or not os.path.exists(ARCHIVOS):
        return []
    try:
        out = subprocess.run(['plocate', '-d', ARCHIVOS, '-i', '-l', '400', '--', max(words, key=len)],
                             capture_output=True, text=True, timeout=3).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return []
    home = os.path.expanduser('~')
    found = []
    for path in out:
        name = os.path.basename(path)
        low = name.lower()
        if path == home or not all(w in low for w in words) or '/.' in path[len(home):]:
            continue
        try:
            st = os.stat(path)
        except OSError:
            continue  # (ya no está)
        found.append((not low.startswith(words[0]), -st.st_mtime, path, name))
    found.sort()
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio
    result = []
    for _a, _b, path, name in found[:limit]:
        folder = os.path.isdir(path)
        kind = 'inode/directory' if folder else Gio.content_type_guess(name, None)[0]
        result.append({'nombre': name, 'ruta': '~' + os.path.dirname(path)[len(home):] if path.startswith(home) else path,
                       'path': path, 'icono': Gio.content_type_get_generic_icon_name(kind) or 'text-x-generic',
                       'carpeta': folder})
    return result


def already_running():
    """Si ya está en marcha, se le pide que se enseñe (sin cargar Qt: así es instantáneo)."""
    import dbus
    try:
        bus = dbus.SessionBus()
        if not bus.name_has_owner(SERVICE):
            return False
        if '--atajos' in sys.argv:
            bus.get_object(SERVICE, PATH).Atajos(dbus_interface=IFACE)
        elif '--fondo' not in sys.argv:
            bus.get_object(SERVICE, PATH).Toggle(dbus_interface=IFACE)
        return True
    except dbus.DBusException:
        return False


def main():
    if already_running():
        return 0
    os.environ['QT_QUICK_CONTROLS_STYLE'] = 'Basic'
    from PyQt6.QtCore import QObject, QTimer, QUrl, pyqtClassInfo, pyqtProperty, pyqtSignal, pyqtSlot
    from PyQt6.QtDBus import QDBusAbstractAdaptor, QDBusConnection
    from PyQt6.QtGui import QDesktopServices, QGuiApplication, QIcon
    from PyQt6.QtQml import QQmlApplicationEngine

    import threading
    import apogeo_calculo

    class Buscador(QObject):
        toggled = pyqtSignal()
        appsChanged = pyqtSignal()
        filesFound = pyqtSignal(str, 'QVariantList')
        atajos = pyqtSignal(bool)   # la guía: mientras mantienes Meta (True) o con Meta+/ (False)
        soltada = pyqtSignal()

        def __init__(self):
            super().__init__()
            self._apps = []
            # Al soltar Meta después de la guía, KWin abre igualmente el buscador (Meta sola): esa vez no se hace caso. Solo
            # justo al soltarla (o mientras sigue pulsada, como mucho medio minuto): si no, se perdía la siguiente vez que
            # lo abrías con el orbe
            self.swallow_until = 0.0
            self.orbe = ''   # dónde está el orbe de la isla («x,y» del orbe y de sus dos bolitas, en la pantalla)

        def toggle(self):
            if time.monotonic() < self.swallow_until:
                self.swallow_until = 0.0
            else:
                self.toggled.emit()

        def abrir_desde(self, where):
            """Un clic en el orbe (no es la tecla Meta: nunca se ignora)."""
            self.poner_orbe(where)
            self.swallow_until = 0.0
            self.toggled.emit()

        def poner_orbe(self, where):
            try:
                n = [int(v) for v in where.split(',')]
            except ValueError:
                return
            if len(n) == 6 and all(-20000 < v < 20000 for v in n):
                self.orbe = where

        @pyqtSlot(result=str)
        def donde(self):
            return self.orbe

        @pyqtSlot()
        def mantenida(self):
            self.swallow_until = time.monotonic() + 30
            self.atajos.emit(True)

        @pyqtSlot()
        def suelta(self):
            self.swallow_until = time.monotonic() + 1.0
            self.soltada.emit()

        @pyqtSlot(result=str)
        def piso(self):
            """El piso en el que estás («Jugar», «Navegar», «Estudiar»; '' si no se sabe)."""
            import dbus
            try:
                props = dbus.Interface(dbus.SessionBus().get_object('org.kde.KWin', '/VirtualDesktopManager'),
                                       'org.freedesktop.DBus.Properties')
                current = str(props.Get('org.kde.KWin.VirtualDesktopManager', 'current'))
                return next((str(d[2]) for d in props.Get('org.kde.KWin.VirtualDesktopManager', 'desktops')
                             if str(d[1]) == current), '')
            except dbus.DBusException:
                return ''

        @pyqtSlot(str, result=bool)
        def carrusel(self, piso):
            """Si ese piso tiene las ventanas en carrusel (para enseñar sus atajos en la guía)."""
            import apogeo_comun as comun
            key = piso.strip().lower()
            return key in comun.FLOOR_KEYS and comun.load()['pisos'][key]['carrusel']

        @pyqtProperty('QVariantList', notify=appsChanged)
        def apps(self):
            return self._apps

        @pyqtSlot()
        def refresh(self):
            """Las apps otra vez (al abrir el cajón: por si has instalado o quitado alguna)."""
            self._apps = grouped_apps()
            self.appsChanged.emit()

        @pyqtSlot(str)
        def launch(self, desktop_id):
            """Abre la app como si la abrieras tú (en su propio grupo de systemd)."""
            import gi
            gi.require_version('Gio', '2.0')
            from gi.repository import Gio
            try:
                path = Gio.DesktopAppInfo.new(desktop_id).get_filename()
            except TypeError:
                return
            import subprocess
            subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice', 'gio', 'launch', path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

        @pyqtSlot(str, result='QVariantMap')
        def answer(self, text):
            """La cuenta, si lo que escribes es una ({} si no)."""
            return apogeo_calculo.answer(text) or {}

        @pyqtSlot(str)
        def copy(self, text):
            QGuiApplication.clipboard().setText(text)

        @pyqtSlot(str)
        def searchFiles(self, text):
            """Busca en segundo plano; contesta con filesFound (con lo que se buscó, por si ya escribiste otra cosa)."""
            threading.Thread(target=lambda: self.filesFound.emit(text, find_files(text)), daemon=True).start()

        @pyqtSlot(str, bool)
        def openFile(self, path, folder):
            """Abre el archivo con su app (o, con «folder», la carpeta donde está, con él elegido)."""
            import subprocess
            if folder:
                cmd = ['dbus-send', '--session', '--dest=org.freedesktop.FileManager1', '--type=method_call',
                       '/org/freedesktop/FileManager1', 'org.freedesktop.FileManager1.ShowItems',
                       f'array:string:{QUrl.fromLocalFile(path).toString()}', 'string:']
            else:
                cmd = ['gio', 'open', path]
            subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice', *cmd],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

        # ----- La Órbita abierta: tus apps del modo, las órdenes y el inspector -----
        pinsChanged = pyqtSignal()

        @pyqtSlot(result=str)
        def modo(self):
            """El modo en el que estás (jugar, navegar o estudiar), el que publica apogeo-pisos."""
            try:
                with open(MODO) as f:
                    m = str(json.load(f).get('modo') or '')
            except (OSError, ValueError):
                m = ''
            return m if m in PINS_DEFAULT else 'navegar'

        @pyqtSlot(str, result='QVariantList')
        def fijadas(self, modo):
            return [a for a in (app_info(i) for i in load_pins().get(modo, [])) if a]

        @pyqtSlot(str, str, bool)
        def fijar(self, modo, desktop_id, on):
            """Fijar una app en el modo (al final) o quitarla."""
            pins = load_pins()
            if modo not in pins:
                return
            have = [i for i in pins[modo] if i != desktop_id]
            pins[modo] = have + [desktop_id] if on else have
            save_pins(pins)
            self.pinsChanged.emit()

        @pyqtSlot(str, result='QVariantList')
        def buscarApps(self, text):
            """Las apps instaladas cuyo nombre encaja (para fijarlas desde la búsqueda): primero las que empiezan así."""
            q = plain(text)
            if not q:
                return []
            todas = [a for g in self._apps for a in g['apps']]
            empieza = [a for a in todas if plain(a['nombre']).startswith(q)]
            dentro = [a for a in todas if q in plain(a['nombre']) and a not in empieza]
            return (empieza + dentro)[:5]

        @pyqtSlot(result=str)
        def avisos(self):
            """Los últimos avisos (los apunta apogeo-pisos), del más nuevo al más viejo, con el nombre y el icono de su
            app."""
            path = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'apogeo-avisos.json')
            try:
                with open(path) as f:
                    items = json.load(f)
            except (OSError, ValueError):
                items = []
            out = []
            for a in reversed(items if isinstance(items, list) else []):
                info = app_info(a.get('desktop', '') + '.desktop') if a.get('desktop') else None
                out.append(dict(a, nombre=info['nombre'] if info else a.get('app', ''),
                                icono=a.get('icono') or (info['icono'] if info else 'dialog-information'),
                                abrir=info['id'] if info else ''))
            return json.dumps(out[:6], ensure_ascii=False)

        @pyqtSlot(int)
        def quitarAviso(self, cuando):
            """Quita un aviso de la lista de la Órbita (por cuándo llegó)."""
            path = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'apogeo-avisos.json')
            try:
                with open(path) as f:
                    items = json.load(f)
                items = [a for a in items if a.get('cuando') != cuando]
                tmp = path + '.tmp'
                with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as f:
                    json.dump(items, f, ensure_ascii=False)
                os.replace(tmp, path)
            except (OSError, ValueError):
                pass

        @pyqtSlot(str, result='QVariantList')
        def ordenes(self, text):
            return find_commands(text)

        @pyqtSlot(str)
        def orden(self, cid):
            def run(*cmd):
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            prompt = {'apagar': 'promptShutDown', 'reiniciar': 'promptReboot', 'sesion': 'promptLogout'}
            if cid.startswith('modo:'):
                run('dbus-send', '--session', '--type=method_call', '--dest=org.apogeo.Modos', '/Modos',
                    'org.apogeo.Modos1.Cambiar', 'string:' + cid[5:])
            elif cid in prompt:
                run('dbus-send', '--session', '--type=method_call', '--dest=org.kde.LogoutPrompt', '/LogoutPrompt',
                    'org.kde.LogoutPrompt.' + prompt[cid])
            elif cid == 'suspender':
                run('systemctl', 'suspend')
            elif cid == 'bloquear':
                run('loginctl', 'lock-session')
            elif cid == 'ajustes':
                run('/usr/lib/apogeo/apogeo-ajustes')
            elif cid == 'atajos':
                self.atajos.emit(False)

        @pyqtSlot(result=str)
        def inspector(self):
            """Lo de la derecha, en JSON: lo que suena, los números de tus apps (Discord, Telegram…) con su nombre y su
            icono, lo que se baja y lo próximo del calendario (todo de apogeo-pisos: org.apogeo.Datos)."""
            def call(method):
                import dbus
                try:
                    return json.loads(str(dbus.SessionBus().get_object('org.apogeo.Datos', '/Datos').get_dbus_method(
                        method, 'org.apogeo.Datos')(timeout=3)))
                except (dbus.DBusException, ValueError):
                    return None
            badges = call('Insignias') or {}
            avisos, bajando = [], []
            for app, b in badges.items():
                info = app_info(app + '.desktop') or {'nombre': app, 'icono': app}
                if b.get('numero'):
                    avisos.append({'app': info['nombre'], 'icono': info['icono'], 'numero': b['numero']})
                if 'progreso' in b:
                    bajando.append({'app': info['nombre'], 'icono': info['icono'], 'progreso': b['progreso']})
            return json.dumps({'musica': call('Musica') or {}, 'avisos': avisos, 'bajando': bajando,
                               'proximo': (call('Proximo') or [])[:3]}, ensure_ascii=False)

        @pyqtSlot(str)
        def musica(self, action):
            subprocess.Popen(['dbus-send', '--session', '--type=method_call', '--dest=org.apogeo.Datos', '/Datos',
                              'org.apogeo.Datos.MusicaAccion', 'string:' + action],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        @pyqtSlot(str)
        def web(self, text):
            """Buscar en la web: lo abre el navegador del sistema (Ágape)."""
            QDesktopServices.openUrl(QUrl('https://www.google.com/search?q=' + QUrl.toPercentEncoding(text).data().decode()))

    @pyqtClassInfo('D-Bus Interface', IFACE)
    class Adaptor(QDBusAbstractAdaptor):
        @pyqtSlot()
        def Toggle(self):
            self.parent().toggle()

        @pyqtSlot(str)
        def AbrirDesde(self, where):
            self.parent().abrir_desde(where)

        @pyqtSlot(str)
        def Orbe(self, where):
            self.parent().poner_orbe(where)

        @pyqtSlot()
        def Atajos(self):
            self.parent().atajos.emit(False)

    app = QGuiApplication(sys.argv)
    app.setApplicationName('Buscador de Apogeo')
    app.setDesktopFileName('apogeo-buscador')
    app.setWindowIcon(QIcon.fromTheme('apogeo'))
    app.setQuitOnLastWindowClosed(False)
    bus = QDBusConnection.sessionBus()
    if not bus.registerService(SERVICE):
        return 0  # otro se ha adelantado
    backend = Buscador()
    Adaptor(backend)
    bus.registerObject(PATH, backend)
    system = QDBusConnection.systemBus()
    system.connect('', '/org/apogeo/Meta', 'org.apogeo.Meta', 'Mantenida', backend.mantenida)
    system.connect('', '/org/apogeo/Meta', 'org.apogeo.Meta', 'Soltada', backend.suelta)
    engine = QQmlApplicationEngine()
    if os.environ.get('APOGEO_QML_DIR'):
        engine.addImportPath(os.environ['APOGEO_QML_DIR'])
    engine.rootContext().setContextProperty('buscador', backend)
    engine.rootContext().setContextProperty('showAtStart', '--fondo' not in sys.argv and '--atajos' not in sys.argv)
    engine.rootContext().setContextProperty('atajosAtStart', '--atajos' in sys.argv)
    engine.load(QUrl.fromLocalFile(QML))
    engine.load(QUrl.fromLocalFile(ATAJOS_QML))
    if not engine.rootObjects():
        return 1
    return app.exec()


if __name__ == '__main__':
    sys.exit(main())
