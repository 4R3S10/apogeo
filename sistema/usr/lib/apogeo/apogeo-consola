#!/usr/bin/python3
"""
La consola del piso Jugar («C8 · Cinta panorámica»): a pantalla completa, tus juegos descargados en una cinta abajo (el
último jugado primero), con su portada; el elegido pinta la pantalla con su arte. Arriba, Inicio y una pestaña por
tienda o plataforma (Steam, Epic, Emuladores, PS5 y Windows) con toda tu biblioteca para descargar y quitar.

Con el mando (sin Steam por medio: lo lee este programa) o el teclado:
  ← → elegir · ✕ (A) / Intro jugar o descargar · □ (X) / Supr quitar · L1 R1 (LB RB) / Q E pestaña · ○ (B) / Esc atrás
  el botón central del mando (PS o Xbox), como en la PS5: pulsado y soltado, el centro de control encima del juego
  (Centro.qml: lo que suena, Discord, los avisos de la partida, el volumen y volver a la consola); mantenido, la
  consola. Con él mantenido, → ← cambian de canción y ↑ ↓ el volumen. Fuera de Jugar trae la consola.
  Los botones salen como en tu mando.

  apogeo-consola            la abre (o la trae delante, si ya está)
D-Bus: org.apogeo.Consola /Consola org.apogeo.Consola.Show
La parte de los juegos es apogeo_juegos.py.
"""
import json
import os
import subprocess
import sys
import ctypes
import threading

SERVICE, PATH, IFACE = 'org.apogeo.Consola', '/Consola', 'org.apogeo.Consola'
QML = os.environ.get('APOGEO_CONSOLA_QML', '/usr/share/apogeo/consola/Consola.qml')
CENTRO_QML = os.path.join(os.path.dirname(QML), 'Centro.qml')
MODO = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'apogeo', 'modo.json')
sys.path.insert(0, os.environ.get('APOGEO_LIB', '/usr/lib/apogeo'))


def already_running():
    import dbus
    try:
        bus = dbus.SessionBus()
        if not bus.name_has_owner(SERVICE):
            return False
        bus.get_object(SERVICE, PATH).Show(dbus_interface=IFACE)
        return True
    except dbus.DBusException:
        return False


def main():
    if already_running():
        return 0
    os.environ['QT_QUICK_CONTROLS_STYLE'] = 'Basic'
    from PyQt6.QtCore import QObject, QTimer, QUrl, pyqtClassInfo, pyqtProperty, pyqtSignal, pyqtSlot
    from PyQt6.QtDBus import QDBusAbstractAdaptor, QDBusConnection
    from PyQt6.QtGui import QGuiApplication, QIcon
    from PyQt6.QtQml import QQmlApplicationEngine
    import apogeo_juegos as juegos
    import apogeo_comun as comun

    class Consola(QObject):
        changed = pyqtSignal()
        shown = pyqtSignal()
        pad = pyqtSignal(str, arguments=['button'])   # el mando: izquierda, derecha, a, b, x, y, lb, rb
        mandoChanged = pyqtSignal()
        _kind = pyqtSignal(str)                       # (del hilo del mando: «ps» o «xbox»)
        _ready = pyqtSignal(object)                   # (de un hilo al principal)

        def __init__(self):
            super().__init__()
            self._tabs = {k: [] for k in ('inicio', 'steam', 'epic', 'emuladores', 'ps5', 'windows')}
            self._tabs.update(descargas={}, emuladoresHay={}, anyps5=False)
            self._loading = False
            self._ready.connect(self._set)
            self._mando = 'ps'
            self._kind.connect(self._set_kind)
            self.timer = QTimer(self)
            self.timer.timeout.connect(self.refresh)
            self.timer.start(20000)
            juegos.prepare_folders()
            self.refresh()

        @pyqtProperty('QVariantMap', notify=changed)
        def tabs(self):
            return self._tabs

        @pyqtProperty(str, constant=True)
        def avatar(self):
            try:
                path = comun.Accounts().get('IconFile')
                return 'file://' + path if path and os.path.isfile(path) else ''
            except Exception:
                return ''

        @pyqtProperty(str, notify=mandoChanged)
        def mando(self):
            """«ps» (lo de serie: ✕ ○ □ △ L1 R1) o «xbox» (A B X Y LB RB), según el mando conectado."""
            return self._mando

        def _set_kind(self, kind):
            if kind != self._mando:
                self._mando = kind
                self.mandoChanged.emit()

        @pyqtProperty(bool, constant=True)
        def gpu(self):
            return comun.real_gpu()

        @pyqtProperty(str, constant=True)
        def folder(self):
            return juegos.JUEGOS

        @pyqtSlot()
        def refresh(self):
            """Todo otra vez (en otro hilo: leer las tiendas tarda un poco)."""
            if self._loading:
                return
            self._loading = True

            def work():
                try:
                    data = juegos.tabs()
                except Exception as e:  # una tienda con un archivo raro no deja la consola vacía
                    print('[consola]', e, file=sys.stderr)
                    data = None
                self._ready.emit(data)
                if data:
                    juegos.cache_boxarts(data['emuladores'])
            threading.Thread(target=work, daemon=True).start()

        def _set(self, data):
            self._loading = False
            if data:
                self._tabs = data
                self.changed.emit()
            # Mientras algo se baja o se quita, se mira cada 2 segundos
            self.timer.setInterval(2000 if self._tabs.get('descargas') else 20000)

        @pyqtSlot('QVariant', result=str)
        def play(self, g):
            g = g.toVariant() if hasattr(g, 'toVariant') else g
            msg = juegos.play(g)
            if not msg:
                QTimer.singleShot(1500, self.refresh)
            return msg

        @pyqtSlot('QVariant', result=str)
        def install(self, g):
            g = g.toVariant() if hasattr(g, 'toVariant') else g
            msg = juegos.install(g)
            QTimer.singleShot(800, self.refresh)
            return msg

        @pyqtSlot('QVariant', result=str)
        def uninstall(self, g):
            g = g.toVariant() if hasattr(g, 'toVariant') else g
            msg = juegos.uninstall(g)
            QTimer.singleShot(800, self.refresh)
            return msg

        @pyqtSlot(result=str)
        def windowsDesktop(self):
            """A Windows con el escritorio, para instalar juegos (con «Volver a Apogeo»)."""
            return juegos.to_windows({'modo': 'escritorio'})

        @pyqtSlot(str)
        def open(self, what):
            """Abre una tienda, un emulador o tu carpeta de juegos."""
            cmd = {'steam': ['steam'], 'epic': ['heroic'], 'carpeta': ['xdg-open', juegos.JUEGOS],
                   'hydra': ['hydralauncher']}.get(what) or (['flatpak', 'run', what] if '.' in what else None)
            if cmd:
                juegos.detach(cmd)

        # ----- Dormida (sin la consola delante): sin mirar los juegos y devolviendo la memoria -----
        @pyqtSlot(bool)
        def activa(self, on):
            if on and not self.timer.isActive():
                self.timer.start(20000)
                self.refresh()
            elif not on:
                self.timer.stop()

        # ----- Los FPS de cada juego (MangoHud) -----
        fpsChanged = pyqtSignal()

        @pyqtProperty('QVariantMap', notify=fpsChanged)
        def juegosFps(self):
            return comun.load().get('juegos_fps', {})

        @pyqtProperty(int, notify=fpsChanged)
        def fpsTodos(self):
            return comun.load().get('fps', 60)

        @pyqtSlot(str, int)
        def setFps(self, key, fps):
            st = comun.load()
            per = dict(st.get('juegos_fps') or {})
            if fps in comun.FPS_CHOICES:
                per[key] = fps
            else:
                per.pop(key, None)
            st['juegos_fps'] = per
            comun.save(st)
            self.fpsChanged.emit()

        @pyqtSlot(result=bool)
        def fueraDeJugar(self):
            """¿Estás en otro modo? Lo dice apogeo-pisos en ~/.config/apogeo/modo.json (el piso no es un número fijo:
            los escritorios pueden reordenarse). Si aún no hay archivo, no se cierra nada por si acaso."""
            try:
                with open(MODO) as f:
                    return str(json.load(f).get('modo') or '') not in ('', 'jugar')
            except (OSError, ValueError):
                return False

        @pyqtSlot()
        def dormir(self):
            engine.trimComponentCache()
            engine.collectGarbage()
            try:  # lo que ya no se usa, de vuelta al sistema (si no, se queda apartado para esta app)
                ctypes.CDLL('libc.so.6').malloc_trim(0)
            except OSError:
                pass

        @pyqtSlot(int)
        def floor(self, n):
            subprocess.Popen(['/usr/lib/apogeo/apogeo-pisos', 'ir', str(n)], start_new_session=True)

        # ----- El centro de control (el botón PS, como en la PS5) -----
        guia = pyqtSignal()                            # el botón central, pulsado y soltado: el centro
        atajo = pyqtSignal(str, arguments=['what'])    # con él mantenido: siguiente, anterior, subir, bajar
        abierto = False                                # (el centro, a la vista: el mando solo es suyo)

        @pyqtSlot(bool)
        def setCentro(self, on):
            self.abierto = on

        @pyqtSlot()
        def traer(self):
            self.shown.emit()

        @pyqtSlot(result=str)
        def centro(self):
            """Lo del centro, en JSON: lo que suena, Discord (si está abierto, sus mensajes y tu micro), los avisos que han
            llegado en la partida (Jugar no los enseña: los guarda apogeo-pisos) y el volumen."""
            mic, vol = _volume('@DEFAULT_AUDIO_SOURCE@'), _volume('@DEFAULT_AUDIO_SINK@')
            badges = _call('org.apogeo.Datos', '/Datos', 'org.apogeo.Datos', 'Insignias') or {}
            return json.dumps({
                'musica': _call('org.apogeo.Datos', '/Datos', 'org.apogeo.Datos', 'Musica') or {},
                'discord': {'abierto': _running('Discord', 'discord'), 'micro': not mic[1] if mic else None,
                            'mensajes': badges.get('discord', {}).get('numero', 0)},
                'avisos': _call('org.apogeo.Modos', '/Modos', 'org.apogeo.Modos1', 'Avisos') or [],
                'volumen': {'nivel': vol[0], 'mudo': vol[1]} if vol else None,
            }, ensure_ascii=False)

        @pyqtSlot(str)
        def musica(self, action):
            """Previous · PlayPause · Next en lo que suena (lo mismo que la isla)."""
            _call('org.apogeo.Datos', '/Datos', 'org.apogeo.Datos', 'MusicaAccion', action, answer=False)

        @pyqtSlot()
        def spotify(self):
            _call('org.apogeo.Datos', '/Datos', 'org.apogeo.Datos', 'Abrir', 'spotify', answer=False)

        @pyqtSlot()
        def micro(self):
            """Tu micro, apagado o encendido (el del sistema: vale para Discord y para todo)."""
            subprocess.run(['wpctl', 'set-mute', '@DEFAULT_AUDIO_SOURCE@', 'toggle'], capture_output=True, timeout=3)

        @pyqtSlot(float)
        def volumen(self, step):
            """Más o menos volumen (de 0 a 1; nunca por encima del 100 %)."""
            if step:
                subprocess.run(['wpctl', 'set-volume', '-l', '1', '@DEFAULT_AUDIO_SINK@',
                                f'{abs(step):.2f}{"+" if step > 0 else "-"}'], capture_output=True, timeout=3)
            else:
                subprocess.run(['wpctl', 'set-mute', '@DEFAULT_AUDIO_SINK@', 'toggle'], capture_output=True, timeout=3)

        @pyqtSlot()
        def discord(self):
            """Discord al lado del juego sin quitarlo de la pantalla: el modo partida de KWin (Meta+Tab; si Discord no está
            abierto, lo abre). Un momento después, cuando el juego vuelve a estar delante."""
            QTimer.singleShot(350, lambda: _call('org.kde.kglobalaccel', '/component/kwin', 'org.kde.kglobalaccel.Component',
                                                 'invokeShortcut', 'Apogeo partida', answer=False))

    @pyqtClassInfo('D-Bus Interface', IFACE)
    class Adaptor(QDBusAbstractAdaptor):
        @pyqtSlot()
        def Show(self):
            self.parent().shown.emit()

    app = QGuiApplication(sys.argv)
    app.setApplicationName('Jugar')
    app.setDesktopFileName('apogeo-consola')
    app.setWindowIcon(QIcon.fromTheme('input-gaming'))
    bus = QDBusConnection.sessionBus()
    if not bus.registerService(SERVICE):
        return 0
    consola = Consola()
    Adaptor(consola)
    bus.registerObject(PATH, consola)
    engine = QQmlApplicationEngine()
    if os.environ.get('APOGEO_QML_DIR'):
        engine.addImportPath(os.environ['APOGEO_QML_DIR'])
    engine.rootContext().setContextProperty('consola', consola)
    engine.load(QUrl.fromLocalFile(QML))
    if not engine.rootObjects():
        return 1
    engine.load(QUrl.fromLocalFile(CENTRO_QML))
    threading.Thread(target=gamepads, args=(consola,), daemon=True).start()
    return app.exec()


# ---------- Lo que lee el centro de control ----------

def _call(service, path, iface, method, *args, answer=True):
    """Un método de D-Bus que devuelve JSON (los de apogeo-pisos), ya leído; None si no está o no contesta."""
    import dbus
    try:
        out = dbus.SessionBus().get_object(service, path).get_dbus_method(method, iface)(*args, timeout=3)
        return json.loads(str(out)) if answer else None
    except (dbus.DBusException, ValueError):
        return None


def _volume(target):
    """(nivel de 0 a 1, en silencio) de la salida o del micro (wpctl: «Volume: 0.40 [MUTED]»); None si no hay."""
    try:
        out = subprocess.run(['wpctl', 'get-volume', target], capture_output=True, text=True, timeout=3).stdout.split()
        return round(float(out[1]), 2), '[MUTED]' in out
    except (OSError, subprocess.SubprocessError, IndexError, ValueError):
        return None


def _running(*names):
    for pid in os.listdir('/proc'):
        if pid.isdigit():
            try:
                with open(f'/proc/{pid}/comm') as f:
                    if f.read().strip() in names:
                        return True
            except OSError:
                pass
    return False


# ---------- El mando ----------

def gamepads(consola):
    """Lee los mandos (evdev) y se los pasa a la consola (que solo hace caso con su ventana delante) o, con el centro de
    control abierto, al centro (y entonces el mando es solo suyo: el juego no se entera). El botón central, al soltarlo:
    el centro de control (en Jugar) o la consola (mantenido, o fuera de Jugar); con él mantenido, las flechas son atajos."""
    try:
        import evdev
        from evdev import ecodes as e
    except ImportError:
        return
    import selectors
    import time
    names = {e.BTN_SOUTH: 'a', e.BTN_EAST: 'b', e.BTN_WEST: 'x', e.BTN_NORTH: 'y', e.BTN_TL: 'lb', e.BTN_TR: 'rb',
             e.BTN_START: 'start', e.BTN_DPAD_LEFT: 'izquierda', e.BTN_DPAD_RIGHT: 'derecha',
             e.BTN_DPAD_UP: 'arriba', e.BTN_DPAD_DOWN: 'abajo'}
    hat = {(e.ABS_HAT0X, -1): 'izquierda', (e.ABS_HAT0X, 1): 'derecha', (e.ABS_HAT0Y, -1): 'arriba',
           (e.ABS_HAT0Y, 1): 'abajo'}
    combos = {'derecha': 'siguiente', 'izquierda': 'anterior', 'arriba': 'subir', 'abajo': 'bajar'}
    LONG = 0.7  # segundos mantenido: la consola en vez del centro
    sel = selectors.DefaultSelector()
    known = {}
    stick = {}     # dispositivo → -1/0/1 en horizontal (para no repetir)
    held = None    # el botón central mantenido: [cuándo, si ya se ha usado para un atajo]
    grabbed = False

    def scan():
        for path in evdev.list_devices():
            if path in known:
                continue
            try:
                d = evdev.InputDevice(path)
                keys = d.capabilities().get(e.EV_KEY, [])
                if e.BTN_SOUTH not in keys and e.BTN_GAMEPAD not in keys:
                    d.close()
                    continue
                known[path] = d
                sel.register(d, selectors.EVENT_READ)
                if grabbed:
                    d.grab()
                # Sony (054c): PlayStation; Microsoft (045e) o lo que diga Xbox: Xbox
                xbox = d.info.vendor == 0x045e or 'xbox' in d.name.lower()
                consola._kind.emit('xbox' if xbox else 'ps')
            except OSError:
                pass

    def grab(on):
        for d in known.values():
            try:
                d.grab() if on else d.ungrab()
            except OSError:
                pass

    def send(button):
        nonlocal held
        if held is not None and button in combos:
            held[1] = True
            consola.atajo.emit(combos[button])
        elif held is None:
            consola.pad.emit(button)

    def guide(down):
        nonlocal held
        if down:
            held = [time.time(), False]
            return
        if held is None:
            return
        start, used = held
        held = None
        if used:
            return
        if time.time() - start >= LONG or consola.fueraDeJugar():
            consola.shown.emit()
        else:
            consola.guia.emit()

    last_scan = 0
    while True:
        if time.time() - last_scan > 3:  # mandos que se conectan después
            scan()
            last_scan = time.time()
        if consola.abierto != grabbed:   # el centro abierto: el mando, solo para él
            grabbed = consola.abierto
            grab(grabbed)
        for key, _ in sel.select(timeout=0.2):  # (corto: el centro se adueña del mando nada más abrirse)
            d = key.fileobj
            try:
                for ev in d.read():
                    if ev.type == e.EV_KEY and ev.code == e.BTN_MODE and ev.value in (0, 1):
                        guide(ev.value == 1)
                    elif ev.type == e.EV_KEY and ev.value == 1 and ev.code in names:
                        send(names[ev.code])
                    elif ev.type == e.EV_ABS and (ev.code, ev.value) in hat:
                        send(hat[(ev.code, ev.value)])
                    elif ev.type == e.EV_ABS and ev.code == e.ABS_X:
                        info = d.absinfo(e.ABS_X)
                        mid = (info.max + info.min) / 2
                        span = (info.max - info.min) / 2 or 1
                        pos = (ev.value - mid) / span
                        state = -1 if pos < -0.6 else 1 if pos > 0.6 else 0
                        if state != stick.get(d.path, 0) and state:
                            send('izquierda' if state < 0 else 'derecha')
                        stick[d.path] = state
            except OSError:  # desconectado
                sel.unregister(d)
                known.pop(d.path, None)

if __name__ == '__main__':
    sys.exit(main())
