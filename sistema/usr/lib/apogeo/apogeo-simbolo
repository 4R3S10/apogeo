#!/usr/bin/python3
"""
«Tu símbolo» (D7): desbloquear dibujando tu marca con el ratón en cualquier parte de la pantalla de bloqueo. Se reconoce
la forma (no el sitio ni el tamaño) y el sentido en que la dibujas. La contraseña sigue igual y siempre sirve: al
encender el equipo y al entrar se pide ella; el símbolo es solo para la pantalla de bloqueo y nunca la toca.

Cómo entra en el bloqueo: la pantalla de bloqueo manda el dibujo como si fuera la contraseña, con «apogeo-simbolo:»
delante; /etc/pam.d/kde lo pasa primero por aquí (pam_exec, como tú):
  - si es tu símbolo → entras;
  - si es un dibujo pero no es tu símbolo → falla ahí mismo (no llega a la contraseña: no cuenta como contraseña
    equivocada y nunca bloquea la cuenta);
  - si es una contraseña de verdad → sigue a la comprobación de siempre.
Tras 5 dibujos que no son, el símbolo deja de servir 10 minutos (hay que usar la contraseña).

  apogeo-simbolo estado                    {"hay": bool}
  pkexec apogeo-simbolo guardar            (lee de la entrada [[x, y], …] × 3 dibujos) lo guarda
  pkexec apogeo-simbolo quitar
  apogeo-simbolo pam-comprobar | pam-es-simbolo    (solo /etc/pam.d/kde)
  apogeo-simbolo probar                    (lee de la entrada un dibujo) {"vale": bool, "distancia": n}
"""
import base64
import json
import math
import os
import pwd
import sys
import time

DIR = '/var/lib/apogeo/simbolo'
PREFIX = 'apogeo-simbolo:'
N = 48                 # puntos de cada dibujo, ya normalizado
MAX_FAILS, LOCK_SECONDS = 5, 600


# ---------- La forma: mismos puntos, mismo tamaño y en el centro ----------

def resample(pts, n=N):
    """n puntos repartidos por igual a lo largo del trazo."""
    pts = [(float(x), float(y)) for x, y in pts]
    if len(pts) < 2:
        return None
    length = sum(math.dist(pts[i - 1], pts[i]) for i in range(1, len(pts)))
    if length <= 0:
        return None
    step = length / (n - 1)
    out, acc, i = [pts[0]], 0.0, 1
    prev = pts[0]
    while i < len(pts) and len(out) < n:
        cur = pts[i]
        d = math.dist(prev, cur)
        if acc + d >= step and d > 0:
            t = (step - acc) / d
            q = (prev[0] + t * (cur[0] - prev[0]), prev[1] + t * (cur[1] - prev[1]))
            out.append(q)
            prev, acc = q, 0.0
        else:
            acc += d
            prev = cur
            i += 1
    while len(out) < n:
        out.append(pts[-1])
    return out


def normalize(pts):
    """Al centro y del mismo tamaño (el lado mayor = 1), sin girarlo: el sentido y la orientación cuentan."""
    pts = resample(pts)
    if not pts:
        return None
    cx = sum(p[0] for p in pts) / len(pts)
    cy = sum(p[1] for p in pts) / len(pts)
    w = max(p[0] for p in pts) - min(p[0] for p in pts)
    h = max(p[1] for p in pts) - min(p[1] for p in pts)
    s = max(w, h)
    if s <= 0:
        return None
    return [((x - cx) / s, (y - cy) / s) for x, y in pts]


def distance(a, b):
    return sum(math.dist(p, q) for p, q in zip(a, b)) / len(a)


def complexity(pts):
    """Cuánto gira el trazo (en grados) y lo largo que es: una raya o una curva simple no valen. (Con 16 puntos, para
    que el temblor de la mano no cuente como giro.)"""
    pts = resample(pts, 16)
    turn = 0.0
    for i in range(2, len(pts)):
        a1 = math.atan2(pts[i - 1][1] - pts[i - 2][1], pts[i - 1][0] - pts[i - 2][0])
        a2 = math.atan2(pts[i][1] - pts[i - 1][1], pts[i][0] - pts[i - 1][0])
        d = (a2 - a1 + math.pi) % (2 * math.pi) - math.pi
        turn += abs(d)
    length = sum(math.dist(pts[i - 1], pts[i]) for i in range(1, len(pts)))
    return math.degrees(turn), length


def decode(text):
    """El dibujo que manda la pantalla de bloqueo: «apogeo-simbolo:» + base64 de pares x,y (de 0 a 127)."""
    raw = base64.b64decode(text[len(PREFIX):], validate=True)
    return [(raw[i], raw[i + 1]) for i in range(0, len(raw) - 1, 2)]


# ---------- Lo guardado ----------

def path_for(user):
    return os.path.join(DIR, user + '.json')


def load(user):
    try:
        with open(path_for(user)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def check(user, drawing):
    saved = load(user)
    shape = normalize(drawing)
    if not saved or not shape:
        return False, 9.0
    ds = [distance(shape, t) for t in saved['plantillas']]
    best = min(ds)
    mean = sum(ds) / len(ds)
    return best <= saved['umbral'] and mean <= saved['umbral'] * 1.25, round(best, 3)


# ---------- Los fallos (en la memoria de tu sesión: se borran al apagar) ----------

def fails_file():
    return f'/run/user/{os.getuid()}/apogeo-simbolo-fallos'


def fails():
    try:
        n, since = open(fails_file()).read().split()
        n, since = int(n), float(since)
        if time.time() - since > LOCK_SECONDS:
            return 0, time.time()
        return n, since
    except (OSError, ValueError):
        return 0, time.time()


def set_fails(n, since):
    try:
        with open(fails_file(), 'w') as f:
            f.write(f'{n} {since}')
    except OSError:
        pass


def pam(mode):
    user = os.environ.get('PAM_USER') or pwd.getpwuid(os.getuid()).pw_name
    token = sys.stdin.read(4096).rstrip('\0\n')
    if not token.startswith(PREFIX):
        return 1                                   # una contraseña: que siga
    if mode == 'pam-es-simbolo':
        return 0                                   # es un dibujo que no ha valido: que no siga a la contraseña
    n, since = fails()
    if n >= MAX_FAILS:
        return 1
    try:
        ok, _ = check(user, decode(token))
    except (ValueError, IndexError):
        ok = False
    if ok:
        set_fails(0, time.time())
        return 0
    set_fails(n + 1, since if n else time.time())
    return 1


# ---------- Guardar (con pkexec) ----------

def save():
    uid = int(os.environ.get('PKEXEC_UID', '-1'))
    if uid < 1000:
        return 'Solo para tu cuenta'
    user = pwd.getpwuid(uid).pw_name
    try:
        drawings = json.loads(sys.stdin.read(200000))
        shapes = [normalize(d) for d in drawings[:3]]
    except (ValueError, TypeError):
        return 'Dibujo raro'
    if len(shapes) != 3 or not all(shapes):
        return 'Hacen falta tres dibujos'
    turn, length = complexity(shapes[0])
    w = max(p[0] for p in shapes[0]) - min(p[0] for p in shapes[0])
    h = max(p[1] for p in shapes[0]) - min(p[1] for p in shapes[0])
    if turn < 300 or length < 1.8 or min(w, h) < 0.2:   # (una raya, una curva o un garabato muy plano)
        return 'Demasiado sencillo: hazlo un poco más complicado (con alguna curva o esquina más)'
    pair = [distance(shapes[i], shapes[j]) for i in range(3) for j in range(i + 1, 3)]
    if max(pair) > 0.16:
        return 'Los tres dibujos no se parecen: dibújalo igual las tres veces'
    umbral = round(min(0.14, max(0.075, max(pair) * 1.7)), 4)
    os.makedirs(DIR, mode=0o755, exist_ok=True)
    p = path_for(user)
    tmp = p + '.nuevo'
    with open(tmp, 'w') as f:
        json.dump({'plantillas': [[[round(x, 4), round(y, 4)] for x, y in s] for s in shapes], 'umbral': umbral}, f)
    # solo lo puedes leer tú (lo comprueba tu pantalla de bloqueo) y nadie más que el administrador lo cambia
    os.chown(tmp, 0, pwd.getpwuid(uid).pw_gid)
    os.chmod(tmp, 0o640)
    os.replace(tmp, p)
    return ''


def main():
    a = sys.argv[1:]
    if a in (['pam-comprobar'], ['pam-es-simbolo']):
        return pam(a[0])
    if a == ['estado']:
        print(json.dumps({'hay': load(pwd.getpwuid(os.getuid()).pw_name) is not None}))
        return 0
    if a == ['probar']:
        try:
            ok, d = check(pwd.getpwuid(os.getuid()).pw_name, json.loads(sys.stdin.read(200000)))
        except (ValueError, TypeError):
            ok, d = False, 9.0
        print(json.dumps({'vale': ok, 'distancia': d}))
        return 0
    if os.geteuid() != 0:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if a == ['guardar']:
        msg = save()
        if msg:
            print(msg, file=sys.stderr)
            return 1
        return 0
    if a == ['quitar']:
        uid = int(os.environ.get('PKEXEC_UID', '-1'))
        if uid >= 1000:
            try:
                os.remove(path_for(pwd.getpwuid(uid).pw_name))
            except OSError:
                pass
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main())
