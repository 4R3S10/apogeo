#!/usr/bin/python3
"""
Música de Apogeo («M1 · Como en Ágape»): abajo a la izquierda, una portada por cada cosa que suena; al pasar el ratón,
la tarjeta con lo principal en grande (progreso y anterior · pausa · siguiente) y el resto en filas. La rueda del ratón
encima de una cambia su volumen. Lo que suena sale de:
  - los reproductores del sistema (MPRIS: Spotify, otros navegadores, apps de música…);
  - cada pestaña de Ágape, por su socket ($XDG_RUNTIME_DIR/agape-musica.sock). El reproductor MPRIS de Ágape
    (Chromium) no se enseña: ya está cada pestaña por separado.
Sale solo mientras suena algo; lo que pausas sigue un minuto (para reanudarlo) y luego se va.
No sale con Ágape delante (Ágape enseña el suyo) ni con una ventana a pantalla completa: eso lo hace el script de KWin
apogeo-ventanas, que también la coloca y la pone encima de todo.

  apogeo-musica    la deja en marcha (la arranca apogeo-pisos al empezar la sesión)
"""
import json
import os
import shutil
import subprocess
import sys
import time

os.environ['QT_QUICK_CONTROLS_STYLE'] = 'Basic'
from PyQt6.QtCore import QObject, QProcess, QTimer, QUrl, pyqtProperty, pyqtSignal, pyqtSlot  # noqa: E402
from PyQt6.QtDBus import QDBusConnection, QDBusInterface, QDBusMessage, QDBusVariant  # noqa: E402
from PyQt6.QtGui import QGuiApplication, QIcon, QRegion  # noqa: E402
from PyQt6.QtNetwork import QLocalSocket  # noqa: E402
from PyQt6.QtQml import QQmlApplicationEngine  # noqa: E402

QML = os.environ.get('APOGEO_MUSICA_QML', '/usr/share/apogeo/musica/Musica.qml')
ESCRITORIO_QML = os.path.join(os.path.dirname(QML), 'Escritorio.qml')   # el reloj de bloques y el visualizador
BARS = 40
CAVA_CONF = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')), 'apogeo', 'cava.conf')
CAVA = f'''# Apogeo: el visualizador del escritorio (lo escribe apogeo-musica)
[general]
bars = {BARS}
framerate = 30
autosens = 1
[input]
method = pipewire
source = auto
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10
[smoothing]
noise_reduction = 66
'''
SOCKET = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'agape-musica.sock')
MPRIS = 'org.mpris.MediaPlayer2.'
PATH = '/org/mpris/MediaPlayer2'
PLAYER = 'org.mpris.MediaPlayer2.Player'
LAST = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')), 'apogeo', 'musica-ultima.json')
NAMES = {'spotify': 'Spotify', 'firefox': 'Firefox', 'vlc': 'VLC', 'elisa': 'Elisa'}
TIMEOUT = 400   # ms por pregunta a un reproductor: uno que no contesta no deja la música (ni su ventana) parada


def unwrap(v):
    """QDBusVariant → valor de Python (y las listas y diccionarios de dentro)."""
    if isinstance(v, QDBusVariant):
        v = v.variant()
    if isinstance(v, dict):
        return {str(k): unwrap(x) for k, x in v.items()}
    if isinstance(v, list):
        return [unwrap(x) for x in v]
    return v


class Musica(QObject):
    changed = pyqtSignal()
    barsChanged = pyqtSignal()
    suenaChanged = pyqtSignal()

    def __init__(self):
        super().__init__()
        self.bus = QDBusConnection.sessionBus()
        self._mpris = []        # lo de los reproductores del sistema
        self._agape = []        # lo de las pestañas de Ágape
        self.pending = []       # preguntas a Ágape esperando respuesta (en orden)
        self.sock = QLocalSocket(self)
        self.sock.readyRead.connect(self._read)
        self.sock.errorOccurred.connect(lambda *_: self._drop())
        self.buf = b''
        self.idents = {}        # reproductor → su nombre (Identity), que no cambia: se pregunta una vez
        try:
            with open(LAST) as f:
                self._last = json.load(f)
        except (OSError, ValueError):
            self._last = {}
        self._barras = [0.0] * BARS
        self._suena = False
        self.cava = None
        self.cava_buf = b''
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.timer.start(1000)
        self.changed.connect(self._check_playing)
        self.poll()

    # ---------- El visualizador del escritorio (cava, solo mientras suena algo) ----------

    @pyqtProperty(bool, constant=True)
    def escritorioVivo(self):
        return True   # (el reloj sale siempre; las barras, mientras suena algo y con cava)

    @pyqtProperty(bool, notify=suenaChanged)
    def suena(self):
        return self._suena

    @pyqtProperty('QVariantList', notify=barsChanged)
    def barras(self):
        return self._barras

    def _check_playing(self):
        playing = any(not s['paused'] for s in self._agape + self._mpris)
        if playing != self._suena:
            self._suena = playing
            self.suenaChanged.emit()
            self._cava(playing)

    def _cava(self, on):
        if not on:
            if self.cava:
                self.cava.kill()
                self.cava = None
            self._barras = [0.0] * BARS
            self.barsChanged.emit()
            return
        if self.cava or not shutil.which('cava'):
            return
        try:
            os.makedirs(os.path.dirname(CAVA_CONF), exist_ok=True)
            with open(CAVA_CONF, 'w') as f:
                f.write(CAVA)
        except OSError:
            return
        self.cava = QProcess(self)
        self.cava.setProcessChannelMode(QProcess.ProcessChannelMode.SeparateChannels)
        self.cava.readyReadStandardOutput.connect(self._cava_read)
        self.cava.finished.connect(lambda *_: setattr(self, 'cava', None))
        self.cava.start('cava', ['-p', CAVA_CONF])

    def _cava_read(self):
        if not self.cava:
            return
        self.cava_buf += bytes(self.cava.readAllStandardOutput())
        if b'\n' not in self.cava_buf:
            return
        lines = self.cava_buf.split(b'\n')
        self.cava_buf = lines[-1]
        last = next((l for l in reversed(lines[:-1]) if l.strip()), b'')   # (solo el último fotograma)
        try:
            vals = [int(x) / 1000 for x in last.decode().strip().strip(';').split(';') if x]
        except ValueError:
            return
        if len(vals) == BARS:
            self._barras = vals
            self.barsChanged.emit()

    # ---------- Lo que suena ----------

    @pyqtProperty('QVariantList', notify=changed)
    def sources(self):
        return self._agape + self._mpris

    @pyqtProperty('QVariantMap', notify=changed)
    def last(self):
        """Lo último que sonó (para cuando no suena nada)."""
        return self._last

    @pyqtProperty(bool, constant=True)
    def hasSpotify(self):
        return bool(shutil.which('spotify')) or os.path.exists('/var/lib/flatpak/exports/bin/com.spotify.Client')

    def _remember(self):
        playing = [s for s in self._agape + self._mpris if not s['paused']]
        if not playing:
            return
        p = playing[0]
        last = {k: p.get(k) for k in ('key', 'kind', 'app', 'title', 'artist', 'art', 'url', 'spotify')}
        if last != self._last:
            self._last = last
            try:
                os.makedirs(os.path.dirname(LAST), exist_ok=True)
                with open(LAST, 'w') as f:
                    json.dump(last, f, ensure_ascii=False)
            except OSError:
                pass

    def poll(self):
        self._poll_mpris()
        self._poll_agape()

    def _players(self):
        reply = self.bus.interface().registeredServiceNames()
        names = reply.value() if hasattr(reply, 'value') else reply
        return [n for n in names if n.startswith(MPRIS)]

    def _poll_mpris(self):
        out = []
        names = self._players()
        self.idents = {n: v for n, v in self.idents.items() if n in names}
        for name in names:
            if 'chromium' in name:
                continue  # Ágape: van sus pestañas, una a una
            root = QDBusInterface(name, PATH, 'org.freedesktop.DBus.Properties', self.bus)
            root.setTimeout(TIMEOUT)
            if name not in self.idents:
                got = root.call('Get', 'org.mpris.MediaPlayer2', 'Identity').arguments()
                self.idents[name] = str(unwrap(got[0])) if got else ''
            ident = self.idents[name]
            if ident.lower() in ('ares', 'ágape', 'agape'):
                continue
            msg = root.call('GetAll', PLAYER)
            if msg.type() == QDBusMessage.MessageType.ErrorMessage or not msg.arguments():
                continue
            p = unwrap(msg.arguments()[0])
            meta = p.get('Metadata') or {}
            title = str(meta.get('xesam:title') or '')
            if not title:
                continue
            artist = meta.get('xesam:artist') or []
            art = str(meta.get('mpris:artUrl') or '')
            short = name[len(MPRIS):].split('.')[0]
            out.append({
                'key': name, 'kind': 'mpris', 'app': NAMES.get(short, str(ident) or short.capitalize()),
                'title': title, 'artist': ', '.join(artist) if isinstance(artist, list) else str(artist),
                'art': art if art.startswith(('https://', 'file://')) else '',
                'paused': p.get('PlaybackStatus') != 'Playing',
                'time': (p.get('Position') or 0) / 1e6, 'at': time.time() * 1000, 'dur': (meta.get('mpris:length') or 0) / 1e6,
                'vol': float(p.get('Volume', 1.0) or 0), 'prev': bool(p.get('CanGoPrevious')), 'next': bool(p.get('CanGoNext')),
                'spotify': short == 'spotify',
            })
        if self._differs(self._mpris, out):
            self._mpris = out
            self._remember()
            self.changed.emit()

    @staticmethod
    def _differs(old, new):
        """¿Ha cambiado algo de verdad? El tiempo que avanza solo no cuenta (la ventana lo hace avanzar ella sola desde
        «time» y «at»): solo si salta (has movido la canción) más de un segundo y medio. Así la ventana no se rehace
        cada segundo mientras suena."""
        if len(old) != len(new):
            return True
        for a, b in zip(old, new):
            if {k: v for k, v in a.items() if k not in ('time', 'at')} != {k: v for k, v in b.items() if k not in ('time', 'at')}:
                return True
            expected = a.get('time', 0) + (0 if a.get('paused') else (b.get('at', 0) - a.get('at', 0)) / 1000)
            if abs(expected - b.get('time', 0)) > 1.5:
                return True
        return False

    # ---------- Ágape (socket) ----------

    def _drop(self):
        self.pending.clear()
        self.buf = b''
        if self._agape:
            self._agape = []
            self.changed.emit()

    def _send(self, msg, want=None):
        if self.sock.state() != QLocalSocket.LocalSocketState.ConnectedState:
            return
        self.pending.append(want)
        self.sock.write((json.dumps(msg) + '\n').encode())
        self.sock.flush()

    def _poll_agape(self):
        st = self.sock.state()
        if st == QLocalSocket.LocalSocketState.UnconnectedState:
            if os.path.exists(SOCKET):
                self.sock.connectToServer(SOCKET)
            elif self._agape:
                self._drop()
            return
        if st == QLocalSocket.LocalSocketState.ConnectedState and not self.pending:
            self._send({'cmd': 'estado'}, 'estado')

    def _read(self):
        self.buf += bytes(self.sock.readAll())
        while b'\n' in self.buf:
            line, self.buf = self.buf.split(b'\n', 1)
            want = self.pending.pop(0) if self.pending else None
            if want != 'estado':
                continue
            try:
                data = json.loads(line)
            except ValueError:
                continue
            now = time.time() * 1000
            items = [{**d, 'kind': 'agape', 'app': 'Ágape', 'at': now} for d in (data or []) if isinstance(d, dict)]
            if self._differs(self._agape, items):
                self._agape = items
                self._remember()
                self.changed.emit()

    # ---------- Botones ----------

    @pyqtSlot(str, str)
    def run(self, key, action):
        """action: toggle · next · prev"""
        if key.startswith('web:'):
            self._send({'cmd': 'run', 'key': key, 'action': action})
        else:
            method = {'toggle': 'PlayPause', 'next': 'Next', 'prev': 'Previous'}.get(action)
            if method:
                QDBusInterface(key, PATH, PLAYER, self.bus).asyncCall(method)   # (sin esperar: el botón responde ya)
        QTimer.singleShot(300, self.poll)

    def _launch(self, *cmd):
        subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice', *cmd],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    @pyqtSlot()
    def openSpotify(self):
        self._launch('gtk-launch', 'spotify' if shutil.which('spotify') else 'com.spotify.Client')

    @pyqtSlot()
    def resume(self):
        """«Seguir» con lo último que sonó: Spotify se abre (y sigue sonando); una web, en Ágape."""
        last = self._last
        if last.get('spotify'):
            self.openSpotify()
            QTimer.singleShot(6000, lambda: QDBusInterface(MPRIS + 'spotify', PATH, PLAYER, self.bus).call('Play'))
        elif last.get('kind') == 'agape' and str(last.get('url', '')).startswith('https://'):
            self._launch('/usr/lib/apogeo/apogeo-agape', last['url'])
        elif last.get('key'):
            QDBusInterface(last['key'], PATH, PLAYER, self.bus).call('Play')

    @pyqtSlot(str, float)
    def setVolume(self, key, value):
        value = max(0.0, min(1.0, value))
        if key.startswith('web:'):
            self._send({'cmd': 'volume', 'key': key, 'value': value})
        else:
            QDBusInterface(key, PATH, 'org.freedesktop.DBus.Properties', self.bus).asyncCall(
                'Set', PLAYER, 'Volume', QDBusVariant(value))

    @pyqtSlot(str)
    def open(self, key):
        """Pulsar el título: la app que suena, delante (Spotify y demás; las pestañas de Ágape, con Ágape)."""
        if not key.startswith('web:'):
            QDBusInterface(key, PATH, 'org.mpris.MediaPlayer2', self.bus).call('Raise')

    @pyqtSlot('QObject*', list)
    def setInputRegion(self, window, rects):
        """Solo lo que se ve recibe el ratón; el resto de la ventana (transparente) deja pasar los clics."""
        region = QRegion()
        for r in rects:
            region = region.united(QRegion(int(r['x']), int(r['y']), int(r['width']), int(r['height'])))
        window.setMask(region)


def main():
    app = QGuiApplication(sys.argv)
    app.setApplicationName('Música de Apogeo')
    app.setDesktopFileName('apogeo-musica')
    app.setWindowIcon(QIcon.fromTheme('apogeo'))
    app.setQuitOnLastWindowClosed(False)
    if not QDBusConnection.sessionBus().registerService('org.apogeo.Musica'):
        return 0  # ya está en marcha
    musica = Musica()
    engine = QQmlApplicationEngine()
    if os.environ.get('APOGEO_QML_DIR'):
        engine.addImportPath(os.environ['APOGEO_QML_DIR'])
    engine.rootContext().setContextProperty('musica', musica)
    engine.rootContext().setContextProperty('openAtStart', os.environ.get('APOGEO_MUSICA_ABIERTA') == '1')  # (para probarla)
    engine.load(QUrl.fromLocalFile(QML))
    if not engine.rootObjects():
        return 1
    engine.load(QUrl.fromLocalFile(ESCRITORIO_QML))   # (si falla, la música sigue igual)
    app.aboutToQuit.connect(lambda: musica._cava(False))
    return app.exec()


if __name__ == '__main__':
    sys.exit(main())
