#!/usr/bin/python3
"""
Limpieza de Órbita: solo sugiere, nunca quita nada.

Mira qué programas repetidos o restos de CachyOS siguen instalados y escribe una lista de sugerencias para que tú
decidas. No llama a pacman para instalar ni quitar, no borra archivos y no toca el candado de pacman: todas las apps
siguen donde estaban.

  /var/lib/apogeo/limpieza.json   la lista (la lee apogeo-revision para avisarte si cambia)
  /var/lib/apogeo/limpieza.txt    la misma lista, para leerla a gusto

Lo lanza apogeo-revision después de cada actualización y apogeo-limpieza.service al encender. Si no hay nada que
sugerir, deja la lista vacía.
"""
import json
import os
import pwd
import subprocess
import sys
import time

VAR = os.environ.get('APOGEO_VAR', '/var/lib/apogeo')
INFORME = os.path.join(VAR, 'limpieza.json')
TEXTO = os.path.join(VAR, 'limpieza.txt')
VERSION = 2

# (paquete, lo que ya hace esa función en Órbita). Nada de esta lista se quita solo.
GRUPOS = (
    ('Lo de CachyOS que Órbita ya hace', (
        ('cachyos-hello', 'lo hace la bienvenida de Órbita'),
        ('cachyos-packageinstaller', 'lo hacen Ajustes → Apps y la tienda de Órbita'),
        ('cachyos-kernel-manager', 'lo hace la revisión y las actualizaciones de Órbita'),
        ('scx-manager', 'lo hace el planificador de Órbita (scx_loader)'),
        ('cachy-update', 'lo hacen los avisos de actualización de Órbita'),
        ('shelly', 'lo hace la tienda de Órbita'),
    )),
    ('Programas repetidos', (
        ('konsole', 'lo hace Ghostty'),
        ('alacritty', 'lo hace Ghostty'),
        ('spectacle', 'lo hacen las capturas de Órbita (Meta+Mayús+S)'),
        ('flameshot', 'lo hacen las capturas de Órbita (Meta+Mayús+S)'),
        ('haruna', 'lo hace VLC'),
        ('mpv', 'lo hace VLC'),
        ('mpvqt', 'lo hace VLC'),
        ('firefox', 'lo hace Ágape'),
        ('btop', 'lo hace Mission Center'),
        ('plasma-systemmonitor', 'lo hace Mission Center'),
        ('filelight', 'lo hace Mission Center'),
        ('micro', 'lo hace Kate'),
        ('vim', 'lo hace Kate'),
    )),
    ('Tandas anteriores', (
        ('kdeconnect', 'lo hacen los avisos y el portapapeles de Órbita'),
        ('stacer', 'lo hace Mission Center'),
        ('virtualbox', 'no hace falta en este PC (y su módulo frena las actualizaciones del núcleo)'),
        ('virtualbox-host-dkms', 'no hace falta en este PC'),
        ('virtualbox-ext-oracle', 'no hace falta en este PC'),
        ('lutris', 'lo hacen Steam, Heroic y la consola de Jugar'),
        ('pavucontrol', 'lo hacen el panel rápido y EasyEffects'),
        ('kwalletmanager', 'las contraseñas las guarda el sistema, no KWallet'),
        ('warehouse', 'lo hace la tienda de Órbita'),
    )),
)

ZSH = ('cachyos-zsh-config', 'oh-my-zsh-git', 'zsh-autosuggestions', 'zsh-completions',
       'zsh-history-substring-search', 'zsh-syntax-highlighting', 'zsh-theme-powerlevel10k')


def run(*cmd):
    try:
        r = subprocess.run(list(cmd), capture_output=True, text=True, timeout=20)
        return r.returncode, r.stdout
    except (OSError, subprocess.SubprocessError):
        return 1, ''


def instalados():
    code, out = run('pacman', '-Qq')
    return set(out.split()) if code == 0 else set()


def zsh_en_uso():
    """¿Alguna cuenta entra con zsh? Si sí, no se sugiere tocar su configuración."""
    try:
        return any((u.pw_shell or '').endswith('/zsh') for u in pwd.getpwall()
                   if u.pw_uid == 0 or 1000 <= u.pw_uid < 60000)
    except (KeyError, OSError):
        return True  # ante la duda, no sugerir


def requerido_por(paquete):
    """Los paquetes que necesitan este. Si lo necesita algo que no está en la lista, no se sugiere (sería un lío)."""
    code, out = run('pacman', '-Qi', paquete)
    if code != 0:
        return []
    for line in out.splitlines():
        if line.startswith('Required By'):
            value = line.split(':', 1)[1].strip()
            return [] if value in ('', 'None') else value.split()
    return []


def main():
    hay = instalados()
    if not hay:
        return 1
    candidatos = []
    for grupo, items in GRUPOS:
        for paquete, reemplazo in items:
            if paquete in hay:
                candidatos.append({'paquete': paquete, 'grupo': grupo, 'reemplazo': reemplazo})
    if not zsh_en_uso():
        for paquete in ZSH:
            if paquete in hay:
                candidatos.append({'paquete': paquete, 'grupo': 'La zsh de CachyOS',
                                   'reemplazo': 'fish y la zsh que ya trae el sistema'})
    # Solo se sugiere lo que no necesita otra app instalada (así nunca se lleva nada por delante).
    todos = {c['paquete'] for c in candidatos}
    sugerencias = []
    for c in candidatos:
        deps = [d for d in requerido_por(c['paquete']) if d not in todos]
        if deps:
            continue
        sugerencias.append(c)
    sugerencias.sort(key=lambda c: (c['grupo'], c['paquete']))

    os.makedirs(VAR, exist_ok=True)
    antes = {}
    try:
        with open(INFORME) as f:
            antes = json.load(f)
    except (OSError, ValueError):
        pass
    claves = [(c['paquete'], c['grupo']) for c in sugerencias]
    antes_claves = [(c.get('paquete'), c.get('grupo')) for c in antes.get('sugerencias', [])]
    fecha = antes.get('fecha', 0) if claves == antes_claves else int(time.time())

    data = {'version': VERSION, 'fecha': fecha, 'comprobado': int(time.time()), 'solo_sugerencias': True,
            'sugerencias': sugerencias, 'informe': TEXTO}
    tmp = INFORME + '.nuevo'
    with open(tmp, 'w') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o644)
    os.replace(tmp, INFORME)

    lineas = ['Órbita · limpieza (solo sugerencias)', time.strftime('%d/%m/%Y %H:%M'), '',
              'No se ha quitado nada: todo sigue instalado. Esto es solo una lista por si quieres hacer sitio.', '']
    if not sugerencias:
        lineas.append('No hay nada que sugerir. Todo lo que hay tiene su sitio.')
    grupo = None
    for c in sugerencias:
        if c['grupo'] != grupo:
            grupo = c['grupo']
            lineas += ['', grupo, '-' * len(grupo)]
        lineas.append(f"  · {c['paquete']}: {c['reemplazo']}.")
    lineas += ['', 'Si quieres quitar alguno: sudo pacman -Rns <paquete>.', '']
    tmp = TEXTO + '.nuevo'
    with open(tmp, 'w') as f:
        f.write('\n'.join(lineas))
    os.chmod(tmp, 0o644)
    os.replace(tmp, TEXTO)
    print(f'Limpieza: {len(sugerencias)} sugerencias (nada quitado)')
    return 0


if __name__ == '__main__':
    sys.exit(main())
