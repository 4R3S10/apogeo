#!/bin/bash
# Fuera los programas repetidos y los restos de CachyOS (una sola vez: si luego instalas alguno a mano, se queda).
# Con cada uno se queda el de Apogeo: Ghostty (no Konsole ni Alacritty), las capturas de Apogeo (no Spectacle ni
# Flameshot), VLC (no Haruna ni mpv), Ágape (no Firefox), Mission Center (no btop, el Monitor del sistema ni Filelight),
# Kate y fish (no vim, micro ni la zsh de CachyOS). Y lo de CachyOS que Apogeo ya hace a su manera: la bienvenida, el instalador de paquetes,
# el gestor de núcleos, el actualizador y Shelly.
# Segunda tanda (2026-10-19): KDE Connect (gastaba memoria y red sin usarse). Tercera (2026-10-20): Stacer (lo hace
# Mission Center) y VirtualBox (no hace falta en el PC y su módulo frenaba las actualizaciones del núcleo). Cuarta
# (2026-10-28): Lutris (lo hacen Steam, Heroic y la consola), Pavucontrol (el sonido está en el panel rápido y en
# EasyEffects) y el gestor de KWallet (las contraseñas ya no las guarda KWallet). Quinta (2026-10-29): Flameshot (las
# capturas son de Apogeo). Sexta (2026-10-29): Warehouse (lo hace la tienda de Apogeo). De cada tanda solo se quita lo suyo: lo que reinstalaste a mano después de una tanda se queda.
#
# Lo lanza la revisión de Apogeo después de una actualización y, si no llegó a acabar (por ejemplo, porque se reinició
# justo después), al encender (apogeo-limpieza.service). pacman está ocupado hasta que acaba la actualización, así que
# primero espera a que termine; mientras quita, retrasa el apagado. Lo que quita lo apunta en
# /var/lib/apogeo/limpieza.json para que la revisión te lo cuente.
set -u
MARCA=/var/lib/apogeo/limpieza-6
INFORME=/var/lib/apogeo/limpieza.json
[ -e "$MARCA" ] && exit 0

# En este orden: lo que depende de otro, antes
QUITAR=()
if [ ! -e /var/lib/apogeo/limpieza-1 ]; then
QUITAR=(
  cachyos-hello cachyos-packageinstaller cachyos-kernel-manager scx-manager cachy-update shelly
  konsole alacritty spectacle
  haruna mpvqt mpv firefox
  btop plasma-systemmonitor filelight
  cachyos-micro-settings micro
)
# La zsh de CachyOS (con sus complementos), solo si nadie la usa para entrar
if ! getent passwd | awk -F: '$3 == 0 || ($3 >= 1000 && $3 < 60000)' | cut -d: -f7 | grep -q zsh; then
  QUITAR+=(cachyos-zsh-config oh-my-zsh-git zsh-autosuggestions zsh-completions zsh-history-substring-search
           zsh-syntax-highlighting zsh-theme-powerlevel10k vim)
fi
fi
# Segunda tanda
[ -e /var/lib/apogeo/limpieza-2 ] || QUITAR+=(kdeconnect)
# Tercera tanda
[ -e /var/lib/apogeo/limpieza-3 ] || QUITAR+=(stacer virtualbox virtualbox-host-dkms virtualbox-ext-oracle)
# Cuarta tanda
[ -e /var/lib/apogeo/limpieza-4 ] || QUITAR+=(lutris pavucontrol kwalletmanager)
# Quinta tanda
[ -e /var/lib/apogeo/limpieza-5 ] || QUITAR+=(flameshot)
# Sexta tanda
QUITAR+=(warehouse)

# Un candado de pacman de antes de encender el PC no es de nadie (se cortó un pacman al apagar): fuera
LCK=/var/lib/pacman/db.lck
if [ -e "$LCK" ] && ! pgrep -x 'pacman|yay|paru|pamac-daemon' >/dev/null; then
  boot=$(awk '/^btime/ {print $2}' /proc/stat)
  [ "$(stat -c %Y "$LCK")" -lt "$boot" ] && rm -f "$LCK" && echo "candado de pacman viejo quitado"
fi

# Espera a que pacman acabe (hasta 30 min)
for _ in $(seq 900); do
  [ -e /var/lib/pacman/db.lck ] || break
  sleep 2
done
[ -e /var/lib/pacman/db.lck ] && exit 1  # sigue ocupado: se intenta otra vez al encender o tras la próxima actualización

hay=()
for p in "${QUITAR[@]}"; do pacman -Qq "$p" >/dev/null 2>&1 && hay+=("$p"); done
quitados=()
if [ ${#hay[@]} -gt 0 ]; then
  # Todos a la vez; si alguno lo necesita otro programa, uno a uno (y ese se queda)
  quitar() {
    systemd-inhibit --what=shutdown:sleep --who=Apogeo --why='Quitando programas repetidos' --mode=block \
      pacman -Rns --noconfirm "$@" >/dev/null 2>&1
  }
  if quitar "${hay[@]}"; then
    quitados=("${hay[@]}")
  else
    for p in "${hay[@]}"; do
      pacman -Qq "$p" >/dev/null 2>&1 || continue
      quitar "$p" && quitados+=("$p")
    done
  fi
fi

mkdir -p /var/lib/apogeo
python3 - "$INFORME" "${quitados[@]}" <<'PY'
import json, sys, time
json.dump({'fecha': int(time.time()), 'quitados': sys.argv[2:]}, open(sys.argv[1], 'w'))
PY
touch /var/lib/apogeo/limpieza-1 /var/lib/apogeo/limpieza-2 /var/lib/apogeo/limpieza-3 /var/lib/apogeo/limpieza-4 /var/lib/apogeo/limpieza-5 "$MARCA"
