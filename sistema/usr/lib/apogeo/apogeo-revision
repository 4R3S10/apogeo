#!/usr/bin/python3
"""
Revisión de Apogeo después de cada actualización: mira que todo siga en su sitio y arregla lo que pueda. Solo avisa si
ha arreglado algo o si algo no ha podido arreglarlo (si todo está bien, no dice nada).

  apogeo-revision sistema   lo lanza pacman al acabar una actualización (gancho zz-apogeo-revision): los servicios de
                            Apogeo, el inicio de sesión, que no falten archivos, las apps escondidas y, una vez, la
                            limpieza de programas repetidos (apogeo-limpieza). Lo apunta en /var/lib/apogeo/revision.json
  apogeo-revision usuario   en tu sesión, al entrar y en cuanto cambia ese archivo (apogeo-revision.path): los pisos,
                            la isla y la columna de pisos, el fondo, los scripts de KWin, el estilo y la música. Y te
                            avisa de lo arreglado (también de lo que arregló la parte del sistema y de la limpieza)
"""
import json
import os
import subprocess
import sys
import time

LIB = os.environ.get('APOGEO_LIB', '/usr/lib/apogeo')
VAR = '/var/lib/apogeo'
REPORT = os.path.join(VAR, 'revision.json')
CLEANUP = os.path.join(VAR, 'limpieza.json')
SEEN = os.path.join(os.environ.get('XDG_STATE_HOME', os.path.expanduser('~/.local/state')), 'apogeo', 'revision-vista.json')
KWIN_SCRIPTS = ('apogeo-bordes', 'apogeo-ventanas', 'apogeo-partida')


def sh(*cmd, timeout=60):
    try:
        r = subprocess.run(list(cmd), capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 1, ''


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


# ---------- Sistema (root, desde pacman) ----------

def system():
    fixed, failed = [], []
    # Servicios del sistema: la vigilancia de la temperatura y el inicio de sesión de Apogeo
    for unit, what in (('apogeo-termico.service', 'la vigilancia de la temperatura'), ('sddm.service', 'el inicio de sesión'),
                       ('apogeo-al-dia.timer', 'lo de Jugar al día')):
        if sh('systemctl', 'is-enabled', unit)[1] != 'enabled':
            if sh('systemctl', 'enable', '-f', unit)[0] == 0:
                fixed.append(what)
            else:
                failed.append(what)
    # Los de cada sesión (para todas las cuentas)
    for unit, what in (('apogeo-pisos.service', 'los pisos'), ('apogeo-actualizaciones.timer', 'los avisos de actualización'),
                       ('apogeo-copia.timer', 'la copia sola'), ('apogeo-revision.service', 'esta revisión'),
                       ('apogeo-revision.path', 'esta revisión'), ('apogeo-al-dia.timer', 'lo de Jugar al día')):
        if sh('systemctl', '--global', 'is-enabled', unit)[1] != 'enabled':
            if sh('systemctl', '--global', 'enable', unit)[0] == 0:
                if what not in fixed:
                    fixed.append(what)
            elif what not in failed:
                failed.append(what)
    # Que no falte ningún archivo de Apogeo (si falta, hay que reinstalarlo: eso no se puede hacer a media actualización)
    if sh('pacman', '-Qk', 'apogeo', timeout=120)[0] != 0:
        failed.append('faltan archivos de Apogeo (reinstálalo: sudo pacman -S apogeo)')
    # Las apps que no pintan nada, fuera del menú
    sh(os.path.join(LIB, 'apogeo-esconder'))
    # Una vez: fuera los programas repetidos (espera a que pacman acabe; lo cuenta apogeo-limpieza.json)
    if not os.path.exists(os.path.join(VAR, 'limpieza-1')):
        sh('systemctl', 'start', '--no-block', 'apogeo-limpieza.service')
    os.makedirs(VAR, exist_ok=True)
    version = sh('pacman', '-Q', 'apogeo')[1].split()[-1:] or ['']
    tmp = REPORT + '.nuevo'
    with open(tmp, 'w') as f:
        json.dump({'fecha': int(time.time()), 'version': version[0], 'arreglado': fixed, 'fallos': failed}, f,
                  ensure_ascii=False)
    os.chmod(tmp, 0o644)
    os.replace(tmp, REPORT)
    print('Apogeo revisado' + (': arreglado ' + ', '.join(fixed) if fixed else '') +
          (' · sin arreglar: ' + ', '.join(failed) if failed else ''))
    return 0


# ---------- Tu sesión ----------

def user():
    import dbus
    bus = dbus.SessionBus()

    def on_bus(name):
        try:
            return bool(bus.name_has_owner(name))
        except dbus.DBusException:
            return False

    # Espera a que Plasma y KWin estén listos (al entrar en la sesión)
    for _ in range(90):
        if on_bus('org.kde.plasmashell') and on_bus('org.kde.KWin'):
            break
        time.sleep(1)
    time.sleep(8)  # (y a que los pisos hayan hecho lo suyo)
    fixed, failed = [], []

    def kwin_loaded(name):
        try:
            return bool(bus.get_object('org.kde.KWin', '/Scripting').isScriptLoaded(
                name, dbus_interface='org.kde.kwin.Scripting'))
        except dbus.DBusException:
            return False

    def plasma(js):
        try:
            return str(bus.get_object('org.kde.plasmashell', '/PlasmaShell').evaluateScript(
                js, dbus_interface='org.kde.PlasmaShell'))
        except dbus.DBusException:
            return None

    def layout():
        out = plasma("""
            var o = {isla: false, pisos: false, fondo: true};
            panels().forEach(function (p) { p.widgets().forEach(function (w) {
                if (w.type == 'org.apogeo.isla') o.isla = true;
                if (w.type == 'org.apogeo.pisos') o.pisos = true;
            }); });
            desktops().forEach(function (d) { if (d.wallpaperPlugin != 'org.apogeo.fondo') o.fondo = false; });
            print(JSON.stringify(o));
        """)
        try:
            return json.loads(out) if out else None
        except ValueError:
            return None

    def pisos_running():
        return sh('systemctl', '--user', 'is-active', 'apogeo-pisos.service')[1] == 'active'

    # 1. Los pisos (de ellos cuelgan la isla, el fondo, los avisos, la luz y la música)
    if not pisos_running():
        sh('systemctl', '--user', 'restart', 'apogeo-pisos.service')
        time.sleep(10)
        (fixed if pisos_running() else failed).append('los pisos')

    # 2. Los scripts de KWin (la isla y los pisos desde el borde, las ventanas y la música, el modo partida)
    missing = [s for s in KWIN_SCRIPTS if not kwin_loaded(s)]
    if missing:
        for s in missing:
            sh('kwriteconfig6', '--file', 'kwinrc', '--group', 'Plugins', '--key', f'{s}Enabled', 'true')
        try:
            bus.get_object('org.kde.KWin', '/KWin').reconfigure(dbus_interface='org.kde.KWin')
            bus.get_object('org.kde.KWin', '/Scripting').start(dbus_interface='org.kde.kwin.Scripting')
        except dbus.DBusException:
            pass
        time.sleep(3)
        still = [s for s in missing if not kwin_loaded(s)]
        (failed if still else fixed).append('los efectos de las ventanas')

    # 3. La isla, la columna de pisos y el fondo de Apogeo
    lay = layout()
    if lay is not None and not (lay['isla'] and lay['pisos'] and lay['fondo']):
        state_path = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'apogeo', 'pisos.json')
        state = read_json(state_path, {})
        if not lay['isla']:  # los pisos la vuelven a poner (y su bandeja, su hora, el panel rápido y su tamaño)
            for k in ('isla', 'bandeja', 'reloj', 'rapido', 'cristal'):
                state.pop(k, None)
        if not lay['pisos']:
            state.pop('panel', None)
        with open(state_path, 'w') as f:
            json.dump(state, f)
        sh('systemctl', '--user', 'restart', 'apogeo-pisos.service')
        time.sleep(12)
        lay2 = layout() or {}
        names = {'isla': 'la isla', 'pisos': 'la columna de pisos', 'fondo': 'el fondo'}
        for k, name in names.items():
            if not lay[k]:
                (fixed if lay2.get(k) else failed).append(name)

    # 4. El estilo de Plasma de Apogeo (el cristal de la isla, los menús y los avisos)
    # (en tu archivo: el de /etc/xdg solo, Plasma no lo hace caso)
    try:
        with open(os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'plasmarc')) as f:
            text = f.read()
        theme = text.split('[Theme]', 1)[1].split('\n[', 1)[0] if '[Theme]' in text else ''
    except OSError:
        theme = ''
    if 'name=apogeo' not in theme.split():
        try:
            import importlib.machinery
            import importlib.util
            loader = importlib.machinery.SourceFileLoader('apogeo_pisos', os.path.join(LIB, 'apogeo-pisos'))
            spec = importlib.util.spec_from_loader('apogeo_pisos', loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            mod.plasma_theme()
            fixed.append('el estilo de la isla (al volver a entrar)')
        except Exception:
            failed.append('el estilo de la isla')

    # 5. La música de abajo a la izquierda (la arrancan los pisos; si se ha caído, otra vez)
    if pisos_running() and not on_bus('org.apogeo.Musica') and os.access(os.path.join(LIB, 'apogeo-musica'), os.X_OK):
        subprocess.Popen(['systemd-run', '--user', '--scope', '--collect', '--slice=app.slice',
                          f'--unit=app-apogeo-musica-revision-{os.getpid()}', os.path.join(LIB, 'apogeo-musica')],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        time.sleep(3)
        (fixed if on_bus('org.apogeo.Musica') else failed).append('la música')

    # Lo del sistema y la limpieza, si no te lo había contado ya
    seen = read_json(SEEN, {})
    report = read_json(REPORT, {})
    if report.get('fecha', 0) > seen.get('revision', 0):
        fixed = report.get('arreglado', []) + fixed
        failed = report.get('fallos', []) + failed
    cleanup = read_json(CLEANUP, {})
    removed = cleanup.get('quitados', []) if cleanup.get('fecha', 0) > seen.get('limpieza', 0) else []
    os.makedirs(os.path.dirname(SEEN), exist_ok=True)
    with open(SEEN, 'w') as f:
        json.dump({'revision': report.get('fecha', 0), 'limpieza': cleanup.get('fecha', 0)}, f)

    if not (fixed or failed or removed):
        return 0
    body = []
    if fixed:
        body.append('Arreglado: ' + join(fixed) + '.')
    if removed:
        body.append(f'Quitados {len(removed)} programas repetidos o de CachyOS (' + join(removed[:4]) +
                    ('…' if len(removed) > 4 else '') + ').')
    if failed:
        body.append('No se ha podido arreglar: ' + join(failed) + '. Prueba a reiniciar.')
    subprocess.run(['notify-send', '-a', 'Apogeo', '-i', 'dialog-warning' if failed else 'apogeo',
                    'Apogeo revisado tras la actualización', ' '.join(body)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def join(items):
    items = list(dict.fromkeys(items))
    return items[0] if len(items) == 1 else ', '.join(items[:-1]) + ' y ' + items[-1]


def main():
    if sys.argv[1:] == ['sistema']:
        return system()
    if sys.argv[1:] == ['usuario']:
        return user()
    print(__doc__.strip())
    return 2


if __name__ == '__main__':
    sys.exit(main())
