[Unit]
Description=Apogeo: fuera los programas repetidos y los restos de CachyOS (una vez)
ConditionPathExists=!/var/lib/apogeo/limpieza-4

[Service]
Type=oneshot
ExecStart=/usr/lib/apogeo/apogeo-limpieza
# (si el apagado llega a media limpieza, pacman acaba lo que está haciendo)
TimeoutStopSec=10min
KillSignal=SIGINT
TimeoutStartSec=45min
Nice=10

[Install]
WantedBy=multi-user.target
