# Copia de Apogeo: al conectar un USB o un disco por USB, tu sesión mira si es el de tus copias y si toca hacer una
# (apogeo-copia hacer --sola; si no es ese disco o no toca, no hace nada)
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_UUID}=="?*", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="apogeo-copia.service"
