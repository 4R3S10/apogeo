post_install() {
  # Salud del PC (temperatura) y los pisos en cada sesión de Plasma
  systemctl enable apogeo-termico.service
  systemctl --global enable apogeo-pisos.service
  _actualizaciones
  # Inicio de sesión con la tarjeta de Apogeo (SDDM en lugar del de Plasma, que no deja cambiar su diseño)
  systemctl disable plasmalogin.service 2>/dev/null || true
  systemctl enable -f sddm.service
  # Teclado ANSI: EE. UU. internacional (también en la pantalla de inicio de sesión)
  localectl set-x11-keymap us pc105 intl 2>/dev/null || true
  _programas
  _copia_revision
  echo ">>> Apogeo instalado. Reinicia para entrar."
}

post_upgrade() {
  # «Entrar con neuronas» ya no existe: fuera lo que guardaba
  rm -rf /var/lib/apogeo/neuronas
  systemctl --global enable apogeo-pisos.service
  _actualizaciones
  _programas
  _copia_revision
}

# La copia sola (cada día mira si toca; también al conectar el USB) y la revisión de cada sesión después de actualizar
_copia_revision() {
  systemctl --global enable apogeo-copia.timer apogeo-revision.service apogeo-revision.path apogeo-al-dia.timer
  systemctl enable --now apogeo-al-dia.timer 2>/dev/null || true   # lo de Jugar al día, sin jugar
  systemctl enable apogeo-windows.service 2>/dev/null || true       # los juegos del Windows escondido, al encender
  systemctl enable --now apogeo-actualizar-al-apagar.service 2>/dev/null || true  # «Actualizar al apagar»
  systemctl enable --now scx_loader.service 2>/dev/null || true     # el planificador de escritorio y juegos (scx_lavd)
  systemctl enable --now paccache.timer 2>/dev/null || true         # la caché de paquetes, limpia cada semana
  /usr/lib/apogeo/apogeo-windows sync 2>/dev/null || true           # (y Apogeo el primero al arrancar, ya)
}

# Los programas de serie (apogeo-programas): ONLYOFFICE y Stremio de Flathub (en segundo plano, con internet) y
# VirtualBox para las cuentas que ya existen (hay que estar en su grupo)
_programas() {
  systemctl enable --now --no-block apogeo-flatpaks.service 2>/dev/null || true
  systemctl enable apogeo-limpieza.service 2>/dev/null || true  # (se pone en marcha al acabar: zz-apogeo-revision)
  # VirtualBox (vboxusers) y los juegos de PS5 con AnyPS5 (kvm: /dev/udmabuf)
  awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' /etc/passwd | while read -r u; do
    for g in vboxusers kvm; do
      getent group "$g" >/dev/null && gpasswd -a "$u" "$g" >/dev/null 2>&1 || true
    done
  done
}

# Avisos de actualización de Apogeo en lugar del actualizador de CachyOS (apogeo-limpieza lo quita; mientras, callado)
_actualizaciones() {
  systemctl --global enable apogeo-actualizaciones.timer
  systemctl --global disable arch-update.timer 2>/dev/null || true
  /usr/lib/apogeo/apogeo-esconder
}

pre_remove() {
  /usr/lib/apogeo/apogeo-bloqueo quitar
  systemctl disable apogeo-termico.service
  systemctl disable apogeo-flatpaks.service 2>/dev/null || true
  systemctl disable apogeo-limpieza.service 2>/dev/null || true
  systemctl --global disable apogeo-pisos.service
  systemctl --global disable apogeo-actualizaciones.timer
  systemctl --global disable apogeo-copia.timer apogeo-revision.service apogeo-revision.path apogeo-al-dia.timer
  systemctl disable apogeo-al-dia.timer apogeo-windows.service apogeo-actualizar-al-apagar.service 2>/dev/null || true
}
