post_install() {
  # Salud del PC (temperatura) y los pisos en cada sesión de Plasma
  systemctl enable apogeo-termico.service
  systemctl --global enable apogeo-pisos.service
  _actualizaciones
  # Inicio de sesión con la tarjeta de Apogeo (SDDM en lugar del de Plasma, que no deja cambiar su diseño)
  systemctl disable plasmalogin.service 2>/dev/null || true
  systemctl enable -f sddm.service
  # Teclado ANSI: EE. UU. internacional (también en la pantalla de inicio de sesión)
  localectl set-x11-keymap us pc105 intl 2>/dev/null || true
  echo ">>> Apogeo instalado. Reinicia para entrar."
}

post_upgrade() {
  systemctl --global enable apogeo-pisos.service
  _actualizaciones
}

# Avisos de actualización de Apogeo en lugar del actualizador de CachyOS (que sigue instalado, pero callado)
_actualizaciones() {
  systemctl --global enable apogeo-actualizaciones.timer
  systemctl --global disable arch-update.timer 2>/dev/null || true
  /usr/lib/apogeo/apogeo-esconder
}

pre_remove() {
  /usr/lib/apogeo/apogeo-bloqueo quitar
  systemctl disable apogeo-termico.service
  systemctl --global disable apogeo-pisos.service
  systemctl --global disable apogeo-actualizaciones.timer
}
