# Apogeo encima de CachyOS (KDE): pisos, isla, consola de juegos, Ágape, ventanas, arranque, inicio de sesión y estética.
# Se construye en GitHub Actions (.github/workflows/paquetes.yml) a partir de las carpetas sistema/ y herramientas/.
pkgbase=apogeo
pkgname=(apogeo apogeo-programas)
pkgver=1.r0
pkgrel=1
pkgdesc='Apogeo: el sistema de Ares sobre CachyOS'
arch=('any')
url='https://github.com/4R3S10/apogeo'
license=('MIT')
makedepends=(git python-gobject python-cairo librsvg breeze papirus-icon-theme python-fonttools qt6-shadertools)
_raiz="$startdir/../.."

pkgver() {
  printf '1.r%s' "$(git -C "$_raiz" rev-list --count HEAD)"
}

package_apogeo() {
  depends=(
    apogeo-programas                                          # los programas de serie (abajo)
    plasma-workspace kwin sddm plymouth                       # escritorio, inicio de sesión y arranque
    scx-scheds scx-tools pacman-contrib                       # planificador para escritorio y juegos, caché de paquetes
    papirus-icon-theme ttf-nunito kvantum                     # iconos, letra y el estilo de las apps
    python python-dbus python-gobject python-evdev            # los pisos y la consola (el mando)
    python-pyqt6 qt6-declarative milou kirigami plocate       # la bienvenida, los ajustes y el buscador (y tus archivos)
    pacman-contrib polkit gnupg                               # ajustes: actualizaciones; la copia de Apogeo
    kdialog libnotify libpulse xdg-utils curl fuse2           # avisos, sonidos, Ágape (AppImage)
    power-profiles-daemon                                     # energía de cada piso
    kwin-effect-rounded-corners                               # ventanas con las esquinas redondeadas
    qt6-multimedia qt6-multimedia-ffmpeg xdg-user-dirs        # fondos de vídeo y la carpeta de imágenes
    steam heroic-games-launcher umu-launcher apogeo-hydra     # juegos: Steam, Epic/GOG, lanzador de Epic y Hydra
    tesseract tesseract-data-spa tesseract-data-eng           # capturas: sacar el texto de una imagen
  )
  install=apogeo.install
  cp -a --no-preserve=ownership "$_raiz/sistema/." "$pkgdir/"
  local h="$_raiz/herramientas"
  # Lo que se genera con la estética de Ágape: colores, letra (Bricolage Grotesque), ventanas, estilo de Plasma
  # (cristal y tarjetas), carpetas en su rosa, el cursor berenjena y el sombreador de sus fondos animados
  python "$h/colores.py" "$pkgdir/usr/share/color-schemes/Apogeo.colors"
  python "$h/letra.py" "$h/fuentes/BricolageGrotesque[opsz,wdth,wght].ttf" "$pkgdir/usr/share/fonts/apogeo"
  install -Dm644 "$h/fuentes/Bricolage-OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/Bricolage-OFL.txt"
  python "$h/ventanas.py" "$pkgdir/usr/share/aurorae/themes"
  python "$h/plasma.py" "$pkgdir/usr/share/plasma/desktoptheme"
  python "$h/kvantum.py" "$pkgdir/usr/share/Kvantum"
  python "$h/iconos.py" "$pkgdir/usr/share/icons/Apogeo"
  python "$h/cursor.py" /usr/share/icons/breeze_cursors "$pkgdir/usr/share/icons/Apogeo-cursor"
  # Los sonidos de Apogeo (sintetizados aquí: marimba suave y el búho al entrar)
  python "$h/sonidos.py" "$pkgdir/usr/share/sounds/apogeo/stereo"
  # Los generadores de temas, también para «Aspecto» (apogeo-aspecto los usa con tus colores)
  install -d "$pkgdir/usr/lib/apogeo/temas"
  install -m644 "$h"/{fichas,colores,kvantum,plasma,ventanas,iconos}.py "$pkgdir/usr/lib/apogeo/temas/"
  # El logo (el búho batiendo las alas) y sus copias para el arranque, el inicio de sesión, el menú y la terminal
  local logo="$srcdir/logo"
  install -d "$logo"
  python "$h/logo.py" "$logo"
  install -Dm644 "$logo/logo.svg" "$pkgdir/usr/share/apogeo/logo.svg"
  install -Dm644 "$logo/logo-silueta.svg" "$pkgdir/usr/share/apogeo/logo-silueta.svg"
  install -Dm644 "$logo/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/apogeo.svg"
  install -Dm644 "$logo/logo.svg" "$pkgdir/usr/share/sddm/themes/apogeo/logo.svg"
  rsvg-convert -w 150 -h 150 "$logo/logo.svg" -o "$logo/150.png"
  install -Dm644 "$logo/150.png" "$pkgdir/usr/share/plymouth/themes/apogeo/logo.png"
  install -Dm644 "$logo/150.png" "$pkgdir/usr/share/plasma/look-and-feel/org.apogeo.desktop/contents/splash/logo.png"
  # El aleteo del búho para el arranque y el apagado (Plymouth) y la entrada en la sesión (splash de Plasma)
  for f in "$logo"/aleteo-*.svg; do
    rsvg-convert -w 150 -h 150 "$f" -o "${f%.svg}.png"
    install -Dm644 "${f%.svg}.png" "$pkgdir/usr/share/plymouth/themes/apogeo/$(basename "${f%.svg}.png")"
    install -Dm644 "${f%.svg}.png" "$pkgdir/usr/share/plasma/look-and-feel/org.apogeo.desktop/contents/splash/$(basename "${f%.svg}.png")"
  done
  rsvg-convert -w 360 -h 360 "$logo/logo.svg" -o "$logo/360.png"
  install -Dm644 "$logo/360.png" "$pkgdir/usr/share/apogeo/logo.png"
  # Lo que va al Windows escondido: el logo y la letra de Apogeo para su pantalla de carga
  install -Dm644 "$logo/360.png" "$pkgdir/usr/share/apogeo/windows/logo.png"
  install -d "$pkgdir/usr/share/apogeo/windows/letra"
  cp "$pkgdir"/usr/share/fonts/apogeo/*.ttf "$pkgdir/usr/share/apogeo/windows/letra/"
  local shaders="$pkgdir/usr/share/plasma/wallpapers/org.apogeo.fondo/contents/shaders"
  install -d "$shaders"
  /usr/lib/qt6/bin/qsb --glsl '100es,120,150' -o "$shaders/fondo.frag.qsb" "$h/fondo/fondo.frag"
}

# Los programas de serie de Apogeo (todos de los repositorios de Arch y CachyOS; ONLYOFFICE y Stremio no están, y los
# instala apogeo-flatpaks de Flathub al arrancar con internet)
package_apogeo-programas() {
  pkgdesc='Apogeo: los programas de serie'
  depends=(
    spotify-launcher discord                                        # música y chat
    ghostty starship fastfetch ttf-jetbrains-mono-nerd flatpak      # la terminal de Apogeo y Flathub
    mangohud lib32-mangohud gamemode lib32-gamemode protonplus  # juegos
    obs-studio vlc easyeffects qbittorrent                          # grabar, vídeos, sonido y descargas
    localsend keepassxc obsidian coolercontrol                      # archivos al móvil, contraseñas, notas y ventiladores
    okular anki xournalpp                                           # estudiar: PDFs, tarjetas de memoria y escribir a mano
    mission-center warehouse                                        # qué gasta el PC y los Flatpak
  )
}
